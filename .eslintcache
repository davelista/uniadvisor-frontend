eact, {useEffect} from 'react'\r\nimport './App.css';\r\nimport {BrowserRouter as Router, Route, Switch} from \"react-router-dom\";\r\nimport ReactGA from 'react-ga';\r\n//import professorsList from './json/professorsList.json'\r\n//Pages\r\nimport {Dashboard, Home, Login, Professor, SignUp, AddReview} from './pages'\r\nimport {Footer} from './components'\r\nimport {Redirect} from \"react-router\";\r\nimport { AppContext, useAppContext } from './context/AppContext';\r\n\r\nconst getCookie = (cname) => {\r\n    let name = cname + \"=\";\r\n    let decodedCookie = decodeURIComponent(document.cookie);\r\n    let ca = decodedCookie.split(';');\r\n    for (let i = 0; i < ca.length; i++) {\r\n        let c = ca[i];\r\n        while (c.charAt(0) === ' ') {\r\n            c = c.substring(1);\r\n        }\r\n        if (c.indexOf(name) === 0) {\r\n            return c.substring(name.length, c.length);\r\n        }\r\n    }\r\n    return \"\";\r\n}\r\n\r\nconst setCookie = (cname, cvalue, exdays) => {\r\n    let d = new Date();\r\n    d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));\r\n    let expires = \"expires=\" + d.toUTCString();\r\n    document.cookie = cname + \"=\" + cvalue + \";\" + expires + \";path=/\";\r\n}\r\n\r\nfunction App() {\r\n    useEffect(() => {\r\n        ReactGA.initialize('UA-185661222-1 ');\r\n        //to report page view\r\n        ReactGA.pageview(window.location.pathname + window.location.search);\r\n    }, [])\r\n\r\n    const appData = useAppContext();\r\n\r\n    return (\r\n        <AppContext.Provider value={appData}>\r\n            <Router>\r\n                <Switch>\r\n                    <Route exact path='/'>\r\n                        <Home />\r\n                    </Route>\r\n                    <Route exact path=\"/professors/:professorId\">\r\n                        <Professor />\r\n                    </Route>\r\n                    <Route exact path=\"/dashboard\">\r\n                        <Dashboard />\r\n                    </Route>\r\n                    <Route exact path=\"/add-review/professors/:professorId\">\r\n                        <AddReview />\r\n                    </Route> \r\n                    <Route exact path=\"/login\">\r\n                        <Login />\r\n                    </Route>\r\n                    <Route exact path=\"/sign-up\">\r\n                        <SignUp />\r\n                    </Route>\r\n                    <Route render={() => <Redirect to={{pathname: \"/\"}}/>}/>\r\n                </Switch>\r\n                <Footer/>\r\n            </Router>\r\n        </AppContext.Provider>\r\n\r\n    );\r\n\r\n    /*\r\n        funzione per eliminare cookies\r\n        document.cookie = \"session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\r\n\r\n        getCookie(\"session\") === \"\" ? setUser(null) : ApiLogin(\"davide.lista.polimi@gmail.com\", \"prova\"); /*Api speficia per i cookies\r\n\r\n        if(user !== null) {\r\n            setCookie(\"session\", user, 7);\r\n            console.log(getCookie(\"session\"));\r\n        }\r\n\r\n        const readCookie = () => {\r\n            getCookie(\"session\");\r\n        }\r\n    */\r\n}\r\n\r\nexport default App;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\context\\AppContext.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\index.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\index.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useProfessorsList.js",["197"],"import {useEffect, useState} from 'react';\r\nimport {ApiProfessorsList} from \"../api\";\r\n\r\nconst useProfessorsList = () => {\r\n    const [state, setState] = useState(null);\r\n\r\n    useEffect(() => {\r\n        if(state == null){\r\n            setProfessorsList();\r\n        }\r\n    }, []);\r\n\r\n    const setProfessorsList = async () => {\r\n        const professorsList = await ApiProfessorsList();\r\n\r\n        setState(professorsList);\r\n    };\r\n    return state;\r\n};\r\n\r\nexport default useProfessorsList;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useProfessor.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Dashboard.js",["198"],"import React, { useContext } from \"react\";\r\nimport UserDetails from \"../components/PagesSections/Dashboard/UserDetails\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport { Redirect } from \"react-router\";\r\nimport { Button } from \"../components/Buttons/Button\";\r\nimport { AppContext } from \"../context/AppContext\";\r\n\r\nconst Dashboard = (props) => {\r\n    const { onChangeAuth } = props;\r\n\r\n    const appData = useContext(AppContext);\r\n\r\n    const dashboard =\r\n        appData.user.data !== null ? (\r\n            <UserDetails user={appData.user.data} />\r\n        ) : (\r\n            <div> EFFETTUA IL LOGIN PER ACCEDERE </div>\r\n        );\r\n    /*dashboard=(<Redirect to={'/login'} />) NON va bene perché effettua prima il redirect*/\r\n    return (\r\n        <>\r\n            <Navbar />\r\n            {dashboard}\r\n            <Button onClick={onChangeAuth} />\r\n        </>\r\n    );\r\n};\r\n\r\nexport default Dashboard;\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Home.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Professor.js",["199"],"import React, { useContext, useEffect } from \"react\";\r\nimport { useParams } from \"react-router\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\r\nimport { AppContext } from \"../context/AppContext\";\r\n\r\nfunction Professor() {\r\n    const appData = useContext(AppContext);\r\n    const { professorId } = useParams();\r\n\r\n    useEffect(() => {\r\n        appData.professor.refresh(professorId);\r\n    }, [professorId, appData.professor.refresh]);\r\n\r\n    return (\r\n        <div>\r\n            <Navbar />\r\n            {appData.professor.data !== null ? (\r\n                <ProfessorDetails professor={appData.professor.data} />\r\n            ) : (\r\n                <div style={{ margin: \"200px\", display: \"flex\", justifyContent: \"center\" }}>LOADING PROFESSOR</div>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Professor;\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\AddReview.js",["200","201"],"import React, { useContext, useEffect } from \"react\";\r\nimport { useParams } from \"react-router\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport AddReviewForm from \"../components/PagesSections/AddReview/AddReviewForm\";\r\nimport { AppContext } from \"../context/AppContext\";\r\n\r\nexport default function AddReview() {\r\n    const appData = useContext(AppContext);\r\n    const { professorId } = useParams();\r\n\r\n    useEffect(() => {\r\n        if (appData.professor.data?.id == professorId) return;  // non mettere \"===\" (id: number, professorId: string)\r\n        appData.professor.refresh(professorId);\r\n    }, [professorId])\r\n\r\n    const userDetails = appData.user.data !== null ? <div>USER DETAILS</div> : <div>EFFETTUA IL LOGIN PER ACCEDERE</div>;\r\n\r\n    return (\r\n        <>\r\n            <Navbar />\r\n            {userDetails}\r\n\r\n            {appData.professor.data !== null ? (\r\n                <AddReviewForm professor={appData.professor.data} />\r\n            ) : (\r\n                <div style={{ margin: \"200px\", display: \"flex\", justifyContent: \"center\" }}>LOADING PROFESSOR</div>\r\n            )}\r\n        </>\r\n    );\r\n}\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Login.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\SignUp.js",["202"],"import React, {useContext, useState} from 'react';\r\nimport SignUpForm from \"../components/PagesSections/Login-SignUp/SignUpForm\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport SignUpFb from \"../components/PagesSections/Login-SignUp/SignUpFb\";\r\nimport { AppContext } from '../context/AppContext';\r\n\r\nconst SignUp = () => {\r\n    const appData = useContext(AppContext);\r\n\r\n    const [fbRegister, setFacebookRegister] = useState(false);\r\n    const [userFb, setUserFb] = useState();\r\n\r\n    let signUp;\r\n    !fbRegister ? signUp = (<SignUpForm onChangeUserFb={setUserFb} onChangeFb={setFacebookRegister}/>) :\r\n        signUp = <SignUpFb userFb={userFb} />\r\n\r\n    return (\r\n        <>\r\n            <Navbar user={''} />\r\n            {signUp}\r\n            </>\r\n    );\r\n}\r\n\r\nexport default SignUp;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Footer\\Footer.js",["203"],"import React from 'react'\r\nimport './Footer.css'\r\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\r\n\r\nfunction Footer() {\r\n    return (\r\n        <>\r\n            <div className=\"footer\">\r\n                <div className=\"info-footer\">\r\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\r\n                        Privacy Policy\r\n                    </a>\r\n                    <div className=\"text-footer\">\r\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\r\n                    </div>\r\n                </div>\r\n\r\n                <div className=\"socials-footer\">\r\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\r\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\r\n                    <FiMail class={'social-icon-bg social-icon'}/>\r\n                </div>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Footer;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Navbar\\Navbar.js",["204"],"import React, {useContext, useState} from 'react';\r\nimport {Link} from 'react-router-dom';\r\nimport logo from \"../../img/logo.svg\";\r\nimport './Navbar.css'\r\nimport '../Buttons/Button.css';\r\nimport {Button} from \"../Buttons/Button\";\r\nimport SearchBar from \"../SearchBar/SearchBar\";\r\nimport useMediaQuery, { Device } from '../../hooks/useMediaQuery';\r\nimport SearchIcon from '@material-ui/icons/Search';\r\nimport { AppContext } from '../../context/AppContext';\r\n\r\nconst Navbar = (props) => {\r\n\r\n    const { isHome = false} = props;\r\n\r\n    const appData = useContext(AppContext);\r\n\r\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\r\n    const isMobile = useMediaQuery(Device.sm);\r\n    const [mobileSearchHidden, setMobileSearchHidden] = useState(true);\r\n\r\n    const handleOpenLoginForm = () => {\r\n        setOpenLoginForm(!isOpenLoginForm);\r\n    }\r\n\r\n    let button;\r\n    appData.user.data === null ? button = (\r\n            <Link to='/login' className=\"navbar-title\">\r\n                {/* <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button> */}\r\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>{isMobile ? \"Accedi\" : \"Accedi/Registrati\"}</h6></Button>\r\n            </Link>\r\n        )\r\n        : button = (<Link to='/dashboard'><div>{appData.user.data.email}</div></Link>)\r\n\r\n    let search;\r\n    isHome === false && appData.professorsList !== null ? search=(<SearchBar professorsList={appData.professorsList} isHome={isHome}/>) : search=(<div></div>)\r\n\r\n    return (\r\n        <>\r\n            <div className=\"navbar\">\r\n                <Link to='/' className=\"navbar-title\">\r\n                    <img src={logo} className={'logo'} alt={logo}/>\r\n                </Link>\r\n                {isMobile ? <SearchIcon onClick={() => setMobileSearchHidden(value => !value)} /> : search}\r\n                {/* LOGIN POPUP\r\n                <div className=\"menu-content\">\r\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\r\n                    {isOpenLoginForm &&\r\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\r\n                        <Login onChangeUser={onChangeUser}/>\r\n                    </Popup>}\r\n                </div>*/}\r\n                {button}\r\n\r\n                {!mobileSearchHidden && isMobile && !isHome ? <div className=\"navbar-mobile-search\">{search}</div> : null}\r\n            </div>\r\n        </>\r\n    );\r\n\r\n}\r\n\r\nexport default Navbar;\r\n\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Buttons\\Button.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorDetails.js",["205"],"import React, {useState} from 'react';\r\nimport './Professor.css';\r\nimport imgUser from \"../../../img/user.jpg\";\r\n/*ICONS*/\r\n/*RATING*/\r\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\r\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\r\nimport Rating from '@material-ui/lab/Rating';\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport EmailIcon from \"@material-ui/icons/Email\";\r\nimport WorkIcon from \"@material-ui/icons/Work\";\r\nimport BusinessIcon from \"@material-ui/icons/Business\";\r\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\r\nimport ProfessorCourse from \"./ProfessorCourse\";\r\nimport { Button } from '../../Buttons/Button';\r\nimport { Link } from 'react-router-dom';\r\nimport ProfessorReviews from \"./ProfessorReviews\";\r\n\r\nfunction ProfessorDetails(props) {\r\n    const {professor} = props;\r\n    const [courseId, setCouseId] = useState(0);\r\n\r\n    // let image;\r\n    // professorImg === \"Image Not Found\" ? image = (\r\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={imgUser}/>) : image = (\r\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={professorImg}/>)\r\n\r\n    return (\r\n        <>\r\n            <div className={\"professor-card\"}>\r\n                <img\r\n                    src={\"/api/professor_image/\" + professor.id}\r\n                    className={\"professor-img\"}\r\n                    alt={`${professor.nome} ${professor.cognome}`}\r\n                />\r\n                <div className=\"professor-detail\">\r\n                    <div className=\"professor-title\">\r\n                        <h1>\r\n                            {professor.nome} {professor.cognome}\r\n                        </h1>\r\n                        {console.log(professor.metrics.overall)}\r\n                        <div className={\"bubble-rating\"}>\r\n                            <Rating\r\n                                name=\"half-rating-read\"\r\n                                defaultValue={professor.metrics.overall}\r\n                                precision={0.5}\r\n                                readOnly\r\n                                emptyIcon={\r\n                                    <FiberManualRecordOutlinedIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />\r\n                                }\r\n                                icon={<FiberManualRecordIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"professor-university-section\">\r\n                        <div className=\"professor-info\">\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <AccountBalanceIcon\r\n                                            fontSize=\"small\"\r\n                                            style={{\r\n                                                fill: \"#e53a1e\",\r\n                                                marginRight: \"3%\",\r\n                                            }}\r\n                                        />\r\n                                        <h3 style={{ color: \"#e53a1e\" }}>{x.name}</h3>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <EmailIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{professor.email}</p>\r\n                                    </div>\r\n                                ); /*cambiare professor.email con x.email quando cambieranno json*/\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <WorkIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{x.contratto}</p>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <BusinessIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{x.dipartimento}</p>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {console.log(professor.metrics)}\r\n                        <ProfessorEvaluation finalEvaluation={professor.metrics} />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className={\"professor-title-courses\"}>\r\n                {professor.corsi.map((course, i) => (\r\n                    <h4\r\n                        className={\"course-title-button\"}\r\n                        onClick={() => {\r\n                            setCouseId(i);\r\n                        }}\r\n                        style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\r\n                    >\r\n                        {course.name}\r\n                    </h4>\r\n                ))}\r\n                {/* {professor.corsi.map((x, i) => {\r\n                    return Object.entries(x)\r\n                        .filter(([key, value]) => key === \"name\")\r\n                        .map(([key, value]) => {\r\n                            return (\r\n                                <h4\r\n                                    className={\"course-title-button\"}\r\n                                    onClick={() => {\r\n                                        setCouseId(i);\r\n                                    }}\r\n                                    style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\r\n                                >\r\n                                    {value}\r\n                                </h4>\r\n                            );\r\n                        });\r\n                })} */}\r\n            </div>\r\n\r\n            <div className={\"professor-courses\"}>\r\n                <div className=\"course-details-section\">\r\n                    {professor.corsi.map((x, i) => {\r\n                        return (\r\n                            <div className={\"course-info-section\"}>\r\n                                {courseId === i ? <ProfessorCourse course={x} /> : null}\r\n                            </div>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </div>\r\n\r\n            <div className={\"reviews-section\"}>\r\n                <div className={\"reviews-section-title\"}>\r\n                    <h2>Leggi le recensioni</h2>\r\n                    <Link to={\"/add-review/professors/\" + professor.id}>\r\n                        <Button buttonStyle=\"btn--outline\">\r\n                            <h6 style={{ color: \"white\" }}>Scrivi una recensione</h6>\r\n                        </Button>\r\n                    </Link>\r\n                </div>\r\n                <ProfessorReviews professor={professor} icourse={courseId} />\r\n            </div>\r\n\r\n            {console.log(professor)}\r\n        </>\r\n    );\r\n}\r\n\r\nexport default ProfessorDetails;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\AddReview\\AddReviewForm.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Dashboard\\UserDetails.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\LoginForm.js",["206","207","208","209"],"import React, {useState} from 'react';\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport './Login.css'\r\nimport {Button} from \"../../Buttons/Button\";\r\nimport {Link} from \"react-router-dom\";\r\nimport {ApiLogin} from \"../../../api\";\r\nimport LoginFacebook from \"./LoginFacebook\";\r\n\r\nconst LoginForm = (props) => {\r\n    const {login, onChangeError} = props;\r\n\r\n\r\n    const [email, setEmail] = useState('');\r\n    const [password, setPassword] = useState('');\r\n    const [loading, setLoading] = useState(false);\r\n    const [msgError, setMsgError] = useState('');\r\n\r\n    const submit = async (e) => {\r\n        if(e) e.preventDefault();\r\n\r\n        if (email !== \"\" && password !== \"\") {\r\n            const ok = await login(email, password);\r\n            if (ok) onChangeError(false);\r\n            else onChangeError(true);\r\n            // try {\r\n            //     let result = await ApiLogin(email, password);\r\n            //     if (result !== null) {\r\n            //         onChangeError(false);\r\n            //         onChangeUser(email);\r\n            //     } else onChangeError(true);\r\n            //     setLoading(false);\r\n            // } catch (e) {\r\n            //     throw e;\r\n            // }\r\n        } else {\r\n            setMsgError(\"ATTENZIONE! I campi sono vuoti\");\r\n        }\r\n    }\r\n\r\n    return (\r\n        <>\r\n            <div className={\"form-container\"}>\r\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\r\n                    <div className={\"form-input\"}>\r\n\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\",\r\n\r\n                            }}\r\n                            label=\"Username\"\r\n                            placeholder=\"Inserisci la tua mail\"\r\n                            variant=\"outlined\"\r\n                            type=\"email\"\r\n                            onChange={e => setEmail(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\",\r\n                                autoFocus: true\r\n                            }}\r\n                            label=\"Password\"\r\n                            placeholder=\"Inserisci la tua password\"\r\n                            variant=\"outlined\"\r\n                            type=\"password\"\r\n                            onChange={e => setPassword(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6>\r\n                        </Button>\r\n                    </div>\r\n                    {msgError !== '' ? <div>{msgError}</div> : null}\r\n                    {/*<FormControlLabel\r\n                        value=\"ricordami\"\r\n                        control={<Checkbox color=\"primary\" />}\r\n                        label=\"Ricordami\"\r\n                        labelPlacement=\"end\"\r\n                    />*/}\r\n                    {/*<div>\r\n                        oppure\r\n                    </div>\r\n                    <LoginFacebook onChangeUserFb={onChangeUser}/>*/}\r\n                </form>\r\n\r\n\r\n            </div>\r\n            <div className={\"register-option-container\"}>\r\n                <div className={\"register-option-text\"}>\r\n                    Non hai ancora un account?\r\n                </div>\r\n                <div className={\"register-option-button\"}>\r\n                    <Link to='/sign-up'>\r\n                        <Button buttonStyle='btn--outline--white'>\r\n                            <h6>Registrati</h6>\r\n                        </Button>\r\n                    </Link>\r\n                </div>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default LoginForm;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\SignUpForm.js",["210","211","212"],"import React, {useState} from 'react';\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport {Button} from \"../../Buttons/Button\";\r\nimport {ApiRegister} from \"../../../api\";\r\nimport {Redirect} from \"react-router\";\r\nimport LoginFacebook from \"./LoginFacebook\";\r\n\r\nconst SignUpForm = (props) => {\r\n    const {onChangeUserFb, onChangeFb} = props;\r\n\r\n    const [firstname, setFirstname] = useState('');\r\n    const [lastname, setLastname] = useState('');\r\n    const [email, setEmail] = useState('');\r\n    const [university, setUniversity] = useState('');\r\n    const [password, setPassword] = useState('');\r\n    const [passwordControl, setPasswordControl] = useState('');\r\n\r\n    const [error, setError] = useState(true);\r\n    const [msgError, setMsgError] = useState('');\r\n    const [typeError, setTypeError] = useState('');\r\n    const [done, setDone] = useState(false);\r\n\r\n\r\n    const displayError = () => {\r\n        switch (typeError) {\r\n            case 'Empty':\r\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\r\n                break;\r\n            case 'Different passwords':\r\n                setMsgError(\"ATTENZIONE, le password non coincidono\");\r\n                break;\r\n            case 'Invalid email':\r\n                setMsgError(\"ATTENZIONE, la mail non è valida\");\r\n                break;\r\n            case 'Short Password':\r\n                setMsgError(\"ATTENZIONE, la password è troppo corta\");\r\n                break;\r\n            case 'Already registered':\r\n                setMsgError(\"ATTENZIONE, utente già registrato\");\r\n                break;\r\n            default:\r\n                setMsgError('');\r\n                break;\r\n        }\r\n    }\r\n\r\n    const validation = () => {\r\n\r\n        if (firstname.length < 1 || lastname.length < 1 || email.length < 1 || university.length < 1 || password.length < 1 || passwordControl.length < 1) {\r\n            setTypeError('Empty');\r\n            setError(true);\r\n        } else if (!email.includes('@')) {\r\n            setTypeError('Invalid email');\r\n            setError(true);\r\n        } else if (password.length < 8) {\r\n            setTypeError('Short Password');\r\n            setError(true);\r\n        } else if (password !== passwordControl) {\r\n            setTypeError('Different passwords');\r\n            setError(true);\r\n        } else {\r\n            setTypeError('No Error');\r\n            setError(false);\r\n        }\r\n    }\r\n\r\n    const handleSubmit = async (e) => {\r\n        if (e) e.preventDefault();\r\n        if (!error) {\r\n            try {\r\n                let res = await ApiRegister(firstname, lastname, email, password, university, \"Unihub\", null);\r\n\r\n                switch (res.data) {\r\n                    case \"OK\":\r\n                        setDone(true);\r\n                        break;\r\n                    case \"Already registered\":\r\n                        break;\r\n                    default:\r\n                        break;\r\n                }\r\n            } catch (e) {\r\n                throw e;\r\n            }\r\n\r\n        }\r\n        displayError();\r\n    }\r\n\r\n\r\n    return (\r\n        <>\r\n            <div className={\"login-title-container\"}>\r\n                <div className={\"title-red\"}>Registrati</div>\r\n            </div>\r\n            <div className={\"form-container\"}>\r\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"firstname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Nome\"\r\n                                placeholder=\"Inserisci il tuo nome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setFirstname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\"\r\n                                }}\r\n                                name=\"lastname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Cognome\"\r\n                                placeholder=\"Inserisci il tuo cognome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setLastname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"email\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Email\"\r\n                            placeholder=\"Inserisci la tua email\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setEmail(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"university\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Università\"\r\n                            placeholder=\"Inserisci la tua università\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setUniversity(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"password\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Password\"\r\n                                placeholder=\"Inserisci la tua password\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                type=\"password\"\r\n                                onChange={e => setPassword(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"passwordControl\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Conferma Password\"\r\n                                placeholder=\"Inserisci di nuovo la tua password\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                type=\"password\"\r\n                                onChange={e => setPasswordControl(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\r\n                            style={{color: \"white\"}}>Registrati</h6>\r\n                        </Button>\r\n                    </div>\r\n                    {done ? <Redirect\r\n                            to=\"/login\"/> :\r\n                        <div>{msgError}</div>} {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\r\n                    {/*<div>\r\n                        oppure registrati con\r\n                    </div>\r\n                    <LoginFacebook onChangeUserFb={onChangeUserFb} onChangeFb={onChangeFb}/>*/}\r\n                </form>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default SignUpForm;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutArea.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\SignUpFb.js",["213","214"],"import React, {useState} from 'react';\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport {Button} from \"../../Buttons/Button\";\r\nimport {ApiRegister} from \"../../../api\";\r\nimport {Redirect} from \"react-router\";\r\nimport LoginFacebook from \"./LoginFacebook\";\r\n\r\n/* Complete data for facebook register */\r\n\r\nconst SignUpFb = (props) => {\r\n    const {userFb, onChangeUser} = props;\r\n\r\n    const [firstname, setFirstname] = useState('');\r\n    const [lastname, setLastname] = useState('');\r\n    const [university, setUniversity] = useState('');\r\n\r\n    const [error, setError] = useState(true);\r\n    const [msgError, setMsgError] = useState('');\r\n    const [typeError, setTypeError] = useState('');\r\n\r\n    const displayError = () => {\r\n        switch (typeError) {\r\n            case 'Empty':\r\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\r\n                break;\r\n            default:\r\n                setMsgError('');\r\n                break;\r\n        }\r\n    }\r\n\r\n    const validation = () => {\r\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\r\n            setTypeError('Empty');\r\n            setError(true);\r\n        }\r\n        else {\r\n            setTypeError('No Error');\r\n            setError(false);\r\n            return true;\r\n        }\r\n    }\r\n\r\n    const handleSubmit = async (e) => {\r\n        e.preventDefault();\r\n\r\n        if(validation()){\r\n            try {\r\n                await ApiRegister(firstname, lastname, userFb.email, university);\r\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\r\n                * onChangeUser(user) */\r\n            } catch (e) {\r\n                throw e;\r\n            }\r\n        } else {\r\n            displayError();\r\n        }\r\n    }\r\n\r\n\r\n    return (\r\n        <>\r\n            <div className={\"login-title-container\"}>\r\n                <div className={\"title-red\"}>Registrati</div>\r\n            </div>\r\n            <div className={\"form-container\"}>\r\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"firstname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Nome\"\r\n                                placeholder=\"Inserisci il tuo nome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setFirstname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\"\r\n                                }}\r\n                                name=\"lastname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Cognome\"\r\n                                placeholder=\"Inserisci il tuo cognome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setLastname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\",\r\n                                readOnly: true\r\n                            }}\r\n                            name=\"email\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Email\"\r\n                            defaultValue={userFb.email}\r\n                            aria-required=\"true\"\r\n                            variant=\"outlined\"\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"university\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Università\"\r\n                            placeholder=\"Inserisci la tua università\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setUniversity(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\r\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\r\n                        </Button>\r\n                    </div>\r\n                    {error === false ? <Redirect\r\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\r\n                </form>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default SignUpFb;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\HeroSection\\HeroSection.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\api\\index.js",["215","216","217"],"import axios from \"axios\";\r\n\r\n/*API to request professor detail*/\r\nexport const ApiProfessorsList = async () => {\r\n    try{\r\n        const res = await axios.get(\"/api/professors_list\");\r\n        return res.data.results;\r\n    } catch (e){\r\n        if(e != null){\r\n            console.log(JSON.stringify(e));\r\n            return null;\r\n        }\r\n        throw e;\r\n    }\r\n};\r\n\r\n/*API to request professor detail*/\r\nexport const ApiProfessor = async (professorId) => {\r\n    try{\r\n        const res = await axios.get(\"/api/professors/\"+professorId);\r\n        return res.data;\r\n    } catch (e){\r\n        switch (e.message){\r\n            case \"Request failed with status code 400\":\r\n                return \"No professor\";\r\n            case \"Request failed with status code 500\":\r\n                return \"Internal error\";\r\n            default:\r\n                return \"Error\";\r\n        }\r\n        throw e;\r\n    }\r\n};\r\n\r\n/*API to request professor image*/\r\nexport const ApiProfessorImage = async (professorId) => {\r\n    try{\r\n        const img = await axios.get(\"/api/professor_image/\" + professorId)\r\n        return img;\r\n    } catch (e){\r\n        switch (e.message){\r\n            case \"Request failed with status code 404\":\r\n                return \"Image Not Found\";\r\n            default:\r\n                break;\r\n        }\r\n        throw e;\r\n    }\r\n};\r\n\r\n/*API to register new users*/\r\nexport const ApiRegister = async (name, surname, email, password, university, type, externalId) =>{\r\n    try{\r\n        const res = await axios.post(\"/api/register\", {name, surname, email, password, university});\r\n        console.log(JSON.stringify(res));\r\n        return res;\r\n    } catch (e) {\r\n        console.log(JSON.stringify(e));\r\n        if(e.message === \"Request failed with status code 400\"){\r\n            return \"400\";\r\n        }\r\n        if(e.message === \"Request failed with status code 303\"){\r\n            return \"303\";\r\n        }\r\n        throw e;\r\n    }\r\n}\r\n\r\n/*API to login users*/\r\nexport const ApiLogin = async (email, password) => {\r\n    try{\r\n        /*withCredentials: true è per i cookies*/\r\n        const res = await axios.post(\"/api/user_login\", {email, password}, {withCredentials: true});\r\n        return res.data;\r\n    } catch (e) {\r\n        console.log(JSON.stringify(e));\r\n        if(e.message === \"Request failed with status code 406\"){\r\n            return null;\r\n        }\r\n        else if(e.message === \"Request failed with status code 400\"){\r\n            return null;\r\n        }\r\n        throw e;\r\n\r\n    }\r\n}\r\n\r\n/*API to send user's email*/\r\nexport const ApiMail = async (email) => {\r\n    try{\r\n        const res = await axios.post(\"/api/email\", {email})\r\n\r\n    } catch (e) {\r\n        throw e;\r\n    }\r\n\r\n};\r\n\r\n/*API to send user's email*/\r\nexport const ApiReviews = async (corso_id, professor_id, num) => {\r\n    try{\r\n        const res = await axios.get(\"/api/reviews\", { params: { corso_id, professor_id, num } });\r\n        return res.data.results;\r\n    } catch (e) {\r\n        if(e.message === \"Request failed with status code 400\"){\r\n            return null;\r\n        }\r\n        throw e;\r\n    }\r\n\r\n};\r\n\r\nexport default {ApiProfessor, ApiMail, ApiRegister, ApiLogin};","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\University\\UniveristyArea.js",["218"],"import React from 'react'\r\nimport './UniversityArea.css'\r\nimport imgPolimi from \"../../../../img/polimi.jpg\";\r\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\r\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\r\nimport imgPolito from \"../../../../img/polito.jpg\";\r\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\r\nimport imgStatale from \"../../../../img/statale.jpg\";\r\nimport SearchBar from \"../../../SearchBar/SearchBar\";\r\n\r\n\r\nfunction UniversitySection() {\r\n\r\n    return (\r\n        <>\r\n            <div className=\"uni-container\">\r\n                <div className=\"uni-title\">\r\n                    <h1>Le Università</h1>\r\n                    {/*da inserire university searchbar*/}\r\n                </div>\r\n\r\n                Verifica che la tua universitá sia tra quelle disponibili.\r\n                <div className=\"wrap\">\r\n                    <div className=\"item-wrap\">\r\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"wrap\">\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\r\n                        </div>\r\n                    