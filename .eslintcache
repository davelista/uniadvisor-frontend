:"169"},{"filePath":"313","messages":"314","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"315","messages":"316","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"317","messages":"318","errorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"319","usedDeprecatedRules":"169"},{"filePath":"320","messages":"321","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"322","usedDeprecatedRules":"169"},{"filePath":"323","messages":"324","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"325","messages":"326","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"327","messages":"328","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"329","messages":"330","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"331","messages":"332","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"333","messages":"334","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"335","messages":"336","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"337","usedDeprecatedRules":"169"},{"filePath":"338","messages":"339","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"340","messages":"341","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"342","messages":"343","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"344","messages":"345","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"346","messages":"347","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"348","messages":"349","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"350","messages":"351","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"352","usedDeprecatedRules":"169"},{"filePath":"353","messages":"354","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["355","356"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/context/AppContext.js",["357"],"import React, { useMemo } from \"react\";\nimport useProfessor from \"../hooks/useProfessor\";\nimport useAuth from \"../hooks/useAuth\";\nimport useProfessorsList from \"../hooks/useProfessorsList\";\nimport useUniversityList from \"../hooks/useUniversityList\";\n\n// const defaultContext = {\n//     professorsList: null,\n//     universitiesList: null,\n//     user: {\n//         data: null,\n//         login: () => {},\n//         validateSession: () => {},\n//         refresh: () => {},\n//     },\n//     professor: {\n//         data: null,\n//         // image: null,\n//         refresh: () => {},\n//     },\n// };\n\nexport const AppContext = React.createContext({});\n\nexport function useAppContext() {\n    const professorsList = useProfessorsList();\n    const universitiesList = useUniversityList();\n    const [professor, refreshProfessor] = useProfessor();\n    const [auth, user, login, validateSession, logout, changePassword, deleteUser] = useAuth();\n\n    return useMemo(\n        () => ({\n            professorsList,\n            universitiesList,\n            user: {\n                auth,\n                data: user,\n                login,\n                validateSession,\n                logout,\n                changePassword,\n                deleteUser,\n            },\n            professor: {\n                data: professor,\n                refresh: refreshProfessor,\n            },\n        }),\n        [professorsList, universitiesList, professor, refreshProfessor, user, login, validateSession, auth, logout, changePassword]\n    );\n}\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAuth.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorsList.js",["358"],"import {useEffect, useState} from 'react';\nimport {ApiProfessorsList} from \"../api\";\n\nconst useProfessorsList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setProfessorsList();\n        }\n    }, []);\n\n    const setProfessorsList = async () => {\n        const professorsList = await ApiProfessorsList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useProfessorsList;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",["359"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nfunction Professor( ) {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n    useEffect(() => {\n        appData.professor.refresh(professorId);\n    }, [professorId, appData.professor.refresh]);\n\n    return (\n        <div>\n            <Navbar />\n            {appData.professor.data !== null ? (\n                <ProfessorDetails professor={appData.professor.data} />\n            ) : (\n                <LoadingComponent />\n            )}\n        </div>\n    );\n}\n\nexport default Professor;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",["360"],"import React, { useContext, useState } from \"react\";\nimport LoginForm from \"../components/PagesSections/Login-SignUp/LoginForm\";\nimport { Redirect } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport { AppContext } from \"../context/AppContext\";\n\nconst Login = () => {\n    const appData = useContext(AppContext)\n\n    if (appData.user.auth === \"OK\") return <Redirect to={\"/dashboard\"} />\n\n    return (\n        <>\n            <Navbar />\n            <LoginForm />\n        </>\n    );\n};\n\nexport default Login;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/AddReview.js",["361","362"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport AddReviewForm from \"../components/PagesSections/AddReview/AddReviewForm\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nexport default function AddReview() {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n\n    useEffect(() => {\n        if (appData.professor.data?.id == professorId) return; // non mettere \"===\" (id: number, professorId: string)\n        appData.professor.refresh(professorId);\n    }, [professorId]);\n\n    return (\n        <>\n            <Navbar />\n\n            {appData.professor.data !== null ? (\n                <AddReviewForm />\n            ) : (\n                <LoadingComponent />\n            )}\n        </>\n    );\n}\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["363","364","365","366","367"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\nimport {Link} from \"react-router-dom\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <a href=\"https://www.instagram.com/spotted_polimi/?hl=it\" target=\"_blank\">\n                        <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    </a>\n                    <a href=\"https://www.facebook.com/PolimiSpotted/\" target=\"_blank\">\n                        <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    </a>\n                    <a href=\"mailto:info@uniadvisor.it\" target=\"_blank\">\n                        <FiMail class={'social-icon-bg social-icon'}/>\n                    </a>\n\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["368","369","370","371"],"import React, {useContext, useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport SearchBar from \"../SearchBar/SearchBar\";\nimport useMediaQuery, { Device } from '../../hooks/useMediaQuery';\nimport SearchIcon from '@material-ui/icons/Search';\nimport { AppContext } from '../../context/AppContext';\nimport MuiMenuItem from \"@material-ui/core/MenuItem\";\nimport MenuItem from '@material-ui/core/MenuItem';\nimport {ClickAwayListener, Grow, MenuList, Paper, Popper, withStyles} from \"@material-ui/core\";\nimport {IoMdSettings} from \"react-icons/all\";\nimport ProgressCirle from \"../progress/ProgressCircle\";\n\n\nconst Navbar = (props) => {\n\n    const { isHome = false} = props;\n\n    const appData = useContext(AppContext);\n\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\n    const isMobile = useMediaQuery(Device.sm);\n    const [mobileSearchHidden, setMobileSearchHidden] = useState(true);\n    const [isOpenDropdown, setOpenDropdown] = React.useState(null);\n    const anchorRef = React.useRef(null);\n\n    const MenuItem = withStyles({\n        root: {\n            justifyContent: \"center\"\n        }\n    })(MuiMenuItem);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n\n    const handleClick = (event) => {\n        setOpenDropdown(event.currentTarget);\n    };\n\n    const handleToggle = () => {\n        setOpenDropdown((prevOpen) => !prevOpen);\n    };\n\n    const handleClose = () => {\n        setOpenDropdown(null);\n    };\n\n    const handleLogout = () => {\n        appData.user.logout();\n        handleClose();\n    }\n\n    const prevOpen = React.useRef(isOpenDropdown);\n    React.useEffect(() => {\n        if (prevOpen.current === true && isOpenDropdown === false) {\n            anchorRef.current.focus();\n        }\n        prevOpen.current = isOpenDropdown;\n    }, [isOpenDropdown]);\n\n    function handleListKeyDown(event) {\n        if (event.key === 'Tab') {\n            event.preventDefault();\n            setOpenDropdown(false);\n        }\n    }\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n    let button;\n    appData.user.data === null ? button = (\n            <Link to='/login' className=\"navbar-title\">\n                {/* <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button> */}\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>{isMobile ? \"Accedi\" : \"Accedi/Registrati\"}</h6></Button>\n            </Link>\n        ) : button = (<>\n            <div ref={anchorRef}\n                 aria-controls={isOpenDropdown ? 'menu-list-grow' : undefined}\n                 aria-haspopup=\"true\"\n                 onClick={handleToggle}\n            >{appData.user.data.email}</div>\n                <Popper open={isOpenDropdown} anchorEl={anchorRef.current} role={undefined} transition disablePortal>\n                    {({ TransitionProps, placement }) => (\n                        <Grow\n                            {...TransitionProps}\n                            style={{ transformOrigin: placement === 'bottom' ? 'center top' : 'center bottom' }}\n                        >\n                            <Paper>\n                                <ClickAwayListener onClickAway={handleClose}>\n                                    <MenuList autoFocusItem={isOpenDropdown} id=\"menu-list-grow\" onKeyDown={handleListKeyDown}>\n                                        <Link to='/dashboard'> <MenuItem onClick={handleClose}>Profile</MenuItem></Link>\n                                        <Link to=\"/\"><MenuItem onClick={handleLogout}>Logout</MenuItem></Link>\n                                        <Link to='/settings'><MenuItem onClick={handleClose}><IoMdSettings/></MenuItem></Link>\n                                    </MenuList>\n                                </ClickAwayListener>\n                            </Paper>\n                        </Grow>\n                    )}\n                </Popper>\n            </>\n        )\n\n    let search;\n    isHome === false && appData.professorsList !== null ? search=(<div className={'nav-search'}><SearchBar professorsList={appData.professorsList} isHome={isHome}/></div>) : search=(<div/>)\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                {isMobile ? <div className={'nav-search'}><SearchIcon onClick={() => setMobileSearchHidden(value => !value)} /></div> : search}\n                {/* LOGIN POPUP\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm &&\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\n                        <Login onChangeUser={onChangeUser}/>\n                    </Popup>}\n                </div>*/}\n                {button}\n\n                {!mobileSearchHidden && isMobile && !isHome ? <div className=\"navbar-mobile-search\">{search}</div> : null}\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["372","373","374"],"import React, {useState} from 'react';\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\n/*ICONS*/\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\nimport EmailIcon from \"@material-ui/icons/Email\";\nimport WorkIcon from \"@material-ui/icons/Work\";\nimport BusinessIcon from \"@material-ui/icons/Business\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport { Button } from '../../Buttons/Button';\nimport { Link } from 'react-router-dom';\nimport ProfessorReviews from \"./ProfessorReviews\";\n\nfunction ProfessorDetails(props) {\n    const {professor} = props;\n    const [courseId, setCouseId] = useState(0);\n\n    // let image;\n    // professorImg === \"Image Not Found\" ? image = (\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={imgUser}/>) : image = (\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={professorImg}/>)\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                <img\n                    src={\"/api/professor_image/\" + professor.id}\n                    className={\"professor-img\"}\n                    alt={`${professor.nome} ${professor.cognome}`}\n                />\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>\n                            {professor.nome} {professor.cognome}\n                        </h1>\n                        <div className={\"bubble-rating\"}>\n                            <Rating\n                                name=\"half-rating-read\"\n                                defaultValue={professor.metrics.overall}\n                                precision={0.5}\n                                readOnly\n                                emptyIcon={\n                                    <FiberManualRecordOutlinedIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />\n                                }\n                                icon={<FiberManualRecordIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />}\n                            />\n                        </div>\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <AccountBalanceIcon\n                                            fontSize=\"small\"\n                                            style={{\n                                                fill: \"#e53a1e\",\n                                                marginRight: \"3%\",\n                                            }}\n                                        />\n                                        <h3 style={{ color: \"#e53a1e\" }}>{x.name}</h3>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <EmailIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.email}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <WorkIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.contratto}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <BusinessIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.dipartimento}</p>\n                                    </div>\n                                );\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.metrics} />\n                    </div>\n                </div>\n            </div>\n            <div className={\"professor-title-courses\"}>\n                {professor.corsi.map((course, i) => (\n                    <h4\n                        className={\"course-title-button\"}\n                        onClick={() => {\n                            setCouseId(i);\n                        }}\n                        style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\n                    >\n                        {course.name}\n                    </h4>\n                ))}\n            </div>\n\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.corsi.map((x, i) => {\n                        return (\n                            <div className={\"course-info-section\"}>\n                                {courseId === i ? <ProfessorCourse course={x} /> : null}\n                            </div>\n                        );\n                    })}\n                </div>\n            </div>\n\n\n                <ProfessorReviews professor={professor} icourse={courseId} />\n        </>\n    );\n}\n\nexport default ProfessorDetails;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["375"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["376","377"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\n\n/* Complete data for facebook register */\n\nconst SignUpFb = (props) => {\n    const {userFb, onChangeUser} = props;\n\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [university, setUniversity] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\n            setTypeError('Empty');\n            setError(true);\n        }\n        else {\n            setTypeError('No Error');\n            setError(false);\n            return true;\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n\n        if(validation()){\n            try {\n                await ApiRegister(firstname, lastname, userFb.email, university);\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\n                * onChangeUser(user) */\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            displayError();\n        }\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                readOnly: true\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            defaultValue={userFb.email}\n                            aria-required=\"true\"\n                            variant=\"outlined\"\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"university\"\n                            id=\"outlined-textarea\"\n                            label=\"Università\"\n                            placeholder=\"Inserisci la tua università\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setUniversity(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\n                        </Button>\n                    </div>\n                    {error === false ? <Redirect\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpFb;",["378","379"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["380"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",["381","382","383","384","385","386","387","388","389"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDashboard.js",["390"],"import React, { useContext } from \"react\";\nimport { AppContext } from \"../../../context/AppContext\";\nimport withAuth from \"../../hoc/withAuth\";\nimport UserDetails from \"./UserDetails\";\nimport UserStats from \"./UserStats\";\nimport UserReview from \"./UserReview\";\n\nfunction UserDashboard() {\n    const appData = useContext(AppContext);\n\n    return (\n        <>\n            <UserDetails user={appData.user.data} />\n            {/*<UserStats />*/}\n            <UserReview user={appData.user.data}/>\n        </>\n    );\n}\n\n// function LoginRequired() {\n//     return <div> EFFETTUA IL LOGIN PER ACCEDERE </div>;\n// }\n\n// export default withAuth(UserDashboard, LoginRequired);\n\nexport default withAuth(UserDashboard);\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["391","392","393"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useMediaQuery.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReviews.js",["394","395","396"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",["397","398"],"import React, {useState} from 'react';\nimport FacebookLogin from 'react-facebook-login'\nimport {FaFacebookF} from \"react-icons/all\";\n\nconst LoginFacebook = (props) => {\n    const [onChangeUserFb, setOnChangeUserFb] = useState(null);\n    const [onChangeFb, setonChangeFb] = useState(null);\n    const [loading, setLoading] = useState(true);\n\n    const componentClicked = () => {\n        setLoading(true);\n    }\n\n    const responseFacebook = async (response) => {\n        setOnChangeUserFb(response);\n        setonChangeFb(true);\n        setLoading(false)\n        console.log(response)\n    }\n\n\n    let facebookData;\n    !loading ? facebookData = (\n        // <Redirect to={'/dashboard'} />\n        <div> </div>\n    ) : facebookData = (\n        <React.Fragment>\n            <FacebookLogin\n                appId=\"207812577218371\"\n                autoLoad={false}\n                fields=\"name, email, picture\"\n                onClick={componentClicked}\n                callback={responseFacebook}\n                textButton=\"\"\n                icon={<FaFacebookF style={{fill: \"white\"}}/>}\n                cssClass=\"facebook-btn\"\n            />\n        </React.Fragment>\n    )\n\n    return (\n        <>\n            {facebookData}\n        </>\n    );\n}\n\nexport default LoginFacebook;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useLoginForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewFormSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/useAddReviewForm.js",["399"],"import useFormField, { formToSubmittable, isFormValid } from \"../../../hooks/useFormField\";\n\nconst currentDate = () => {\n    const now = new Date();\n    return (\n        [now.getFullYear(), now.getMonth() + 1, now.getDate()].join(\"-\") +\n        \" \" +\n        [now.getHours(), now.getMinutes(), now.getSeconds()].join(\":\")\n    );\n};\n\nexport default function useAddReviewForm(professorId, userEmail, onSubmit) {\n    // questi due valori si auto settano usando come initial value i valori di argomenti passati all'hook\n    const professor_id = useFormField(\"professor_id\", null, null, professorId);\n    const user_email = useFormField(\"user_email\", null, null, userEmail);\n    \n    const corso_id = useFormField(\"corso_id\", null, \"Seleziona un corso\", null, (value) => value !== null);\n    \n    const titolo = useFormField(\"titolo\", \"Titolo della recensione\", \"Il campo non può essere vuoto\", \"\", (value) => value?.length > 0);\n    const corpo = useFormField(\"corpo\", \"Testo della recensione\", \"Il campo non può essere vuoto\", \"\", (value) => value?.length > 0);\n\n    // const data_creazione = useFormField(\"data_creazione\", \"Data recensione\", \"\", currentDate());\n    const anno_accademico = useFormField(\"anno_accademico\", \"Anno accademico\", \"Seleziona un anno accademico\", \"\", (value) => value.length > 0);\n    const voto = useFormField(\"voto\", \"Voto esame\", \"Inserisci un voto valido\", \"0\", (value) => parseInt(value) > 0 && parseInt(value) <= 30);\n    const anonimo = useFormField(\"anonimo\", \"Resta anonimo\", \"\", false);\n\n    const chiarezza_spiegazione_prof = useFormField(\"chiarezza_spiegazione_prof\", \"Chiarezza spiegazioni\", \"Imposta un valore\", 0, (value) => value > 0);\n    const materiale_didattico_prof = useFormField(\"materiale_didattico_prof\", \"Materiale didattico\", \"Imposta un valore\", 0, (value) => value > 0);\n    const correzione_compiti_prof = useFormField(\"correzione_compiti_prof\", \"Correzione compiti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const disponibilita_prof = useFormField(\"disponibilita_prof\", \"Disponibilità\", \"Imposta un valore\", 0, (value) => value > 0);\n\n    const difficolta_argomenti_corso = useFormField(\"difficolta_argomenti_corso\", \"Difficoltà argomenti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const difficolta_esame_corso = useFormField(\"difficolta_esame_corso\", \"Difficoltà esami\", \"Imposta un valore\", 0, (value) => value > 0);\n    const interesse_argomenti_corso = useFormField(\"interesse_argomenti_corso\", \"Interesse argomenti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const lo_consiglieresti_corso = useFormField(\"lo_consiglieresti_corso\", \"Lo consiglieresti\", \"Imposta un valore\", 0, (value) => value > 0);\n\n\n    const form = {\n        corso_id,\n        professor_id,\n        user_email,\n        titolo,\n        corpo,\n        anno_accademico,\n        voto,\n        anonimo,\n        chiarezza_spiegazione_prof,\n        materiale_didattico_prof,\n        correzione_compiti_prof,\n        disponibilita_prof,\n        difficolta_argomenti_corso,\n        difficolta_esame_corso,\n        interesse_argomenti_corso,\n        lo_consiglieresti_corso,\n    };\n\n    const submit = async (e) => {\n        if (e) e.preventDefault();\n\n        if (isFormValid(form)) onSubmit(formToSubmittable(form));\n    };\n\n    return [form, submit];\n}\n\n/**\n# form hook\n\n```ts\n// component.js\nconst form = useComponentForm();\n```\n\n```ts\n// useComponentForm.js\nconst form: IForm;\n\ninterface IForm {\n    [apiID: string]: {\n        key: apiID;\n        label: string;\n        value: any;\n        setValue: React.Dispatch<React.SetStateAction<any>>;\n        validate: (any) => boolean;\n        error: boolean;\n        setError: React.Dispatch<React.SetStateAction<boolean>>;\n        type?: FormType;\n    };\n}\n\nenum FormType {\n    TextField,\n    Radio,\n    Rating,\n}\n```\n\nhandleSubmit dentro hook ed esportato tipo questo\n\n```ts\nconst submit = () => {\n    for (const key in form) {\n        if (Object.hasOwnProperty.call(form, key)) {\n            const item = form[key];\n            if (item.validate(item.value))\n                // ...do something\n            else\n                // ...something else\n        }\n    }\n};\n```\n\nse tutti gli elementi vanno bene, chiama l'api endpoint, altrimenti errore?\n */\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserStats.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/ApiResponse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormTextField.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormCheckbox.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormRadio.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormRating.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/hoc/withAuth.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorReviews.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useFormField.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Text/ExpandableParagraph.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/progress/ProgressBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/progress/ProgressCircle.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useUniversityList.js",["400"],"import {useEffect, useState} from 'react';\nimport {ApiUniversitiesList} from \"../api\";\n\nconst useUniversityList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setUniversitiesList();\n        }\n    }, []);\n\n    const setUniversitiesList = async () => {\n        const professorsList = await ApiUniversitiesList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useUniversityList;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Settings.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAddProfessorReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Cards/Card.js",["401"],"import React, {useState} from 'react';\nimport styles from \"./Card.module.css\";\n\nconst Card = (props) => {\n\n    const {isSelected, title, text, onChangeSelected} = props;\n\n\n    let card = (\n        <>\n            <div className={styles.title}>\n                {title}\n            </div>\n            <div className={styles.text}>\n                {text}\n            </div>\n        </>\n    );\n\n    return (\n        <>\n            {isSelected ?\n                <div className={styles.cardActive}>\n                    {card}\n                </div>\n\n                :\n\n                <div className={styles.card} onClick={() => {\n                    onChangeSelected(title)\n                }}>\n                    {card}\n                </div>}\n\n        </>\n    );\n}\n\nexport default Card;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/SettingForm.js",["402"],"import React from \"react\";\nimport { ChangePswForm, Delete, Modify } from \"./index\";\nimport styles from \"./Settings.module.css\";\nimport Download from \"./Forms/Download\";\n\nconst SettingForm = (props) => {\n    const { selected } = props;\n    let form;\n    // let txtButton;\n\n    switch (selected) {\n        case \"Cambio password\":\n            form = <ChangePswForm />;\n            // txtButton = \"Invia\";\n            break;\n        /*case \"Modifica dati personali\":\n            form = <Modify />;\n            // txtButton = \"Invia\";\n            break;*/\n        case \"Elimina account\":\n            form = <Delete />;\n            // txtButton = \"Elimina\";\n            break;\n        case \"Scarica dati\":\n            form = <Download />;\n            // txtButton = \"Download\";\n            break;\n        /*case \"Contattaci\":\n            form = <div>Contattaci</div>;\n            break;*/\n        default:\n            return <div />;\n    }\n    return (\n        <>\n            <div className={styles.section}>\n                <h2 className={styles.title}>{selected}</h2>\n                {form}\n                {/* <div style={{maxWidth:\"30%\"}}>\n                    <Button buttonStyle=\"btn--outline\" type=\"submit\" >\n                        <h6 style={{ color: \"white\" }}>{txtButton}</h6>\n                    </Button>\n                </div> */}\n            </div>\n        </>\n    );\n};\n\nexport default SettingForm;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/CardContainer.js",["403"],"import React, {useState} from 'react';\nimport Card from \"../../Cards/Card\";\nimport styles from './CardsContainer.module.css'\n\nconst CardContainer = (props) => {\n    const {selected, onChangeSelected} = props;\n    //const titles = [\"Cambio password\", \"Modifica dati personali\", \"Elimina account\", \"Scarica dati\", \"Contattaci\"];\n    const titles = [\"Cambio password\", \"Elimina account\", \"Scarica dati\"];\n    /*const texts = [\"Clicca qui per cambiare la tua password.\", \"Clicca qui per modificare i tuoi dati.\",\n        \"Clicca qui per eliminare il tuo account. Attenzione, l'azione non è reversibile.\", \"Clicca qui per poter scaricare tutti i dati salvati sul sito.\",\n        \"Hai delle segnalazioni da fare? Clicca qui per contattarci.\"]\n     */\n    const texts = [\"Clicca qui per cambiare la tua password.\",\n        \"Clicca qui per eliminare il tuo account. Attenzione, l'azione non è reversibile.\", \"Clicca qui per poter scaricare tutti i dati salvati sul sito.\"]\n\n\n    return (\n        <>\n            <div className={styles.container}>\n                {titles.map((title, i) =>\n                    selected === title ? <Card title={title} text={texts[i]} isSelected={true} onChangeSelected={onChangeSelected}/>\n                        : <Card title={title} text={texts[i]} isSelected={false} onChangeSelected={onChangeSelected}/> )}\n            </div>\n        </>\n    );\n}\n\nexport default CardContainer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/ChangePswForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useChangePswForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Modify.js",["404"],"import React from 'react';\nimport FormTextField from \"../../../Forms/FormTextField\";\nimport useModifyForm from \"./useModifyForm\";\nimport styles from '../Settings.module.css';\nimport {Button} from \"../../../Buttons/Button\";\n\nconst Modify = (props) => {\n\n    let name = \"\";\n    const [form, submit] = useModifyForm(name);\n    return (\n        <>\n\n            <div className={styles.formContainer}>\n                <form className={styles.form} onSubmit={submit}>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.name} variant=\"outlined\" />\n                    </div>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.lastName} variant=\"outlined\" />\n                    </div>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.email} variant=\"outlined\" type=\"email\"  />\n                    </div>\n                </form>\n\n            </div>\n        </>\n    );\n}\n\nexport default Modify;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useModifyForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Delete.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useDeleteForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/ResetPassword.js",["405","406","407","408","409","410"],"import React from 'react';\nimport UniversitySection from \"../components/PagesSections/Homepage/University/UniveristyArea\";\nimport AboutArea from \"../components/PagesSections/Homepage/About/AboutArea\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport HeroSection from \"../components/PagesSections/Homepage/HeroSection/HeroSection\";\nimport FormTextField from \"../components/Forms/FormTextField\";\nimport {Button} from \"../components/Buttons/Button\";\nimport useLoginForm from \"../components/PagesSections/Login-SignUp/useLoginForm\";\nimport ResetPasswordFrom from \"../components/PagesSections/ResetPassword/ResetPasswordFrom\";\n\nfunction ResetPassword() {\n\n    return (\n        <>\n            <Navbar />\n            <ResetPasswordFrom/>\n        </>\n    );\n}\n\nexport default ResetPassword;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/ResetPassword/ResetPasswordFrom.js",["411"],"import React from \"react\";\nimport styles from \"./ResetPassword.module.css\";\nimport FormTextField from \"../../Forms/FormTextField\";\nimport { Button } from \"../../Buttons/Button\";\nimport useResetPasswordForm from \"./useResetPasswordForm\";\nimport { useResetPassword } from \"../../../hooks/useResetPassword\";\nimport { useLocation, useParams } from \"react-router\";\n\nfunction ResetPasswordFrom(props) {\n    const { token } = useParams();\n    const [request, result] = useResetPassword();\n    const [form, submit] = useResetPasswordForm(token, request);\n\n    return (\n        <>\n            <div className={\"element-center\"}>\n                <div className={\"title-red\"}>Ripristina la password</div>\n            </div>\n            <div className={styles.section}>\n                <form className={styles.form} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={styles.input}>\n                        <FormTextField field={form.new_password} variant=\"outlined\" type=\"password\" />\n                    </div>\n                    <div className={styles.input}>\n                        <FormTextField field={form.repeatPassword} variant=\"outlined\" type=\"password\" />\n                    </div>\n                    <div className={styles.input}>\n                        <Button buttonStyle=\"btn--outline\" type=\"submit\">\n                            <h6 style={{ color: \"white\" }}>Invia</h6>\n                        </Button>\n                    </div>\n                    <div>{result === \"OK\" ? \"Password modificata\" : result === \"FAILED\" ? \"Non è stato possibile cambiare la password\" : null}</div>\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default ResetPasswordFrom;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/UserSettings.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useSignUpForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useSignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Download.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useDownloadUserData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useUserReviews.js",["412"],"import { useEffect, useState } from \"react\";\nimport {ApiReviews, ApiUserReviews} from \"../api\";\n\nconst useUserReviews = (email, num = 1) => {\n    const [reviews, setReviews] = useState([]);\n\n    useEffect(() => {\n        ApiUserReviews(email, num).then((data) => setReviews(data));\n    }, [email, num]);\n\n    return reviews;\n};\n\nexport default useUserReviews;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/ResetPassword/useResetPasswordForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useForgotPasswordForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useResetPassword.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useForgotPassword.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Admin.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Admin/ReviewsControl.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAdminReviews.js",["413","414"],"import { useEffect, useState } from \"react\";\nimport {ApiAdminReviews, ApiReviews, ApiUserReviews} from \"../api\";\n\nconst useAdminReviews = (email, num = 1) => {\n    const [reviews, setReviews] = useState([]);\n\n    useEffect(() => {\n        ApiAdminReviews(email, num).then((data) => setReviews(data));\n    }, [email, num]);\n\n    return reviews;\n};\n\nexport default useAdminReviews;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],{"ruleId":"415","replacedBy":"416"},{"ruleId":"417","replacedBy":"418"},{"ruleId":"419","severity":1,"message":"420","line":49,"column":9,"nodeType":"421","endLine":49,"endColumn":132,"suggestions":"422"},{"ruleId":"419","severity":1,"message":"423","line":11,"column":8,"nodeType":"421","endLine":11,"endColumn":10,"suggestions":"424"},{"ruleId":"419","severity":1,"message":"425","line":21,"column":8,"nodeType":"421","endLine":21,"endColumn":48,"suggestions":"426"},{"ruleId":"427","severity":1,"message":"428","line":1,"column":29,"nodeType":"429","messageId":"430","endLine":1,"endColumn":37},{"ruleId":"431","severity":1,"message":"432","line":20,"column":40,"nodeType":"433","messageId":"434","endLine":20,"endColumn":42},{"ruleId":"419","severity":1,"message":"425","line":22,"column":8,"nodeType":"421","endLine":22,"endColumn":21,"suggestions":"435"},{"ruleId":"427","severity":1,"message":"436","line":4,"column":9,"nodeType":"429","messageId":"430","endLine":4,"endColumn":13},{"ruleId":"437","severity":1,"message":"438","line":11,"column":21,"nodeType":"439","endLine":11,"endColumn":119},{"ruleId":"437","severity":1,"message":"438","line":20,"column":21,"nodeType":"439","endLine":20,"endColumn":95},{"ruleId":"437","severity":1,"message":"438","line":23,"column":21,"nodeType":"439","endLine":23,"endColumn":87},{"ruleId":"437","severity":1,"message":"438","line":26,"column":21,"nodeType":"439","endLine":26,"endColumn":73},{"r