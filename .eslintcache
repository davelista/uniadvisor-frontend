dRules":"62"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"111","messages":"112","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"113","usedDeprecatedRules":"62"},{"filePath":"114","messages":"115","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"116","messages":"117","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"118","usedDeprecatedRules":"62"},{"filePath":"119","messages":"120","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"121","messages":"122","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"123","messages":"124","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"125","messages":"126","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"127","usedDeprecatedRules":"62"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["128","129"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["130","131","132","133","134"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport Popup from \"../Popup/Popup\";\nimport Login from \"../../pages/Login\";\n\nconst Navbar = (props) => {\n\n    const {onChangeUser} = props;\n    const [isOpenLoginForm, setOpenLoginForm] = React.useState(false);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n\n                {/* LOGIN POPUP\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm &&\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\n                        <Login onChangeUser={onChangeUser}/>\n                    </Popup>}\n                </div>*/}\n                <Link to='/login' className=\"navbar-title\">\n                    <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                </Link>\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["135"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["136"],"import {useEffect, useState} from 'react';\nimport {ApiProfessor} from \"../api\";\n\nconst useProfessor = (endpoint) => {\n    const [state, setState] = useState();\n    const [isLoading, setLoading] = useState(true);\n    useEffect(() => {\n        setProfessor();\n    }, [endpoint]);\n\n    const setProfessor = async () => {\n        setLoading(true);\n        const professorEndpoint = endpoint ? endpoint : undefined\n        if (professorEndpoint != null) {\n            const selectedProfessor = await ApiProfessor(professorEndpoint);\n            setState(selectedProfessor);\n            setLoading(false);\n        }\n\n    };\n    return [state, isLoading, setProfessor];\n};\n\nexport default useProfessor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["137"],"import React, {useState} from 'react';\nimport Navbar from \"../../Navbar/Navbar\";\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport Review from \"./Review\";\nimport {Button} from \"../../Buttons/Button\";\n/*ICONS*/\nimport EmailIcon from '@material-ui/icons/Email';\nimport WorkIcon from '@material-ui/icons/Work';\nimport AccountBalanceIcon from '@material-ui/icons/AccountBalance';\nimport BusinessIcon from '@material-ui/icons/Business';\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\n\nfunction ProfessorDetails(props) {\n    const {professor, professorImg} = props;\n    const [courseId, setCouseId] = useState(1);\n\n    let image;\n    professorImg === \"Not Found Image\" ? image = (<img src={imgUser} className={\"professor-img\"} alt={imgUser}/>) : image = (<img src={professorImg} className={\"professor-img\"} alt={professorImg}/>)\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                {image}\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>{professor.name}</h1>\n                        {professor.finalEvaluation.filter(x => x.title === \"Overall\")\n                            .map((x) => {\n                                return (\n                                    <div className={\"bubble-rating\"}>\n                                    <Rating name=\"half-rating-read\"\n                                            defaultValue={x.value}\n                                            precision={0.5}\n                                            readOnly\n                                            emptyIcon={<FiberManualRecordOutlinedIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                            icon={<FiberManualRecordIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                    />\n                                    </div>\n                                )\n                            })}\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><AccountBalanceIcon fontSize=\"small\" style={{fill: \"#e53a1e\", marginRight: \"3%\"}}/><h3 style={{color: \"#e53a1e\"}}>{x.name}</h3></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><EmailIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{professor.email}</p></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><WorkIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.typeContract}</p> </div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><BusinessIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.department}</p> </div>\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.finalEvaluation}/>\n                    </div>\n                </div>\n            </div>\n\n            <div className={\"professor-title-courses\"}>\n                {professor.university.map((university) => {\n                        return university.courses.map((course) => {\n                            return ( <>\n                                {courseId === course.id ?\n                                <h4 className={\"course-title-button\"} onClick={() => {\n                                    setCouseId(course.id)\n                                }} style={{color: \"#e53a1e\"}}> {course.name}</h4> : <h4 className={\"course-title-button\"} onClick={() => {\n                                        setCouseId(course.id)\n                                    }} style={{color: \"#c9c9c9\"}}> {course.name}</h4>} </>\n                            )\n\n                        } )\n                    }\n                )}\n            </div>\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <div className={\"course-info-section\"}>\n                                        {courseId === course.id ? <ProfessorCourse course={course}/> : null}\n                                    </div>\n                                )\n                            })\n                        }\n                    )}\n                </div>\n            </div>\n\n            <div className={\"reviews-section\"}>\n                <div className={\"reviews-section-title\"}>\n                    <h2>Leggi le recensioni</h2>\n                    <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Scrivi una recensione</h6></Button>\n                </div>\n                <>\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <>\n                                        {courseId === course.id && course.reviews.length !== 0 ?\n                                            <Review review={course.reviews}/> : null}\n                                    </>\n                                )\n                            })\n                        }\n                    )}\n                </>\n                <div className={\"reviews-section-title\"}>\n                    <h3>Vecchie recensioni</h3>\n                </div>\n                <>\n                    {professor.oldReview.map((x) => {\n                        return <Review review={x} oldReview={true}/>\n                    })}\n                </>\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorDetails;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],["138","139"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/Review.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["140","141"],"import axios from \"axios\";\n\nexport const ApiProfessor = async (professorEndpoint) => {\n    try{\n        const res = await axios.get(\"/api/professors/\"+professorEndpoint);\n        return res.data;\n    } catch (e){\n        throw e;\n    }\n};\n\nexport const ApiProfessorImage = async (professorEndpoint) => {\n    try{\n        const img = await axios.get(\"/api/professor_image/\" + professorEndpoint)\n        return img;\n    } catch (e){\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 404\"){\n            return \"Not Found Image\";\n        }\n        throw e;\n    }\n};\n\nexport const ApiMail = async (email) => {\n    try{\n        const res = await axios.post(\"/api/email\", {email})\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        //return res.data;\n    } catch (e) {\n        throw e;\n    }\n\n};\n\nexport const ApiRegister = async (name, surname, email, password, university) =>{\n    try{\n        const res = await axios.post(\"/api/register\", {name, surname, email, password, university})\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        return res;\n    } catch (e) {\n        throw e;\n    }\n}\n\nexport const ApiLogin = async (email, password) => {\n    try{\n        /*withCredentials: true è per i cookies*/\n        return await axios.post(\"/api/user_login\", {email, password}, {withCredentials: true});\n\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 406\"){\n            return null;\n        }\n        else if(e.message === \"Request failed with status code 400\"){\n            return null;\n        }\n        throw e;\n\n    }\n}\n\nexport default {ApiProfessor, ApiProfessorImage, ApiMail, ApiRegister, ApiLogin};","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["142","143"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport './Login.css'\nimport {Button} from \"../../Buttons/Button\";\nimport {Link} from \"react-router-dom\";\nimport {ApiLogin} from \"../../../api\";\nimport LoginFacebook from \"./LoginFacebook\";\n\nconst LoginForm = (props) => {\n    const {onChangeUser, onChangeError} = props;\n\n\n    const [email, setEmail] = useState('');\n    const [password, setPassword] = useState('');\n    const [loading, setLoading] = useState(false);\n    const [done, setDone] = useState(false);\n    const [error, setError] = useState('');\n\n    let result;\n    const submit = async (e) => {\n        e.preventDefault();\n\n        if (email !== '' && password !== '') {\n            try {\n                result = await ApiLogin(email, password);\n                //console.log(result);\n                setLoading(!loading);\n                if (result !== null) {\n                    console.log(result);\n                    setDone(true);\n                    onChangeError(false);\n                } else onChangeError(true)\n                setDone(!done);\n                onChangeUser(email);\n                setLoading(!loading);\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            onChangeError(\"ERRORE! I campi sono vuoti\")\n        }\n    }\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Login</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={\"form-input\"}>\n\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Username\"\n                            placeholder=\"Inserisci la tua mail\"\n                            variant=\"outlined\"\n                            type=\"email\"\n                            onChange={e => setEmail(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                autoFocus: true\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Password\"\n                            placeholder=\"Inserisci la tua password\"\n                            variant=\"outlined\"\n                            type=\"password\"\n                            onChange={e => setPassword(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6>\n                        </Button>\n                    </div>\n                    {/*<FormControlLabel\n                        value=\"ricordami\"\n                        control={<Checkbox color=\"primary\" />}\n                        label=\"Ricordami\"\n                        labelPlacement=\"end\"\n                    />*/}\n                    <div>\n                        oppure\n                    </div>\n                    <LoginFacebook onChangeUser={onChangeUser}/>\n                </form>\n\n\n            </div>\n            <div className={\"register-option-container\"}>\n                <div className={\"register-option-text\"}>\n                    Non hai ancora un account?\n                </div>\n                <div className={\"register-option-button\"}>\n                    <Link to='/sign-up'>\n                        <Button buttonStyle='btn--outline--white'>\n                            <h6>Registrati</h6>\n                        </Button>\n                    </Link>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default LoginForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",["144","145","146"],"import React, {useState} from 'react';\nimport FacebookLogin from 'react-facebook-login'\nimport {Redirect, Route} from \"react-router\";\nimport {Icon} from \"@material-ui/core\";\nimport {FaFacebookF} from \"react-icons/all\";\n\nconst LoginFacebook = (props) => {\n    const {onChangeUser} = props;\n    const [state, setState] = useState({auth: false, name: '', email: '', picture: ''});\n    const [loading, setLoading] = useState(true);\n\n    const componentClicked = () => {\n        console.log('Facebook btn click');\n    }\n\n    const responseFacebook = async (response) => {\n        console.log(response);\n        setLoading(true);\n        setState({auth: true, name: response.name, email: response.email, picture: response.picture.data.url});\n        onChangeUser(response.name);\n        setLoading(false);\n\n    }\n\n    let facebookData;\n    state.name!=='' ? facebookData = (\n        <Redirect to={'/dashboard'} />\n\n    ) : facebookData = (\n        <React.Fragment>\n        <FacebookLogin\n            appId=\"207812577218371\"\n            autoLoad={false}\n            fields=\"name, email, picture\"\n            onClick={componentClicked}\n            callback={responseFacebook}\n            textButton = \"\"\n            // icon=\n             icon={<FaFacebookF style={{fill:\"white\"}}/>}\n            cssClass=\"facebook-btn\"\n        />\n        </React.Fragment>\n    )\n\n    return (\n        <>\n            {facebookData}\n        </>\n    );\n}\n\nexport default LoginFacebook;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/404.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails/UserDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["147"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;",{"ruleId":"148","replacedBy":"149"},{"ruleId":"150","replacedBy":"151"},{"ruleId":"152","severity":1,"message":"153","line":1,"column":16,"nodeType":"154","messageId":"155","endLine":1,"endColumn":24},{"ruleId":"152","severity":1,"message":"156","line":7,"column":8,"nodeType":"154","messageId":"155","endLine":7,"endColumn":13},{"ruleId":"152","severity":1,"message"