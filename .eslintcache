eprecatedRules":"164"},{"filePath":"317","messages":"318","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"319","usedDeprecatedRules":"164"},{"filePath":"320","messages":"321","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"322","messages":"323","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"324","messages":"325","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"326","usedDeprecatedRules":"164"},{"filePath":"327","messages":"328","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"329","messages":"330","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"331","messages":"332","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"333","usedDeprecatedRules":"164"},{"filePath":"334","messages":"335","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"336","messages":"337","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"338","messages":"339","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"340","messages":"341","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},{"filePath":"342","messages":"343","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"164"},"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/index.js",[],["344","345"],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/context/AppContext.js",["346"],"import React, { useMemo } from \"react\";\nimport useProfessor from \"../hooks/useProfessor\";\nimport useAuth from \"../hooks/useAuth\";\nimport useProfessorsList from \"../hooks/useProfessorsList\";\nimport useUniversityList from \"../hooks/useUniversityList\";\n\n// const defaultContext = {\n//     professorsList: null,\n//     universitiesList: null,\n//     user: {\n//         data: null,\n//         login: () => {},\n//         validateSession: () => {},\n//         refresh: () => {},\n//     },\n//     professor: {\n//         data: null,\n//         // image: null,\n//         refresh: () => {},\n//     },\n// };\n\nexport const AppContext = React.createContext({});\n\nexport function useAppContext() {\n    const professorsList = useProfessorsList();\n    const universitiesList = useUniversityList();\n    const [professor, refreshProfessor] = useProfessor();\n    const [auth, user, login, validateSession, logout, changePassword, deleteUser] = useAuth();\n\n    return useMemo(\n        () => ({\n            professorsList,\n            universitiesList,\n            user: {\n                auth,\n                data: user,\n                login,\n                validateSession,\n                logout,\n                changePassword,\n                deleteUser,\n            },\n            professor: {\n                data: professor,\n                refresh: refreshProfessor,\n            },\n        }),\n        [professorsList, universitiesList, professor, refreshProfessor, user, login, validateSession, auth, logout, changePassword]\n    );\n}\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/index.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/index.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useProfessor.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useProfessorsList.js",["347"],"import {useEffect, useState} from 'react';\nimport {ApiProfessorsList} from \"../api\";\n\nconst useProfessorsList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setProfessorsList();\n        }\n    }, []);\n\n    const setProfessorsList = async () => {\n        const professorsList = await ApiProfessorsList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useProfessorsList;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useUniversityList.js",["348"],"import {useEffect, useState} from 'react';\nimport {ApiUniversitiesList} from \"../api\";\n\nconst useUniversityList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setUniversitiesList();\n        }\n    }, []);\n\n    const setUniversitiesList = async () => {\n        const professorsList = await ApiUniversitiesList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useUniversityList;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useAuth.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Login.js",["349"],"import React, { useContext, useState } from \"react\";\nimport LoginForm from \"../components/PagesSections/Login-SignUp/LoginForm\";\nimport { Redirect } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport { AppContext } from \"../context/AppContext\";\n\nconst Login = () => {\n    const appData = useContext(AppContext)\n\n    if (appData.user.auth === \"OK\") return <Redirect to={\"/dashboard\"} />\n\n    return (\n        <>\n            <Navbar />\n            <LoginForm />\n        </>\n    );\n};\n\nexport default Login;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Professor.js",["350"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nfunction Professor( ) {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n    useEffect(() => {\n        appData.professor.refresh(professorId);\n    }, [professorId, appData.professor.refresh]);\n\n    return (\n        <div>\n            <Navbar />\n            {appData.professor.data !== null ? (\n                <ProfessorDetails professor={appData.professor.data} />\n            ) : (\n                <LoadingComponent />\n            )}\n        </div>\n    );\n}\n\nexport default Professor;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/AddReview.js",["351","352"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport AddReviewForm from \"../components/PagesSections/AddReview/AddReviewForm\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nexport default function AddReview() {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n\n    useEffect(() => {\n        if (appData.professor.data?.id == professorId) return; // non mettere \"===\" (id: number, professorId: string)\n        appData.professor.refresh(professorId);\n    }, [professorId]);\n\n    return (\n        <>\n            <Navbar />\n\n            {appData.professor.data !== null ? (\n                <AddReviewForm />\n            ) : (\n                <LoadingComponent />\n            )}\n        </>\n    );\n}\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Settings.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/ResetPassword.js",["353","354","355","356","357","358"],"import React from 'react';\nimport UniversitySection from \"../components/PagesSections/Homepage/University/UniveristyArea\";\nimport AboutArea from \"../components/PagesSections/Homepage/About/AboutArea\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport HeroSection from \"../components/PagesSections/Homepage/HeroSection/HeroSection\";\nimport FormTextField from \"../components/Forms/FormTextField\";\nimport {Button} from \"../components/Buttons/Button\";\nimport useLoginForm from \"../components/PagesSections/Login-SignUp/useLoginForm\";\nimport ResetPasswordFrom from \"../components/PagesSections/ResetPassword/ResetPasswordFrom\";\n\nfunction ResetPassword() {\n\n    return (\n        <>\n            <Navbar />\n            <ResetPasswordFrom/>\n        </>\n    );\n}\n\nexport default ResetPassword;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/pages/Admin.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Footer/Footer.js",["359","360","361","362","363"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\nimport {Link} from \"react-router-dom\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <a href=\"https://www.instagram.com/spotted_polimi/?hl=it\" target=\"_blank\">\n                        <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    </a>\n                    <a href=\"https://www.facebook.com/PolimiSpotted/\" target=\"_blank\">\n                        <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    </a>\n                    <a href=\"mailto:info@uniadvisor.it\" target=\"_blank\">\n                        <FiMail class={'social-icon-bg social-icon'}/>\n                    </a>\n\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Navbar/Navbar.js",["364","365","366","367"],"import React, {useContext, useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport SearchBar from \"../SearchBar/SearchBar\";\nimport useMediaQuery, { Device } from '../../hooks/useMediaQuery';\nimport SearchIcon from '@material-ui/icons/Search';\nimport { AppContext } from '../../context/AppContext';\nimport MuiMenuItem from \"@material-ui/core/MenuItem\";\nimport MenuItem from '@material-ui/core/MenuItem';\nimport {ClickAwayListener, Grow, MenuList, Paper, Popper, withStyles} from \"@material-ui/core\";\nimport {FaUser, IoMdSettings} from \"react-icons/all\";\nimport ProgressCirle from \"../progress/ProgressCircle\";\n\n\nconst Navbar = (props) => {\n\n    const { isHome = false} = props;\n\n    const appData = useContext(AppContext);\n\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\n    const isMobile = useMediaQuery(Device.sm);\n    const [mobileSearchHidden, setMobileSearchHidden] = useState(true);\n    const [isOpenDropdown, setOpenDropdown] = React.useState(null);\n    const anchorRef = React.useRef(null);\n\n    const MenuItem = withStyles({\n        root: {\n            justifyContent: \"center\"\n        }\n    })(MuiMenuItem);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n\n    const handleClick = (event) => {\n        setOpenDropdown(event.currentTarget);\n    };\n\n    const handleToggle = () => {\n        setOpenDropdown((prevOpen) => !prevOpen);\n    };\n\n    const handleClose = () => {\n        setOpenDropdown(null);\n    };\n\n    const handleLogout = () => {\n        appData.user.logout();\n        handleClose();\n    }\n\n    const prevOpen = React.useRef(isOpenDropdown);\n    React.useEffect(() => {\n        if (prevOpen.current === true && isOpenDropdown === false) {\n            anchorRef.current.focus();\n        }\n        prevOpen.current = isOpenDropdown;\n    }, [isOpenDropdown]);\n\n    function handleListKeyDown(event) {\n        if (event.key === 'Tab') {\n            event.preventDefault();\n            setOpenDropdown(false);\n        }\n    }\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n    let button;\n    appData.user.data === null ? button = (\n            <Link to='/login' className=\"navbar-title\">\n                {/* <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button> */}\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>{isMobile ? \"Accedi\" : \"Accedi/Registrati\"}</h6></Button>\n            </Link>\n        ) : button = (<>\n            <div className={\"user-icon\"} ref={anchorRef}\n                 aria-controls={isOpenDropdown ? 'menu-list-grow' : undefined}\n                 aria-haspopup=\"true\"\n                 onClick={handleToggle}\n            ><FaUser size={30}/></div>\n                <Popper open={isOpenDropdown} anchorEl={anchorRef.current} role={undefined} transition disablePortal>\n                    {({ TransitionProps, placement }) => (\n                        <Grow\n                            {...TransitionProps}\n                            style={{ transformOrigin: placement === 'bottom' ? 'center top' : 'center bottom' }}\n                        >\n                            <Paper>\n                                <ClickAwayListener onClickAway={handleClose}>\n                                    <MenuList autoFocusItem={isOpenDropdown} id=\"menu-list-grow\" onKeyDown={handleListKeyDown}>\n                                        <Link to='/dashboard'> <MenuItem onClick={handleClose}>Profile</MenuItem></Link>\n                                        <Link to=\"/\"><MenuItem onClick={handleLogout}>Logout</MenuItem></Link>\n                                        <Link to='/settings'><MenuItem onClick={handleClose}><IoMdSettings/></MenuItem></Link>\n                                    </MenuList>\n                                </ClickAwayListener>\n                            </Paper>\n                        </Grow>\n                    )}\n                </Popper>\n            </>\n        )\n\n    let search;\n    !isHome && appData.professorsList !== null ? search=(<div className={'nav-search'}><SearchBar professorsList={appData.professorsList} isHome={isHome}/></div>) : search=(<div/>)\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                {isMobile && !isHome? <div className={'nav-search'}><SearchIcon onClick={() => setMobileSearchHidden(value => !value)} /></div> : search}\n                {/* LOGIN POPUP\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm &&\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\n                        <Login onChangeUser={onChangeUser}/>\n                    </Popup>}\n                </div>*/}\n                {button}\n\n                {!mobileSearchHidden && isMobile && !isHome ? <div className=\"navbar-mobile-search\">{search}</div> : null}\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/progress/ProgressCircle.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Forms/FormTextField.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useLoginForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDashboard.js",["368"],"import React, { useContext } from \"react\";\nimport { AppContext } from \"../../../context/AppContext\";\nimport withAuth from \"../../hoc/withAuth\";\nimport UserDetails from \"./UserDetails\";\nimport UserStats from \"./UserStats\";\nimport UserReview from \"./UserReview\";\n\nfunction UserDashboard() {\n    const appData = useContext(AppContext);\n\n    return (\n        <>\n            <UserDetails user={appData.user.data} />\n            {/*<UserStats />*/}\n            <UserReview user={appData.user.data}/>\n        </>\n    );\n}\n\n// function LoginRequired() {\n//     return <div> EFFETTUA IL LOGIN PER ACCEDERE </div>;\n// }\n\n// export default withAuth(UserDashboard, LoginRequired);\n\nexport default withAuth(UserDashboard);\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/UserSettings.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["369"],"import React, {useState} from 'react';\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\n/*ICONS*/\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\nimport EmailIcon from \"@material-ui/icons/Email\";\nimport WorkIcon from \"@material-ui/icons/Work\";\nimport BusinessIcon from \"@material-ui/icons/Business\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport { Button } from '../../Buttons/Button';\nimport { Link } from 'react-router-dom';\nimport ProfessorReviews from \"./ProfessorReviews\";\n\nfunction ProfessorDetails(props) {\n    const {professor} = props;\n    const [courseId, setCouseId] = useState(0);\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                <img\n                    src={\"/api/professor_image/\" + professor.id}\n                    className={\"professor-img\"}\n                    alt={`${professor.nome} ${professor.cognome}`}\n                />\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>\n                            {professor.nome} {professor.cognome}\n                        </h1>\n                        <div className={\"bubble-rating\"}>\n                            <Rating\n                                name=\"half-rating-read\"\n                                defaultValue={professor.metrics.overall}\n                                precision={0.5}\n                                readOnly\n                                emptyIcon={\n                                    <FiberManualRecordOutlinedIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />\n                                }\n                                icon={<FiberManualRecordIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />}\n                            />\n                        </div>\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <AccountBalanceIcon\n                                            fontSize=\"small\"\n                                            style={{\n                                                fill: \"#e53a1e\",\n                                                marginRight: \"3%\",\n                                            }}\n                                        />\n                                        <h3 style={{ color: \"#e53a1e\" }}>{x.name}</h3>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <EmailIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.email}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <WorkIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.contratto}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <BusinessIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.dipartimento}</p>\n                                    </div>\n                                );\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.metrics} />\n                    </div>\n                </div>\n            </div>\n            {professor.corsi.length > 0 ?\n                <>\n                    <div className={\"professor-title-courses\"}>\n                {professor.corsi.map((course, i) => (\n                    <h4\n                        className={\"course-title-button\"}\n                        onClick={() => {\n                            setCouseId(i);\n                        }}\n                        style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\n                    >\n                        {course.name}\n                    </h4>\n                )) }\n            </div>\n\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.corsi.map((x, i) => {\n                        return (\n                            <div >\n                                {courseId === i ? <ProfessorCourse course={x} /> : null}\n\n                            </div>\n                        );\n                    })  }\n                </div>\n            </div>\n                    {professor.privacy ?\n                        <div className={\"reviews-section\"}>\n                            <div className={\"no-reviews-section\"}>\n                                <div className={\"no-reviews-title\"}>\n                                    <h5>Il professore ha chiesto (gentilmente) di nascondere le recensioni che lo riguardano.</h5>\n                                    <p>Lascia comunque una recensione per aiutare gli altri studenti!</p>\n                                </div>\n                                <Link to={\"/add-review/professors/\" + professor.id}>\n                                    <Button buttonStyle=\"btn--outline\" >\n                                        <h6 style={{ color: \"white\" }}>Scrivi una recensione</h6>\n                                    </Button>\n                                </Link>\n                            </div>\n                        </div>: <ProfessorReviews professor={professor} icourse={courseId} />}\n\n                </>\n                : <div className={\"no-reviews-section\"}>\n                <div className={\"no-reviews-title\"}>\n                <h5>Ci risulta che attualmente questo professore non abbia corsi attivi.</h5>\n                    <p>Se non è così scrivici una mail a <a style={{color:\"#e53a1e\"}} href=\"mailto:supporto@uniadvisor.it\">supporto@uniadvisor.it</a>!</p>\n                </div>\n                </div>\n            }\n        </>\n    );\n}\n\nexport default ProfessorDetails;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/ResetPassword/ResetPasswordFrom.js",["370"],"import React from \"react\";\nimport styles from \"./ResetPassword.module.css\";\nimport FormTextField from \"../../Forms/FormTextField\";\nimport { Button } from \"../../Buttons/Button\";\nimport useResetPasswordForm from \"./useResetPasswordForm\";\nimport { useResetPassword } from \"../../../hooks/useResetPassword\";\nimport { useLocation, useParams } from \"react-router\";\n\nfunction ResetPasswordFrom(props) {\n    const { token } = useParams();\n    const [request, result] = useResetPassword();\n    const [form, submit] = useResetPasswordForm(token, request);\n\n    return (\n        <>\n            <div className={\"element-center\"}>\n                <div className={\"title-red\"}>Ripristina la password</div>\n            </div>\n            <div className={styles.section}>\n                <form className={styles.form} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={styles.input}>\n                        <FormTextField field={form.new_password} variant=\"outlined\" type=\"password\" />\n                    </div>\n                    <div className={styles.input}>\n                        <FormTextField field={form.repeatPassword} variant=\"outlined\" type=\"password\" />\n                    </div>\n                    <div className={styles.input}>\n                        <Button buttonStyle=\"btn--outline\" type=\"submit\">\n                            <h6 style={{ color: \"white\" }}>Invia</h6>\n                        </Button>\n                    </div>\n                    <div>{result === \"OK\" ? \"Password modificata\" : result === \"FAILED\" ? \"Non è stato possibile cambiare la password\" : null}</div>\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default ResetPasswordFrom;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Admin/ReviewsControl.js",["371","372"],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["373"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/api/index.js",["374","375","376"],"import axios from \"axios\";\nimport ApiResponse from \"./ApiResponse\";\n\n/*API to request professor detail*/\nexport const ApiProfessorsList = async () => {\n    try {\n        const res = await axios.get(\"/api/professors_list\");\n        return res.data.results;\n    } catch (e) {\n        if (e != null) {\n            return null;\n        }\n        throw e;\n    }\n};\n\n/*API to request professor detail*/\nexport const ApiProfessor = async (professorId) => {\n    try {\n        const res = await axios.get(\"/api/professors/\" + professorId);\n        return res.data;\n    } catch (e) {\n        switch (e.message) {\n            case \"Request failed with status code 400\":\n                return \"No professor\";\n            case \"Request failed with status code 500\":\n                return \"Internal error\";\n            default:\n                return \"Error\";\n        }\n        throw e;\n    }\n};\n\n/*API to register new users*/\nexport const ApiRegisterResponse = new ApiResponse(\"OK\", \"ALREADY_REGISTERED\", \"FAILED\");\nexport const ApiRegister = async (data) => {\n    return axios\n        .post(\"/api/register\", data)\n        .then((res) => {\n            switch (res.status) {\n                case 201:\n                    return { res: ApiRegisterResponse.OK };\n                case 202:\n                    return { res: ApiRegisterResponse.ALREADY_REGISTERED };\n                default:\n                    return { res: ApiRegisterResponse.OK };\n            }\n        })\n        .catch((err) => {\n            const { status } = err.response;\n            switch (status) {\n                case 303:\n                    return { res: ApiRegisterResponse.OK };\n                case 400:\n                    return { res: ApiRegisterResponse.FAILED };\n                default:\n                    return { res: ApiRegisterResponse.FAILED };\n            }\n        });\n};\n\n/*API to login users*/\nexport const ApiLoginResponse = new ApiResponse(\"OK\", \"REQUIRES_CONFIRM\", \"INVALID_CREDENTIALS\", \"MISSING_USER\", \"UNAUTH\");\n/**\n * Login\n * @param {{email: string; password: string; login_type: string; remember_me: boolean}} data\n * @returns {{void}}\n */\nexport const ApiLogin = async (data) => {\n    return axios\n        .post(\"/api/user_login\", data, { withCredentials: true })\n        .then((res) => ({\n            res: ApiLoginResponse.OK,\n            data: res.data,\n        }))\n        .catch((err) => {\n            const { status } = err.response;\n            switch (status) {\n                case 406:\n                    return { res: ApiLoginResponse.MISSING_USER, data: null };\n                case 400:\n                    return { res: ApiLoginResponse.REQUIRES_CONFIRM, data: null };\n                default:\n                    return { res: ApiLoginResponse.INVALID_CREDENTIALS, data: null };\n            }\n        });\n};\n\nexport const ApiValidateSessionResponse = new ApiResponse(\"OK\", \"UNAUTH\");\nexport const ApiValidateSession = async () => {\n    return axios\n        .get(\"/api/test_cookies\", { withCredentials: true })\n        .then((res) => ({\n            res: ApiValidateSessionResponse.OK,\n            data: res.data,\n        }))\n        .catch(() => ({\n            res: ApiValidateSessionResponse.UNAUTH,\n            data: null,\n        }));\n};\n\nexport const ApiLogoutResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiLogout = async () => {\n    return axios\n        .post(\"/api/user_logout\", {}, { withCredentials: true })\n        .then(() => ({ res: ApiLogoutResponse.OK }))\n        .catch(() => ({\n            res: ApiLogoutResponse.FAILED,\n        }));\n};\n\nexport const ApiAddProfessorReviewResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiAddProfessorReview = async (data) => {\n    return axios\n        .post(\"/api/new_review\", data)\n        .then(() => ({\n            res: ApiAddProfessorReviewResponse.OK,\n        }))\n        .catch(() => ({\n            res: ApiAddProfessorReviewResponse.FAILED,\n        }));\n};\n\n/*API to send user's email*/\nexport const ApiMail = async (email) => {\n    try {\n        const res = await axios.post(\"/api/email\", { email });\n    } catch (e) {\n        throw e;\n    }\n};\n\n/*API to see professor's reviews*/\nexport const ApiReviews = async (corso_id, professor_id, num) => {\n    try {\n        const res = await axios.get(\"/api/reviews_course\", { params: { corso_id, professor_id, num } });\n        return res.data.results;\n    } catch (e) {\n        if (e.message === \"Request failed with status code 400\") {\n            return null;\n        }\n        throw e;\n    }\n};\n\n/*API to see user's review*/\nexport const ApiUserReviews = async (user_email, num) => {\n    try {\n        const res = await axios.get(\"/api/reviews_user\", { params: { user_email, num } });\n        return res.data.results;\n    } catch (e) {\n        throw e;\n    }\n};\n\n/*API to admin's page to approve or decline the reviews */\nexport const ApiAdminReviews = async (user_email, num) => {\n    try {\n        const res = await axios.get(\"/api/admin\", { params: { user_email, num } });\n        return res.data.results;\n\n    } catch (e) {\n        const { status } = e.response;\n\n        switch (status) {\n            case 400:\n                return \"NO-ADMIN\" ;\n            default:\n                return \"ERROR\"\n        }\n    }\n};\n\n/*API to change reviews status*/\nexport const ApiChangeStatus = async (user_email, review_id, status) => {\n\n    try{\n        const res = await axios.post(\"/api/admin/change_status\", null, {params: {user_email, review_id, status}});\n        return res.data;\n    } catch (e) {\n\n        throw e;\n    }\n}\n\n/*API to universities list*/\nexport const ApiUniversitiesList = async () => {\n    try {\n        const res = await axios.get(\"/api/universities_list\");\n        return res.data;\n    } catch (e) {\n        throw e;\n    }\n};\n\n/*API to change logged user password */\nexport const ApiChangePasswordResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiChangePassword = async (data) => {\n    return axios\n        .post(\"/api/change_password\", data)\n        .then(() => ({ res: ApiChangePasswordResponse.OK }))\n        .catch(() => ({\n            res: ApiChangePasswordResponse.FAILED,\n        }));\n};\n\n/*API to download user's data*/\nexport const ApiDownloadUserDataResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiDownloadUserData = async () => {\n    return axios\n        .get(\"/api/download_user_data\")\n        .then((res) => ({\n            res: ApiDownloadUserDataResponse.OK,\n            data: res.data,\n        }))\n        .catch(() => ({ res: ApiDownloadUserDataResponse.FAILED, data: null }));\n};\n\n/* API to delete user */\nexport const ApiDeleteUserResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiDeleteUser = async () => {\n    return axios\n        .get(\"/api/eliminate_user\")\n        .then(() => ({\n            res: ApiDeleteUserResponse.OK,\n        }))\n        .catch(() => ({\n            res: ApiDeleteUserResponse.FAILED,\n        }));\n};\n\nexport const ApiForgotPasswordResponse = new ApiResponse(\"OK\", \"FAILED\", \"MISSING_USER\", \"REQUIRES_CONFIRM\");\nexport const ApiForgotPassword = async (data) => {\n    return axios\n        .post(\"/api/forgot_password\", data)\n        .then(() => ({\n            res: ApiForgotPasswordResponse.OK,\n        }))\n        .catch((err) => {\n            const { status } = err.response;\n            switch (status) {\n                case 400:\n                    return { res: ApiLoginResponse.FAILED };\n                case 409:\n                    return { res: ApiLoginResponse.MISSING_USER };\n                case 303:\n                    return { res: ApiLoginResponse.REQUIRES_CONFIRM };\n                default:\n                    return { res: ApiLoginResponse.FAILED };\n            }\n        });\n};\n\nexport const ApiResetPasswordResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiResetPassword = async (data) => {\n    return axios\n        .post(\"/api/reset_password\", data)\n        .then(() => ({\n            res: ApiForgotPasswordResponse.OK,\n        }))\n        .catch(() => ({\n            res: ApiResetPasswordResponse.FAILED,\n        }));\n};\n\nexport default {\n    ApiProfessor,\n    ApiMail,\n    ApiRegister,\n    ApiLogin,\n    ApiLogout,\n    ApiUniversitiesList,\n    ApiDownloadUserData,\n    ApiDeleteUser,\n    ApiForgotPassword,\n    ApiResetPassword,\n    ApiUserReviews,\n    ApiAdminReviews,\n    ApiChangeStatus,\n};\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useMediaQuery.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",["377","378","379"],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useSignUp.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useSignUpForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Forms/FormCheckbox.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useForgotPassword.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useForgotPasswordForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useFormField.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserStats.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserReview.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/CardContainer.js",["380"],"import React, {useState} from 'react';\nimport Card from \"../../Cards/Card\";\nimport styles from './CardsContainer.module.css'\n\nconst CardContainer = (props) => {\n    const {selected, onChangeSelected} = props;\n    //const titles = [\"Cambio password\", \"Modifica dati personali\", \"Elimina account\", \"Scarica dati\", \"Contattaci\"];\n    const titles = [\"Cambio password\", \"Elimina account\", \"Scarica dati\"];\n    /*const texts = [\"Clicca qui per cambiare la tua password.\", \"Clicca qui per modificare i tuoi dati.\",\n        \"Clicca qui per eliminare il tuo account. Attenzione, l'azione non è reversibile.\", \"Clicca qui per poter scaricare tutti i dati salvati sul sito.\",\n        \"Hai delle segnalazioni da fare? Clicca qui per contattarci.\"]\n     */\n    const texts = [\"Clicca qui per cambiare la tua password.\",\n        \"Clicca qui per eliminare il tuo account. Attenzione, l'azione non è reversibile.\", \"Clicca qui per poter scaricare tutti i dati salvati sul sito.\"]\n\n\n    return (\n        <>\n            <div className={styles.container}>\n                {titles.map((title, i) =>\n                    selected === title ? <Card title={title} text={texts[i]} isSelected={true} onChangeSelected={onChangeSelected}/>\n                        : <Card title={title} text={texts[i]} isSelected={false} onChangeSelected={onChangeSelected}/> )}\n            </div>\n        </>\n    );\n}\n\nexport default CardContainer;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/SettingForm.js",["381"],"import React from \"react\";\nimport { ChangePswForm, Delete, Modify } from \"./index\";\nimport styles from \"./Settings.module.css\";\nimport Download from \"./Forms/Download\";\n\nconst SettingForm = (props) => {\n    const { selected } = props;\n    let form;\n    // let txtButton;\n\n    switch (selected) {\n        case \"Cambio password\":\n            form = <ChangePswForm />;\n            // txtButton = \"Invia\";\n            break;\n        /*case \"Modifica dati personali\":\n            form = <Modify />;\n            // txtButton = \"Invia\";\n            break;*/\n        case \"Elimina account\":\n            form = <Delete />;\n            // txtButton = \"Elimina\";\n            break;\n        case \"Scarica dati\":\n            form = <Download />;\n            // txtButton = \"Download\";\n            break;\n        /*case \"Contattaci\":\n            form = <div>Contattaci</div>;\n            break;*/\n        default:\n            return <div />;\n    }\n    return (\n        <>\n            <div className={styles.section}>\n                <h2 className={styles.title}>{selected}</h2>\n                {form}\n                {/* <div style={{maxWidth:\"30%\"}}>\n                    <Button buttonStyle=\"btn--outline\" type=\"submit\" >\n                        <h6 style={{ color: \"white\" }}>{txtButton}</h6>\n                    </Button>\n                </div> */}\n            </div>\n        </>\n    );\n};\n\nexport default SettingForm;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReviews.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/ResetPassword/useResetPasswordForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useResetPassword.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewFormSection.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/AddReview/useAddReviewForm.js",["382"],"import useFormField, { formToSubmittable, isFormValid } from \"../../../hooks/useFormField\";\n\nconst currentDate = () => {\n    const now = new Date();\n    return (\n        [now.getFullYear(), now.getMonth() + 1, now.getDate()].join(\"-\") +\n        \" \" +\n        [now.getHours(), now.getMinutes(), now.getSeconds()].join(\":\")\n    );\n};\n\nexport default function useAddReviewForm(professorId, userEmail, onSubmit) {\n    // questi due valori si auto settano usando come initial value i valori di argomenti passati all'hook\n    const professor_id = useFormField(\"professor_id\", null, null, professorId);\n    const user_email = useFormField(\"user_email\", null, null, userEmail);\n    \n    const corso_id = useFormField(\"corso_id\", null, \"Seleziona un corso\", null, (value) => value !== null);\n    \n    const titolo = useFormField(\"titolo\", \"Titolo della recensione\", \"Il campo non può essere vuoto\", \"\", (value) => value?.length > 0);\n    const corpo = useFormField(\"corpo\", \"Testo della recensione\", \"Il campo non può essere vuoto\", \"\", (value) => value?.length > 0);\n\n    // const data_creazione = useFormField(\"data_creazione\", \"Data recensione\", \"\", currentDate());\n    const anno_accademico = useFormField(\"anno_accademico\", \"Anno accademico\", \"Seleziona un anno accademico\", \"\", (value) => value.length > 0);\n    const voto = useFormField(\"voto\", \"Voto esame\", \"Inserisci un voto valido\", \"0\", (value) => parseInt(value) > 0 && parseInt(value) <= 30);\n    const anonimo = useFormField(\"anonimo\", \"Resta anonimo\", \"\", false);\n\n    const chiarezza_spiegazione_prof = useFormField(\"chiarezza_spiegazione_prof\", \"Chiarezza spiegazioni\", \"Imposta un valore\", 0, (value) => value > 0);\n    const materiale_didattico_prof = useFormField(\"materiale_didattico_prof\", \"Materiale didattico\", \"Imposta un valore\", 0, (value) => value > 0);\n    const correzione_compiti_prof = useFormField(\"correzione_compiti_prof\", \"Correzione compiti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const disponibilita_prof = useFormField(\"disponibilita_prof\", \"Disponibilità\", \"Imposta un valore\", 0, (value) => value > 0);\n\n    const difficolta_argomenti_corso = useFormField(\"difficolta_argomenti_corso\", \"Difficoltà argomenti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const difficolta_esame_corso = useFormField(\"difficolta_esame_corso\", \"Difficoltà esami\", \"Imposta un valore\", 0, (value) => value > 0);\n    const interesse_argomenti_corso = useFormField(\"interesse_argomenti_corso\", \"Interesse argomenti\", \"Imposta un valore\", 0, (value) => value > 0);\n    const lo_consiglieresti_corso = useFormField(\"lo_consiglieresti_corso\", \"Lo consiglieresti\", \"Imposta un valore\", 0, (value) => value > 0);\n\n\n    const form = {\n        corso_id,\n        professor_id,\n        user_email,\n        titolo,\n        corpo,\n        anno_accademico,\n        voto,\n        anonimo,\n        chiarezza_spiegazione_prof,\n        materiale_didattico_prof,\n        correzione_compiti_prof,\n        disponibilita_prof,\n        difficolta_argomenti_corso,\n        difficolta_esame_corso,\n        interesse_argomenti_corso,\n        lo_consiglieresti_corso,\n    };\n\n    const submit = async (e) => {\n        if (e) e.preventDefault();\n\n        if (isFormValid(form)) onSubmit(formToSubmittable(form));\n    };\n\n    return [form, submit];\n}\n\n/**\n# form hook\n\n```ts\n// component.js\nconst form = useComponentForm();\n```\n\n```ts\n// useComponentForm.js\nconst form: IForm;\n\ninterface IForm {\n    [apiID: string]: {\n        key: apiID;\n        label: string;\n        value: any;\n        setValue: React.Dispatch<React.SetStateAction<any>>;\n        validate: (any) => boolean;\n        error: boolean;\n        setError: React.Dispatch<React.SetStateAction<boolean>>;\n        type?: FormType;\n    };\n}\n\nenum FormType {\n    TextField,\n    Radio,\n    Rating,\n}\n```\n\nhandleSubmit dentro hook ed esportato tipo questo\n\n```ts\nconst submit = () => {\n    for (const key in form) {\n        if (Object.hasOwnProperty.call(form, key)) {\n            const item = form[key];\n            if (item.validate(item.value))\n                // ...do something\n            else\n                // ...something else\n        }\n    }\n};\n```\n\nse tutti gli elementi vanno bene, chiama l'api endpoint, altrimenti errore?\n */\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useAddProfessorReview.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/api/ApiResponse.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useAdminReviews.js",["383","384"],"import { useEffect, useState } from \"react\";\nimport {ApiAdminReviews, ApiReviews, ApiUserReviews} from \"../api\";\n\nconst useAdminReviews = (email, num = 1) => {\n    const [reviews, setReviews] = useState([]);\n\n    useEffect(() => {\n        ApiAdminReviews(email, num).then((data) => setReviews(data));\n    }, [email, num]);\n\n    return reviews;\n};\n\nexport default useAdminReviews;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Forms/FormRating.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Forms/FormRadio.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/hoc/withAuth.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Popup/Popup.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Text/ExpandableParagraph.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/progress/ProgressBar.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useUserReviews.js",["385"],"import { useEffect, useState } from \"react\";\nimport {ApiReviews, ApiUserReviews} from \"../api\";\n\nconst useUserReviews = (email, num = 1) => {\n    const [reviews, setReviews] = useState([]);\n\n    useEffect(() => {\n        ApiUserReviews(email, num).then((data) => setReviews(data));\n    }, [email, num]);\n\n    return reviews;\n};\n\nexport default useUserReviews;\n","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/index.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useProfessorReviews.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/Cards/Card.js",["386"],"import React, {useState} from 'react';\nimport styles from \"./Card.module.css\";\n\nconst Card = (props) => {\n\n    const {isSelected, title, text, onChangeSelected} = props;\n\n\n    let card = (\n        <>\n            <div className={styles.title}>\n                {title}\n            </div>\n            <div className={styles.text}>\n                {text}\n            </div>\n        </>\n    );\n\n    return (\n        <>\n            {isSelected ?\n                <div className={styles.cardActive}>\n                    {card}\n                </div>\n\n                :\n\n                <div className={styles.card} onClick={() => {\n                    onChangeSelected(title)\n                }}>\n                    {card}\n                </div>}\n\n        </>\n    );\n}\n\nexport default Card;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Download.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Delete.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/Modify.js",["387"],"import React from 'react';\nimport FormTextField from \"../../../Forms/FormTextField\";\nimport useModifyForm from \"./useModifyForm\";\nimport styles from '../Settings.module.css';\nimport {Button} from \"../../../Buttons/Button\";\n\nconst Modify = (props) => {\n\n    let name = \"\";\n    const [form, submit] = useModifyForm(name);\n    return (\n        <>\n\n            <div className={styles.formContainer}>\n                <form className={styles.form} onSubmit={submit}>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.name} variant=\"outlined\" />\n                    </div>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.lastName} variant=\"outlined\" />\n                    </div>\n                    <div className={styles.formInput}>\n                        <FormTextField field={form.email} variant=\"outlined\" type=\"email\"  />\n                    </div>\n                </form>\n\n            </div>\n        </>\n    );\n}\n\nexport default Modify;","/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/ChangePswForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/hooks/useDownloadUserData.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useDeleteForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useModifyForm.js",[],"/home/davide/Documenti/github/unihub/uniadvisor-frontend/src/components/PagesSections/Settings/Forms/useChangePswForm.js",[],{"ruleId":"388","replacedBy":"389"},{"ruleId":"390","replacedBy":"391"},{"ruleId":"392","severity":1,"message":"393","line":49,"column":9,"nodeType":"394","endLine":49,"endColumn":132,"suggestions":"395"},{"ruleId":"392","severity":1,"m