":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"108","messages":"109","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"110","usedDeprecatedRules":"62"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"115","usedDeprecatedRules":"62"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"118","usedDeprecatedRules":"62"},{"filePath":"119","messages":"120","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"121","usedDeprecatedRules":"62"},{"filePath":"122","messages":"123","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"124","usedDeprecatedRules":"62"},{"filePath":"125","messages":"126","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"127","messages":"128","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"129","usedDeprecatedRules":"62"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["130","131"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",["132","133"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["134","135","136","137","138"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport Popup from \"../Popup/Popup\";\nimport {ApiMail} from \"../../api\";\n\nconst Navbar = () => {\n\n    const [email, setEmail] = useState();\n    const [loading, setLoading] = useState (false); //loading è fondamentale per l'invio delle informazioni dal popup\n\n    const TitlePopup = (props) => {\n        const {titleText, onClose} = props;\n        return (\n            <div className={'title-popup'}>\n                <div className={'title-text'}>{titleText}</div>\n                <div className={'close-button'} onClick={onClose}>X</div>\n            </div>\n        )\n    }\n\n    const [isOpenLoginForm, setOpenLoginForm] = React.useState(false);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n    const sendMail = async (email) => {\n        setLoading(true);\n        try {\n            await ApiMail(email);\n        } catch (e) {\n            throw e;\n        }\n        setLoading(false);\n    };\n\n    const handleSubmit = (e) => {\n        e.preventDefault();\n        //console.log(\"la userMail è\" + email);\n        sendMail(email);\n    }\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                <Link to='/login' className=\"navbar-title\">\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                </div>\n                </Link>\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/Footer.js",["139"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["140"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["141"],"import {useEffect, useState} from 'react';\nimport {ApiProfessor} from \"../api\";\n\nconst useProfessor = (endpoint) => {\n    const [state, setState] = useState();\n    const [isLoading, setLoading] = useState(true);\n    useEffect(() => {\n        setProfessor();\n    }, [endpoint]);\n\n    const setProfessor = async () => {\n        setLoading(true);\n        const professorEndpoint = endpoint ? endpoint : undefined\n        if (professorEndpoint != null) {\n            const selectedProfessor = await ApiProfessor(professorEndpoint);\n            setState(selectedProfessor);\n            setLoading(false);\n        }\n\n    };\n    return [state, isLoading, setProfessor];\n};\n\nexport default useProfessor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/Review.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["142","143","144","145"],"import axios from \"axios\";\n\nexport const ApiProfessor = async (professorEndpoint) => {\n    try{\n        const res = await axios.get(\"/api/professors/\"+professorEndpoint);\n        return res.data;\n    } catch (e){\n        throw e;\n    }\n\n};\nexport const ApiMail = async (email) => {\n    try{\n        const res = await axios.post(\"/api/email\", {email})\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        //return res.data;\n    } catch (e) {\n        throw e;\n    }\n\n};\n\nexport const ApiRegister = async (name, surname, email, password, university) =>{\n    try{\n        const res = await axios.post(\"/api/register\", {name, surname, email, password, university})\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        //return res.data;\n    } catch (e) {\n        throw e;\n    }\n}\n\nexport const ApiLogin = async (email, password) => {\n    try{\n        const res = await axios.post(\"/api/login\", {email, password}, { withCredentials: true })/*withCredentials: true è per i cookies*/\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        //return res.data;\n    } catch (e) {\n        throw e;\n    }\n}\n\nexport default {ApiProfessor, ApiMail, ApiRegister};","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",["146","147","148"],"import React, {useState} from 'react';\nimport Navbar from \"../components/Navbar/Navbar\";\nimport LoginForm from \"../components/PagesSections/Login-SignUp/LoginForm\";\n\n\nconst Login = () => {\n    const [user, setUser] = useState({name: \"\", email: \"\"});\n    const [error, setError] = useState(\"\");\n\n    const login = details => {\n        console.log(details);\n    }\n\n    const Logout = () => {\n        console.log(\"logout\");\n    }\n\n    return (\n        <>\n            <Navbar/>\n            {user.email !== \"\" ? (\n                <>\n                <div>Welcome</div>\n                <button>LOGOUT</button>\n                </>\n            ) : (<LoginForm login={login} error={error}/>)}\n        </>\n    );\n}\n\nexport default Login;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["149","150","151","152"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport './Login.css'\nimport {Button} from \"../../Buttons/Button\";\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\nimport Checkbox from \"@material-ui/core/Checkbox\";\nimport {Link} from \"react-router-dom\";\n\nconst LoginForm = (props) => {\n\n    const [details, setDetails] = useState({name: \"\", email: \"\", password: \"\"});\n    const {login, error} = props\n\n    return (\n        <>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\">\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Username\"\n                        placeholder=\"Inserisci il tuo username\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required\n                    />\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Password\"\n                        placeholder=\"Inserisci la tua password\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required\n                    />\n                    <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6></Button>\n                    <FormControlLabel\n                        value=\"ricordami\"\n                        control={<Checkbox color=\"primary\" />}\n                        label=\"Ricordami\"\n                        labelPlacement=\"end\"\n                    />\n                    <div>Se non sei ancora registrato clicca\n                        <Link to='/sign-up'> qui </Link>\n                    </div>\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default LoginForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",["153","154"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\n\nconst SignUpForm = () => {\n    const [name, setName] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [email, setEmail] = useState('');\n    const [password, setPassword] = useState('');\n    const [university, setUniversity] = useState('');\n    const [loading, setLoading] = useState('');\n    const [done, setDone] = useState(false);\n    const [error, setError] = useState(false);\n\n    /*const nameValidation = (fieldName, fieldValue) => {\n        if (fieldValue.trim() === '') {\n            return `${fieldName} is required`;\n        }\n        if (/[^a-zA-Z -]/.test(fieldValue)) {\n            return 'Invalid characters';\n        }\n        if (fieldValue.trim().length < 3) {\n            return `${fieldName} needs to be at least three characters`;\n        }\n        return null;\n    };\n\n    const emailValidation = (email) => {\n        if (\n            /^[a-zA-Z0-9.!#$%&’*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/.test(\n                email,\n            )\n        ) {\n            return null;\n        }\n        if (email.trim() === '') {\n            return 'Email is required';\n        }\n        return 'Please enter a valid email';\n    };\n\n    const validate = (name, email, university, password) => {\n        nameValidation('Name', name);\n        emailValidation(email);\n    };*/\n\n    const submit = async (e) => {\n        e.preventDefault();\n        setLoading(true);\n        if (name !== '') {\n            try {\n                await ApiRegister(name, lastname, email, password, university);\n            } catch (e) {\n                throw e;\n            }\n            setLoading(false);\n            setDone(true);\n        }\n        else {\n            setError(true);\n        }\n    }\n\n\n\n    return (\n        <>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Nome\"\n                        placeholder=\"Inserisci il tuo nome\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required=\"true\"\n                        onChange={e => setName(e.target.value)}\n                    />\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Cognome\"\n                        placeholder=\"Inserisci il tuo cognome\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required=\"true\"\n                        onChange={e => setLastname(e.target.value)}\n                    />\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Email\"\n                        placeholder=\"Inserisci la tua email\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required=\"true\"\n                        onChange={e => setEmail(e.target.value)}\n                    />\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Università\"\n                        placeholder=\"Inserisci la tua università\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required=\"true\"\n                        onChange={e => setPassword(e.target.value)}\n                    />\n                    <TextField\n                        id=\"outlined-textarea\"\n                        label=\"Password\"\n                        placeholder=\"Inserisci la tua password\"\n                        multiline\n                        variant=\"outlined\"\n                        aria-required=\"true\"\n                        onChange={e => setPassword(e.target.value)}\n                    />\n\n                    <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Registrati</h6></Button>\n                    {done ? <Redirect to=\"/login\" /> : (error ? \"errore\" : null)} {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar-bk.js",["155"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport Popup from \"../Popup/Popup\";\nimport {ApiMail} from \"../../api\";\n\nconst Navbar = () => {\n\n    const [email, setEmail] = useState();\n    const [loading, setLoading] = useState (false); //loading è fondamentale per l'invio delle informazioni dal popup\n\n    const TitlePopup = (props) => {\n        const {titleText, onClose} = props;\n        return (\n            <div className={'title-popup'}>\n                <div className={'title-text'}>{titleText}</div>\n                <div className={'close-button'} onClick={onClose}>X</div>\n            </div>\n        )\n    }\n\n    const [isOpenLoginForm, setOpenLoginForm] = React.useState(false);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n    const sendMail = async (email) => {\n        setLoading(true);\n        try {\n            await ApiMail(email);\n        } catch (e) {\n            throw e;\n        }\n        setLoading(false);\n    };\n\n    const handleSubmit = (e) => {\n        e.preventDefault();\n        //console.log(\"la userMail è\" + email);\n        sendMail(email);\n    }\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm && <Popup onSubmit={handleSubmit}>\n                        <div className={'form-content'}>\n                            <TitlePopup titleText={'Siamo spiacenti!'} onClose={handleOpenLoginForm}/>\n                            <p>Il sito è in fase di manutenzione e questa funzione non è al momento disponibile.</p>\n                            <p>Ti chiediamo di lasciarci la mail in modo da poterti avvisare quando è pronto</p>\n                            <input\n                                className={\"form-input\"}\n                                placeholder=\"Mail\"\n                                onChange={e => setEmail(e.target.value)}\n                                required\n                                value={email}\n                            />\n                            <div className={'form-buttons'}>\n                                <button className={'send-button'} onClick={handleSubmit}>Invia</button>\n                            </div>\n                        </div>\n                    </Popup>}\n                </div>\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/FacebookLogin.js",["156","157"],"import React, {useState} from 'react';\nimport FacebookLoginBtn from 'react-facebook-login'\nimport {Redirect, Route} from \"react-router\";\nimport Dashboard from \"../Dashboard/Dashboard\";\nimport {BrowserRouter as Router, Switch} from \"react-router-dom\";\n\nconst FacebookLogin = () => {\n    const [state, setState] = useState({auth: false, name: '', email: '', picture: ''});\n    const [loading, setLoading] = useState(true);\n\n    const componentClicked = () => {\n        console.log('Facebook btn click');\n    }\n\n    const responseFacebook = async (response) => {\n        console.log(response);\n        setLoading(true);\n        setState({auth: true, name: response.name, email: response.email, picture: response.picture.data.url});\n\n        setLoading(false);\n\n    }\n\n    let facebookData;\n    state.name!=='' ? facebookData = (\n        <Router>\n            <Switch>\n            <Route path='/dashboard' exact component={() => <Dashboard name={\"Piero\"} />} />\n            </Switch>\n        </Router>\n\n    ) : facebookData = (\n        <React.Fragment>\n        <FacebookLoginBtn\n            appId=\"207812577218371\"\n            autoLoad={false}\n            fields=\"name, email, picture\"\n            onClick={componentClicked}\n            callback={responseFacebook}\n        />\n        </React.Fragment>\n    )\n\n    return (\n        <>\n            {facebookData}\n        </>\n    );\n}\n\nexport default FacebookLogin;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/Dashboard.js",["158","159"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/NavSearchBar.js",["160","161","162"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport Popup from \"../Popup/Popup\";\nimport {ApiMail} from \"../../api\";\nimport SearchBar from \"../SearchBar/SearchBar\";\n\nconst NavSearchBar = (props) => {\n    const {professorList, onChangeProfessor} = props;\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                <SearchBar professorList={professorList} onChangeProfessor={onChangeProfessor} isHome={false}/>\n                <Link to='/login' className=\"navbar-title\">\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                </div>\n                </Link>\n            </div>\n        </>\n    );\n\n}\n\nexport default NavSearchBar;\n\n",{"ruleId":"163","replacedBy":"164"},{"ruleId":"165","replacedBy":"166"},{"ruleId":"167","severity":1,"message":"168","line":21,"column":12,"nodeType":"169","messageId":"170","endLine":21,"endColumn":16},{"ruleId":"167","severity":1,"message":"171","line":21,"column":18,"nodeType":"169","messageId":"170","endLine":21,"endColumn":25},{"ruleId":"167","severity":1,"message":"172","line":7,"column":8,"nodeType":"169","messageId":"170","endLine":7,"endColumn":13},{"ruleId":"167","severity":1,"message":"173","line":12,"column":19,"nodeType":"169","messageId":"170","endLine":12,"endColumn":27},{"ruleId":"167","severity":1,"message":"174","line":13,"column":12,"nodeType":"169","messageId":"170","endLine":13,"endColumn":19},{"ruleId":"167","severity":1,"message":"175","line":15,"column":11,"nodeType":"169","messageId":"170","endLine":15,"endColumn":21},{"ruleId":"167","severity":1,"message":"176","line":40,"column":11,"nodeType":"169","messageId":"170","endLine":40,"endColumn":23},{"ruleId":"177","severity":1,"message":"178","line":10,"column":21,"nodeType":"179","endLine":10,"endColumn":119},{"ruleId":"167","severity":1,"message":"180","line":9,"column":8,"nodeType":"169","messageId":"170","endLine":9,"endColumn":17},{"ruleId":"181","severity":1,"message":"182","line":9,"column":8,"nodeType":"183","endLine":9,"endColumn":18,"suggestions":"184"},{"ruleId":"167","severity":1,"message":"185","line":14,"column":15,"nodeType":"169","messageId":"170","endLine":14,"endColumn":18},{"ruleId":"167","severity":1,"message":"185","line":31,"column":15,"nodeType":"169","messageId":"170","endLine":31,"endColumn":18},{"ruleId":"167","severity":1,"message":"185","line":47,"column":15,"nodeType":"169","messageId":"170","endLine":47,"endColumn":18},{"ruleId":"186","severity":1,"message":"187","line":61,"column":1,"nodeType":"188","endLine":61,"endColumn":53},{"ruleId":"167","severity":1,"message":"189","line":7,"column":18,"nodeType":"169","messa