fig":"31"},{"size":812,"mtime":1607605297000,"results":"43","hashOfConfig":"31"},{"size":1190,"mtime":1615763168165,"results":"44","hashOfConfig":"31"},{"size":2279,"mtime":1615563949215,"results":"45","hashOfConfig":"31"},{"size":1257,"mtime":1613399871535,"results":"46","hashOfConfig":"31"},{"size":996,"mtime":1611879860586,"results":"47","hashOfConfig":"31"},{"size":2271,"mtime":1617120267336,"results":"48","hashOfConfig":"31"},{"size":665,"mtime":1609107864000,"results":"49","hashOfConfig":"31"},{"size":971,"mtime":1617124109423,"results":"50","hashOfConfig":"31"},{"size":801,"mtime":1617113553639,"results":"51","hashOfConfig":"31"},{"size":3965,"mtime":1617124530782,"results":"52","hashOfConfig":"31"},{"size":8805,"mtime":1617124530794,"results":"53","hashOfConfig":"31"},{"size":1196,"mtime":1617124384811,"results":"54","hashOfConfig":"31"},{"size":795,"mtime":1617123657660,"results":"55","hashOfConfig":"31"},{"size":962,"mtime":1611091451993,"results":"56","hashOfConfig":"31"},{"size":5551,"mtime":1617113553767,"results":"57","hashOfConfig":"31"},{"size":5848,"mtime":1617113553787,"results":"58","hashOfConfig":"31"},{"size":3974,"mtime":1617113553811,"results":"59","hashOfConfig":"31"},{"filePath":"60","messages":"61","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},"xgbou9",{"filePath":"63","messages":"64","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"65","usedDeprecatedRules":"62"},{"filePath":"66","messages":"67","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"68","messages":"69","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"70","messages":"71","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"72","usedDeprecatedRules":"62"},{"filePath":"73","messages":"74","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"75","messages":"76","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"77","messages":"78","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"79","usedDeprecatedRules":"62"},{"filePath":"80","messages":"81","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"82","usedDeprecatedRules":"62"},{"filePath":"83","messages":"84","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"85","usedDeprecatedRules":"62"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"88"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"103","usedDeprecatedRules":"62"},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"113","usedDeprecatedRules":"62"},{"filePath":"114","messages":"115","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"120","usedDeprecatedRules":"62"},{"filePath":"121","messages":"122","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"123","usedDeprecatedRules":"62"},{"filePath":"124","messages":"125","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"126","usedDeprecatedRules":"62"},{"filePath":"127","messages":"128","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"129","messages":"130","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["131","132"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",["133"],"\nimport React, {useEffect, useState} from 'react'\nimport './App.css';\nimport {BrowserRouter as Router, Switch, Route} from \"react-router-dom\";\nimport professorList from './json/professorsList.json'\nimport ReactGA from 'react-ga';\n//Pages\nimport Home from './pages/Home.js'\nimport Professor from \"./pages/Professor\";\nimport Login from \"./pages/Login\";\nimport SignUp from \"./pages/SignUp\";\nimport Dashboard from \"./pages/Dashboard\";\nimport Footer from \"./components/Footer/Footer\";\nimport {Redirect} from \"react-router\";\nimport {ApiLogin} from \"./api\";\n\nconst getCookie = (cname) => {\n    let name = cname + \"=\";\n    let decodedCookie = decodeURIComponent(document.cookie);\n    let ca = decodedCookie.split(';');\n    for(let i = 0; i <ca.length; i++) {\n        let c = ca[i];\n        while (c.charAt(0) === ' ') {\n            c = c.substring(1);\n        }\n        if (c.indexOf(name) === 0) {\n            return c.substring(name.length, c.length);\n        }\n    }\n    return \"\";\n}\n\nconst setCookie = (cname, cvalue, exdays) => {\n    let d = new Date();\n    d.setTime(d.getTime() + (exdays*24*60*60*1000));\n    let expires = \"expires=\"+ d.toUTCString();\n    document.cookie = cname + \"=\" + cvalue + \";\" + expires + \";path=/\";\n}\n\n/* funzione per eliminare cookies\ndocument.cookie = \"session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\n*/\n\nfunction App() {\n    useEffect(() => {\n        ReactGA.initialize('UA-185661222-1 ');\n        //to report page view\n        ReactGA.pageview(window.location.pathname + window.location.search);\n        readCookie();\n    }, [])\n\n    const [user, setUser] = useState(null);\n\n    // getCookie(\"session\") === \"\" ? setUser(null) : ApiLogin(\"davide.lista.polimi@gmail.com\", \"prova\"); /*Api speficia per i cookies*/\n\n    if(user !== null) {\n        setCookie(\"session\", user, 7);\n        console.log(getCookie(\"session\"));\n    }\n\n    const readCookie = () => {\n        getCookie(\"session\");\n    }\n\n    return (\n        <Router>\n            <Switch>\n                <Route exact path='/' component={() => <Home professorList={professorList} user={user} isHome={true} />}/>\n                <Route exact path=\"/professors/:endpoint\" component={() => <Professor professorList={professorList}  user={user} isHome={false}/>} />\n                <Route exact path=\"/dashboard\" component={() => <Dashboard professorList={professorList} user={user} isHome={false}/>}/>\n                <Route exact path=\"/login\" component={() => <Login professorList={professorList} onChangeUser={setUser} isHome={false}/>} />\n                <Route exact path=\"/sign-up\" component={() => <SignUp professorList={professorList} onChangeUser={setUser} isHome={false}/>} />\n                <Route render={() => <Redirect to={{pathname: \"/\"}} />} />\n            </Switch>\n            <Footer/>\n        </Router>\n\n    );\n}\n\nexport default App;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["134"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport SearchBar from \"../SearchBar/SearchBar\";\n\nconst Navbar = (props) => {\n\n    const {professorList, user, isHome} = props;\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n\n    let button;\n    user === null ? button = (\n            <Link to='/login' className=\"navbar-title\">\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n            </Link>\n        )\n        : button = (<Link to='/dashboard'><div>{user}</div></Link>)\n\n    let search;\n    isHome === false ? search=(<SearchBar professorList={professorList} isHome={isHome}/>) : search=(<div></div>)\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                {search}\n                {/* LOGIN POPUP\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm &&\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\n                        <Login onChangeUser={onChangeUser}/>\n                    </Popup>}\n                </div>*/}\n                {button}\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["135"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["136"],"import {useEffect, useState} from 'react';\nimport {ApiProfessor, ApiProfessorImage} from \"../api\";\n\nconst useProfessor = (endpoint) => {\n    const [state, setState] = useState();\n    const [professorImg, setProfessorImg] = useState();\n    const [isLoading, setLoading] = useState(true);\n    useEffect(() => {\n        setProfessor();\n    }, [endpoint]);\n\n    const setProfessor = async () => {\n        setLoading(true);\n        const professorEndpoint = endpoint ? endpoint : undefined\n        if (professorEndpoint != null) {\n            const selectedProfessor = await ApiProfessor(professorEndpoint);\n            if(selectedProfessor === \"No professor\"){\n                setState(null);\n            } else {\n                const imgProfessor = await ApiProfessorImage(professorEndpoint);\n                setState(selectedProfessor);\n                setProfessorImg(imgProfessor);\n                setLoading(false);\n            }\n        }\n\n    };\n    return [state, professorImg, isLoading, setProfessor];\n};\n\nexport default useProfessor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["137"],"import React, {useState} from 'react';\nimport Navbar from \"../../Navbar/Navbar\";\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport ProfessorReview from \"./ProfessorReview\";\nimport {Button} from \"../../Buttons/Button\";\n/*ICONS*/\nimport EmailIcon from '@material-ui/icons/Email';\nimport WorkIcon from '@material-ui/icons/Work';\nimport AccountBalanceIcon from '@material-ui/icons/AccountBalance';\nimport BusinessIcon from '@material-ui/icons/Business';\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\n\nfunction ProfessorDetails(props) {\n    const {professor, professorImg} = props;\n    const [courseId, setCouseId] = useState(1);\n\n    let image;\n    professorImg === \"Image Not Found\" ? image = (<img src={imgUser} className={\"professor-img\"} alt={imgUser}/>) : image = (<img src={professorImg} className={\"professor-img\"} alt={professorImg}/>)\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                {image}\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>{professor.name}</h1>\n                        {professor.finalEvaluation.filter(x => x.title === \"Overall\")\n                            .map((x) => {\n                                return (\n                                    <div className={\"bubble-rating\"}>\n                                    <Rating name=\"half-rating-read\"\n                                            defaultValue={x.value}\n                                            precision={0.5}\n                                            readOnly\n                                            emptyIcon={<FiberManualRecordOutlinedIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                            icon={<FiberManualRecordIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                    />\n                                    </div>\n                                )\n                            })}\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><AccountBalanceIcon fontSize=\"small\" style={{fill: \"#e53a1e\", marginRight: \"3%\"}}/><h3 style={{color: \"#e53a1e\"}}>{x.name}</h3></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><EmailIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{professor.email}</p></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><WorkIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.typeContract}</p> </div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><BusinessIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.department}</p> </div>\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.finalEvaluation}/>\n                    </div>\n                </div>\n            </div>\n\n            <div className={\"professor-title-courses\"}>\n                {professor.university.map((university) => {\n                        return university.courses.map((course) => {\n                            return ( <>\n                                {courseId === course.id ?\n                                <h4 className={\"course-title-button\"} onClick={() => {\n                                    setCouseId(course.id)\n                                }} style={{color: \"#e53a1e\"}}> {course.name}</h4> : <h4 className={\"course-title-button\"} onClick={() => {\n                                        setCouseId(course.id)\n                                    }} style={{color: \"#c9c9c9\"}}> {course.name}</h4>} </>\n                            )\n\n                        } )\n                    }\n                )}\n            </div>\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <div className={\"course-info-section\"}>\n                                        {courseId === course.id ? <ProfessorCourse course={course}/> : null}\n                                    </div>\n                                )\n                            })\n                        }\n                    )}\n                </div>\n            </div>\n\n            <div className={\"reviews-section\"}>\n                <div className={\"reviews-section-title\"}>\n                    <h2>Leggi le recensioni</h2>\n                    <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Scrivi una recensione</h6></Button>\n                </div>\n                <>\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <>\n                                        {courseId === course.id && course.reviews.length !== 0 ?\n                                            <ProfessorReview review={course.reviews}/> : null}\n                                    </>\n                                )\n                            })\n                        }\n                    )}\n                </>\n                <div className={\"reviews-section-title\"}>\n                    <h3>Vecchie recensioni</h3>\n                </div>\n                <>\n                    {professor.oldReview.map((x) => {\n                        return <ProfessorReview review={x} oldReview={true}/>\n                    })}\n                </>\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorDetails;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],["138","139"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["140","141"],"import axios from \"axios\";\n\n/*API to request professor detail*/\nexport const ApiProfessor = async (professorEndpoint) => {\n    try{\n        const res = await axios.get(\"/api/professors/\"+professorEndpoint);\n        return res.data;\n    } catch (e){\n        switch (e.message){\n            case \"Request failed with status code 400\":\n                return \"No professor\";\n            default:\n                break;\n        }\n        throw e;\n    }\n};\n\n/*API to request professor image*/\nexport const ApiProfessorImage = async (professorEndpoint) => {\n    try{\n        const img = await axios.get(\"/api/professor_image/\" + professorEndpoint)\n        return img;\n    } catch (e){\n        switch (e.message){\n            case \"Request failed with status code 404\":\n                return \"Image Not Found\";\n            default:\n                break;\n        }\n        throw e;\n    }\n};\n\n/*API to register new users*/\nexport const ApiRegister = async (name, surname, email, password, university, type, externalId) =>{\n    try{\n        const res = await axios.post(\"/api/register\", {name, surname, email, password, university});\n        console.log(JSON.stringify(res));\n        return res;\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 400\"){\n            return \"400\";\n        }\n        if(e.message === \"Request failed with status code 303\"){\n            return \"303\";\n        }\n        throw e;\n    }\n}\n\nexport const ApiLogin = async (email, password) => {\n    try{\n        /*withCredentials: true è per i cookies*/\n        const res = await axios.post(\"/api/user_login\", {email, password}, {withCredentials: true});\n        return res.data;\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 406\"){\n            return null;\n        }\n        else if(e.message === \"Request failed with status code 400\"){\n            return null;\n        }\n        throw e;\n\n    }\n}\n\n/*API to send user's email*/\nexport const ApiMail = async (email) => {\n    try{\n        const res = await axios.post(\"/api/email\", {email})\n\n    } catch (e) {\n        throw e;\n    }\n\n};\n\nexport default {ApiProfessor, ApiProfessorImage, ApiMail, ApiRegister, ApiLogin};","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],["142","143"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["144","145"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport './Login.css'\nimport {Button} from \"../../Buttons/Button\";\nimport {Link} from \"react-router-dom\";\nimport {ApiLogin} from \"../../../api\";\nimport LoginFacebook from \"./LoginFacebook\";\n\nconst LoginForm = (props) => {\n    const {onChangeUser, onChangeError} = props;\n\n\n    const [email, setEmail] = useState('');\n    const [password, setPassword] = useState('');\n    const [loading, setLoading] = useState(false);\n    const [msgError, setMsgError] = useState('');\n\n    const submit = async (e) => {\n        if(e) e.preventDefault();\n\n        if (email !== '' && password !== '') {\n            try {\n                let result = await ApiLogin(email, password);\n                if (result !== null) {\n                    console.log(result);\n                    onChangeError(false);\n                } else onChangeError(true);\n                onChangeUser(email);\n                setLoading(false);\n            } catch (e) {\n                throw e;\n            }\n        } else {\n                setMsgError(\"ATTENZIONE! I campi sono vuoti\")\n        }\n    }\n\n    return (\n        <>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={\"form-input\"}>\n\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Username\"\n                            placeholder=\"Inserisci la tua mail\"\n                            variant=\"outlined\"\n                            type=\"email\"\n                            onChange={e => setEmail(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                autoFocus: true\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Password\"\n                            placeholder=\"Inserisci la tua password\"\n                            variant=\"outlined\"\n                            type=\"password\"\n                            onChange={e => setPassword(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6>\n                        </Button>\n                    </div>\n                    {msgError !== '' ? <div>{msgError}</div> : null}\n                    {/*<FormControlLabel\n                        value=\"ricordami\"\n                        control={<Checkbox color=\"primary\" />}\n                        label=\"Ricordami\"\n                        labelPlacement=\"end\"\n                    />*/}\n                    {/*<div>\n                        oppure\n                    </div>\n                    <LoginFacebook onChangeUserFb={onChangeUser}/>*/}\n                </form>\n\n\n            </div>\n            <div className={\"register-option-container\"}>\n                <div className={\"register-option-text\"}>\n                    Non hai ancora un account?\n                </div>\n                <div className={\"register-option-button\"}>\n                    <Link to='/sign-up'>\n                        <Button buttonStyle='btn--outline--white'>\n                            <h6>Registrati</h6>\n                        </Button>\n                    </Link>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default LoginForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",["146"],"import React from 'react';\nimport UserDetails from \"../components/PagesSections/Dashboard/UserDetails\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport {Redirect} from \"react-router\";\nimport {Button} from \"../components/Buttons/Button\";\n\nconst Dashboard = (props) => {\n\n    const {user, professorList, isHome, onChangeAuth} = props;\n\n    let dashboard;\n\n    user !== null ? dashboard=(<UserDetails user={user}/>) : dashboard=(<div> EFFETTUA IL LOGIN PER ACCEDERE </div>)\n    /*dashboard=(<Redirect to={'/login'} />) NON va bene perché effettua prima il redirect*/\n    return (\n        <>\n            <Navbar professorList={professorList} user={user} isHome={isHome}/>\n            {dashboard}\n            <Button onClick={onChangeAuth} />\n        </>\n    );\n}\n\nexport default Dashboard;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["147"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["148","149"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\n\n/* Complete data for facebook register */\n\nconst SignUpFb = (props) => {\n    const {userFb, onChangeUser} = props;\n\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [university, setUniversity] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\n            setTypeError('Empty');\n            setError(true);\n        }\n        else {\n            setTypeError('No Error');\n            setError(false);\n            return true;\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n\n        if(validation()){\n            try {\n                await ApiRegister(firstname, lastname, userFb.email, university);\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\n                * onChangeUser(user) */\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            displayError();\n        }\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                readOnly: true\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            defaultValue={userFb.email}\n                            aria-required=\"true\"\n                            variant=\"outlined\"\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"university\"\n                            id=\"outlined-textarea\"\n                            label=\"Università\"\n                            placeholder=\"Inserisci la tua università\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setUniversity(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\n                        </Button>\n                    </div>\n                    {error === false ? <Redirect\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpFb;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],{"ruleId":"150","replacedBy":"151"},{"ruleId":"152","replacedBy":"153"},{"ruleId":"154","severity":1,"message":"155","line":15,"column":9,"nodeType":"156","messageId":"157","endLine":15,"endColumn":17},{"ruleId":"154","severity":1,"message":"158","line":14,"column":11,"nodeType":"156","messageId":"157","endLine":14,"endColumn":30},{"ruleId":"154","severity":1,"message":"159","line":9,"column":8,"nodeType":"156","messageId":"157","endLine":9,"endColumn":17},{"ruleId":"160","severity":1,"message":"161","line":10,"column":8,"nodeType":"162","endLine":10,"endColumn":18,"suggestions":"163"},{"ruleId":"154","severity":1,"message":"164","line":2,"column":8,"nodeType":"156","messageId":"157","endLine":2,"endColumn":14},{"ruleId":"150","replacedBy":"165"},{"ruleId":"152","replacedBy":"166"},{"ruleId":"154","severity":1,"message":"167","line":74,"column":15,"nodeType":"156","messageId":"157","endLine":74,"endColumn":18},{"ruleId":"168","severity":1,"message":"169","line":82,"column":1,"nodeType":"170","endLine":82,"endColumn":82},{"ruleId":"150","replacedBy":"171"},{"ruleId":"152","replacedBy":"172"},{"ruleId":"154","severity":1,"message":"173","line":7,"column":8,"nodeType":"156","messageId":"157","endLine":7,"endColumn":21},{"ruleId":"154","severity":1,"message":"174","line":15,"column":12,"nodeType":"156","messageId":"157","endLine":15,"endColumn":19},{"ruleId":"154","severity":1,"message":"175","line":4,"column":9,"nodeType":"156","messageId":"157","endLine":4,"endColumn":17},{"ruleId":"176","severity":1,"message":"177","line":10,"column":21,"nodeType":"178","endLine":10,"endColumn":119},{"ruleId":"154","severity":1,"message":"173","line":6,"column":8,"nodeType":"156","messageId":"157","endLine":6,"endColumn":21},{"ruleId":"154","severity":1,"message":"179","line":11,"column":20,"nodeType":"156","messageId":"157","endLine":11,"endColumn":32},"no-native-reassign",["180"],"no-negated-in-lhs",["181"],"no-unused-vars","'ApiLogin' is defined but never used.","Identifier","unusedVar","'handleOpenLoginForm' is assigned a value but never used.","'SearchBar' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'setProfessor'. Either include it or remove the dependency array.","ArrayExpression",["182"],"'Navbar' is defined but never used.",["180"],["181"],"'res' is assigned a value but never used.","import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration",["180"],["181"],"'LoginFacebook' is defined but never used.","'loading' is assigned a value but never used.","'Redirect' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXOpeningElement","'onChangeUser' is assigned a value but never used.","no-global-assign","no-unsafe-negation",{"desc":"183","fix":"184"},"Update the dependencies array to be: [endpoint, setProfessor]",{"range":"185","text":"186"},[340,350],"[endpoint, setProfessor]"]