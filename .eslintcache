":0,"source":null},{"filePath":"263","messages":"264","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"134"},{"filePath":"265","messages":"266","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"134"},{"filePath":"267","messages":"268","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"134"},{"filePath":"269","messages":"270","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"134"},{"filePath":"271","messages":"272","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"273","messages":"274","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"134"},{"filePath":"275","messages":"276","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["277","278"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/context/AppContext.js",["279"],"import React, { useMemo } from \"react\";\nimport useProfessor from \"../hooks/useProfessor\";\nimport useAuth from \"../hooks/useAuth\";\nimport useProfessorsList from \"../hooks/useProfessorsList\";\nimport useUniversityList from \"../hooks/useUniversityList\";\n\nconst defaultContext = {\n    professorsList: null,\n    universitiesList: null,\n    user: {\n        data: null,\n        login: () => {},\n        validateSession: () => {},\n        refresh: () => {},\n    },\n    professor: {\n        data: null,\n        // image: null,\n        refresh: () => {},\n    },\n};\n\nexport const AppContext = React.createContext(defaultContext);\n\nexport function useAppContext() {\n    const professorsList = useProfessorsList();\n    const universitiesList = useUniversityList();\n    const [professor, refreshProfessor] = useProfessor();\n    const [auth, user, login, validateSession] = useAuth();\n\n    return useMemo(\n        () => ({\n            professorsList,\n            universitiesList,\n            user: {\n                auth,\n                data: user,\n                login,\n                validateSession,\n            },\n            professor: {\n                data: professor,\n                refresh: refreshProfessor,\n            },\n        }),\n        [professorsList, professor, refreshProfessor, user, login, validateSession, auth]\n    );\n}\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAuth.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorsList.js",["280"],"import {useEffect, useState} from 'react';\nimport {ApiProfessorsList} from \"../api\";\n\nconst useProfessorsList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setProfessorsList();\n        }\n    }, []);\n\n    const setProfessorsList = async () => {\n        const professorsList = await ApiProfessorsList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useProfessorsList;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",["281"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nfunction Professor( ) {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n    useEffect(() => {\n        appData.professor.refresh(professorId);\n    }, [professorId, appData.professor.refresh]);\n\n    return (\n        <div>\n            <Navbar />\n            {appData.professor.data !== null ? (\n                <ProfessorDetails professor={appData.professor.data} />\n            ) : (\n                <LoadingComponent />\n            )}\n        </div>\n    );\n}\n\nexport default Professor;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",["282"],"import React, { useContext, useState } from \"react\";\nimport LoginForm from \"../components/PagesSections/Login-SignUp/LoginForm\";\nimport { Redirect } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport { AppContext } from \"../context/AppContext\";\n\nconst Login = () => {\n    const appData = useContext(AppContext)\n\n    if (appData.user.auth === \"OK\") return <Redirect to={\"/dashboard\"} />\n\n    return (\n        <>\n            <Navbar />\n            <LoginForm />\n        </>\n    );\n};\n\nexport default Login;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",["283"],"import React, {useContext, useState} from 'react';\nimport SignUpForm from \"../components/PagesSections/Login-SignUp/SignUpForm\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport SignUpFb from \"../components/PagesSections/Login-SignUp/SignUpFb\";\nimport { AppContext } from '../context/AppContext';\n\nconst SignUp = () => {\n    const appData = useContext(AppContext);\n\n    const [fbRegister, setFacebookRegister] = useState(false);\n    const [userFb, setUserFb] = useState();\n\n    let signUp;\n    !fbRegister ? signUp = (<SignUpForm onChangeUserFb={setUserFb} onChangeFb={setFacebookRegister}/>) :\n        signUp = <SignUpFb userFb={userFb} />\n\n    return (\n        <>\n            <Navbar user={''} />\n            {signUp}\n            </>\n    );\n}\n\nexport default SignUp;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/AddReview.js",["284","285"],"import React, { useContext, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport AddReviewForm from \"../components/PagesSections/AddReview/AddReviewForm\";\nimport { AppContext } from \"../context/AppContext\";\nimport ProgressCirle from \"../components/progress/ProgressCircle\";\n\nexport default function AddReview() {\n    const appData = useContext(AppContext);\n    const { professorId } = useParams();\n    const LoadingComponent = () => {\n        return (\n            <div style={{ margin: \"10rem\", display: \"flex\", justifyContent: \"center\" }}>\n                <ProgressCirle />\n            </div>\n        );\n    };\n\n    useEffect(() => {\n        if (appData.professor.data?.id == professorId) return; // non mettere \"===\" (id: number, professorId: string)\n        appData.professor.refresh(professorId);\n    }, [professorId]);\n\n    return (\n        <>\n            <Navbar />\n\n            {appData.professor.data !== null ? (\n                <AddReviewForm />\n            ) : (\n                <LoadingComponent />\n            )}\n        </>\n    );\n}\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["286"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["287","288","289","290"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["291"],"import React, {useState} from 'react';\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\n/*ICONS*/\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\nimport EmailIcon from \"@material-ui/icons/Email\";\nimport WorkIcon from \"@material-ui/icons/Work\";\nimport BusinessIcon from \"@material-ui/icons/Business\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport { Button } from '../../Buttons/Button';\nimport { Link } from 'react-router-dom';\nimport ProfessorReviews from \"./ProfessorReviews\";\n\nfunction ProfessorDetails(props) {\n    const {professor} = props;\n    const [courseId, setCouseId] = useState(0);\n\n    // let image;\n    // professorImg === \"Image Not Found\" ? image = (\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={imgUser}/>) : image = (\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={professorImg}/>)\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                <img\n                    src={\"/api/professor_image/\" + professor.id}\n                    className={\"professor-img\"}\n                    alt={`${professor.nome} ${professor.cognome}`}\n                />\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>\n                            {professor.nome} {professor.cognome}\n                        </h1>\n                        <div className={\"bubble-rating\"}>\n                            <Rating\n                                name=\"half-rating-read\"\n                                defaultValue={professor.metrics.overall}\n                                precision={0.5}\n                                readOnly\n                                emptyIcon={\n                                    <FiberManualRecordOutlinedIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />\n                                }\n                                icon={<FiberManualRecordIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />}\n                            />\n                        </div>\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <AccountBalanceIcon\n                                            fontSize=\"small\"\n                                            style={{\n                                                fill: \"#e53a1e\",\n                                                marginRight: \"3%\",\n                                            }}\n                                        />\n                                        <h3 style={{ color: \"#e53a1e\" }}>{x.name}</h3>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <EmailIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.email}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <WorkIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.contratto}</p>\n                                    </div>\n                                );\n                            })}\n                            {professor.university.map((x) => {\n                                return (\n                                    <div className={\"professor-info-row\"}>\n                                        <BusinessIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\n                                        <p>{x.dipartimento}</p>\n                                    </div>\n                                );\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.metrics} />\n                    </div>\n                </div>\n            </div>\n            <div className={\"professor-title-courses\"}>\n                {professor.corsi.map((course, i) => (\n                    <h4\n                        className={\"course-title-button\"}\n                        onClick={() => {\n                            setCouseId(i);\n                        }}\n                        style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\n                    >\n                        {course.name}\n                    </h4>\n                ))}\n            </div>\n\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.corsi.map((x, i) => {\n                        return (\n                            <div className={\"course-info-section\"}>\n                                {courseId === i ? <ProfessorCourse course={x} /> : null}\n                            </div>\n                        );\n                    })}\n                </div>\n            </div>\n\n            <div className={\"reviews-section\"}>\n                <div className={\"reviews-section-title\"}>\n                    <h2>Leggi le recensioni</h2>\n                    <Link to={\"/add-review/professors/\" + professor.id}>\n                        <Button buttonStyle=\"btn--outline\" >\n                            <h6 style={{ color: \"white\" }}>Scrivi una recensione</h6>\n                        </Button>\n                    </Link>\n                </div>\n                <ProfessorReviews professor={professor} icourse={courseId} />\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorDetails;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["292","293","294"],"import React, { useContext, useEffect, useState } from \"react\";\nimport TextField from \"@material-ui/core/TextField\";\nimport \"./Login.css\";\nimport { Button } from \"../../Buttons/Button\";\nimport { Link } from \"react-router-dom\";\nimport { ApiLogin } from \"../../../api\";\nimport LoginFacebook from \"./LoginFacebook\";\nimport { AppContext } from \"../../../context/AppContext\";\nimport useLoginForm from \"./useLoginForm\";\nimport FormTextField from \"../../Forms/FormTextField\";\nimport FormCheckbox from \"../../Forms/FormCheckbox\";\n\nconst LoginForm = () => {\n    const appData = useContext(AppContext);\n\n    const [form, submit] = useLoginForm(appData.user.login);\n    const [forgotPsw, setForgotPsw] = useState(false);\n\n    useEffect(() => {\n        switch (appData.user.auth) {\n            case \"MISSING_USER\":\n                form.email.setError(true);\n                break;\n            case \"INVALID_CREDENTIALS\":\n                form.password.setError(true);\n                break;\n            default:\n                break;\n        }\n    }, [appData.user.auth, form.email, form.password]);\n\n    const handleOpen = () => {\n        setForgotPsw(!forgotPsw);\n    }\n\n    let forgotForm = (forgotPsw ? <>\n        <div className={\"form-input\"}>\n            <FormTextField field={form.email} variant=\"outlined\" type=\"email\" />\n        </div>\n        <Button buttonStyle=\"btn--outline\" type=\"submit\">\n            <h6 style={{ color: \"white\" }}>Invia</h6>\n        </Button>\n    </> : null);\n    return (\n        <>\n            <div className={\"element-center\"}>\n                <div className={\"title-red\"}>Login</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={\"form-input\"}>\n                        <FormTextField field={form.email} variant=\"outlined\" type=\"email\" />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <FormTextField field={form.password} variant=\"outlined\" type=\"password\" />\n                    </div>\n                    <FormCheckbox field={form.remember_me} noUnderline />\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle=\"btn--outline\" type=\"submit\">\n                            <h6 style={{ color: \"white\" }}>Accedi</h6>\n                        </Button>\n                    </div>\n                    <div className={'forgot-psw'} onClick={handleOpen}>Hai dimenticato la password?</div>\n                    {forgotForm}\n                    {/*<div>\n                        oppure\n                    </div>\n                    <LoginFacebook onChangeUserFb={onChangeUser}/>*/}\n                </form>\n            </div>\n            <div className={\"register-option-container\"}>\n                <div className={\"register-option-text\"}>Non hai ancora un account?</div>\n                <div className={\"register-option-button\"}>\n                    <Link to=\"/sign-up\">\n                        <Button buttonStyle=\"btn--outline--white\">\n                            <h6>Registrati</h6>\n                        </Button>\n                    </Link>\n                </div>\n            </div>\n        </>\n    );\n};\n\nexport default LoginForm;\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["295","296"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\n\n/* Complete data for facebook register */\n\nconst SignUpFb = (props) => {\n    const {userFb, onChangeUser} = props;\n\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [university, setUniversity] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\n            setTypeError('Empty');\n            setError(true);\n        }\n        else {\n            setTypeError('No Error');\n            setError(false);\n            return true;\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n\n        if(validation()){\n            try {\n                await ApiRegister(firstname, lastname, userFb.email, university);\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\n                * onChangeUser(user) */\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            displayError();\n        }\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                readOnly: true\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            defaultValue={userFb.email}\n                            aria-required=\"true\"\n                            variant=\"outlined\"\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"university\"\n                            id=\"outlined-textarea\"\n                            label=\"Università\"\n                            placeholder=\"Inserisci la tua università\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setUniversity(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\n                        </Button>\n                    </div>\n                    {error === false ? <Redirect\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpFb;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["297"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",["298","299","300","301","302","303","304"],"import React, {useContext, useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\nimport FormTextField from \"../../Forms/FormTextField\";\nimport MenuItem from \"@material-ui/core/MenuItem\";\nimport SearchBar from \"../../SearchBar/SearchBar\";\nimport {AppContext} from \"../../../context/AppContext\";\nimport {FormControl, InputLabel, NativeSelect, Select} from \"@material-ui/core\";\n\nconst SignUpForm = (props) => {\n    const {onChangeUserFb, onChangeFb} = props;\n    const appData = useContext(AppContext);\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [email, setEmail] = useState('');\n    const [university, setUniversity] = useState('');\n    const [password, setPassword] = useState('');\n    const [passwordControl, setPasswordControl] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n    const [done, setDone] = useState(false);\n\n\n    const handleChange = (event) => {\n        setUniversity(event.target.value);\n    };\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            case 'Different passwords':\n                setMsgError(\"ATTENZIONE, le password non coincidono\");\n                break;\n            case 'Invalid email':\n                setMsgError(\"ATTENZIONE, la mail non è valida\");\n                break;\n            case 'Short Password':\n                setMsgError(\"ATTENZIONE, la password è troppo corta\");\n                break;\n            case 'Already registered':\n                setMsgError(\"ATTENZIONE, utente già registrato\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n\n        if (firstname.length < 1 || lastname.length < 1 || email.length < 1 || university.length < 1 || password.length < 1 || passwordControl.length < 1) {\n            setTypeError('Empty');\n            setError(true);\n        } else if (!email.includes('@')) {\n            setTypeError('Invalid email');\n            setError(true);\n        } else if (password.length < 8) {\n            setTypeError('Short Password');\n            setError(true);\n        } else if (password !== passwordControl) {\n            setTypeError('Different passwords');\n            setError(true);\n        } else {\n            setTypeError('No Error');\n            setError(false);\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        if (e) e.preventDefault();\n        if (!error) {\n            try {\n                let res = await ApiRegister(firstname, lastname, email, password, university, \"Unihub\", null);\n\n                switch (res.data) {\n                    case \"OK\":\n                        setDone(true);\n                        break;\n                    case \"Already registered\":\n                        break;\n                    default:\n                        break;\n                }\n            } catch (e) {\n                throw e;\n            }\n\n        }\n        displayError();\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            placeholder=\"Inserisci la tua email\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setEmail(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        {appData.universitiesList !== null ?\n                            //console.log(appData.universitiesList)\n                            <FormControl>\n                                <InputLabel id=\"demo-simple-select-helper-label\">Univeristà</InputLabel>\n\n                                    <NativeSelect\n                                        value={university}\n                                        onChange={handleChange}\n                                        inputProps={{\n                                            name: 'universities',\n                                            id: 'age-native-helper',\n                                        }}\n                                    >\n                                        {appData.universitiesList.universities\n                                            .map((university) => (\n                                                <option value={university} key={university}>\n                                                    {university}\n                                                </option>\n                                            ))}\n                                    </NativeSelect>\n\n                            </FormControl>\n                            : <div> </div>\n                        }\n\n                    </div>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"password\"\n                                id=\"outlined-textarea\"\n                                label=\"Password\"\n                                placeholder=\"Inserisci la tua password\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                type=\"password\"\n                                onChange={e => setPassword(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"passwordControl\"\n                                id=\"outlined-textarea\"\n                                label=\"Conferma Password\"\n                                placeholder=\"Inserisci di nuovo la tua password\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                type=\"password\"\n                                onChange={e => setPasswordControl(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Registrati</h6>\n                        </Button>\n                    </div>\n                    {done ? <Redirect\n                            to=\"/login\"/> :\n                        <div>{msgError}</div>} {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                    {/*<div>\n                        oppure registrati con\n                    </div>\n                    <LoginFacebook onChangeUserFb={onChangeUserFb} onChangeFb={onChangeFb}/>*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["305","306","307"],"import axios from \"axios\";\nimport ApiResponse from \"./ApiResponse\";\n\n/*API to request professor detail*/\nexport const ApiProfessorsList = async () => {\n    try {\n        const res = await axios.get(\"/api/professors_list\");\n        return res.data.results;\n    } catch (e) {\n        if (e != null) {\n            console.log(JSON.stringify(e));\n            return null;\n        }\n        throw e;\n    }\n};\n\n/*API to request professor detail*/\nexport const ApiProfessor = async (professorId) => {\n    try {\n        const res = await axios.get(\"/api/professors/\" + professorId);\n        return res.data;\n    } catch (e) {\n        switch (e.message) {\n            case \"Request failed with status code 400\":\n                return \"No professor\";\n            case \"Request failed with status code 500\":\n                return \"Internal error\";\n            default:\n                return \"Error\";\n        }\n        throw e;\n    }\n};\n\n/*API to request professor image*/\nexport const ApiProfessorImage = async (professorId) => {\n    try {\n        const img = await axios.get(\"/api/professor_image/\" + professorId);\n        return img;\n    } catch (e) {\n        switch (e.message) {\n            case \"Request failed with status code 404\":\n                return \"Image Not Found\";\n            default:\n                break;\n        }\n        throw e;\n    }\n};\n\n/*API to register new users*/\n/*export const ApiRegisterResponse = new ApiResponse(\n    \"OK\",\n    \"ALREADY_REGISTER\",\n    \"CONFIRM_EMAIL\",\n    \"INVALID_CREDENTIAL\"\n);*/\n\n/**\n * Register\n * @param {{name: string; surname: string; email: string; password: string; university: string;}} data\n * @returns {{void}}\n */\n\n/*export const ApiRegister = async (data) => {\n    return axios\n        .post(\"/api/register\", data)\n        .then((res) => res ({\n            res: ApiRegisterResponse.OK,\n            data: res.data,\n    }))\n        .catch((err) => {\n            const { status } = err.response;\n            switch ( status ){\n                case 202:\n                    return { res: ApiRegisterResponse.ALREADY_REGISTER, data: null};\n                case 303:\n                    return { res: ApiRegisterResponse.CONFIRM_EMAIL, data: null};\n                default:\n                    return { res: ApiRegisterResponse.INVALID_CREDENTIAL, data: null}\n            }\n        })\n}*/\n\nexport const ApiRegister = async (name, surname, email, password, university, type, externalId) => {\n    try {\n        const res = await axios.post(\"/api/register\", { name, surname, email, password, university });\n        console.log(JSON.stringify(res));\n        return res;\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if (e.message === \"Request failed with status code 400\") {\n            return \"400\";\n        }\n        if (e.message === \"Request failed with status code 303\") {\n            return \"303\";\n        }\n        throw e;\n    }\n};\n\n/*API to login users*/\nexport const ApiLoginResponse = new ApiResponse(\"OK\", \"REQUIRES_CONFIRM\", \"INVALID_CREDENTIALS\", \"MISSING_USER\", \"UNAUTH\");\n/**\n * Login\n * @param {{email: string; password: string; remember_me: boolean}} data\n * @returns {{void}}\n */\nexport const ApiLogin = async (data) => {\n    return axios\n        .post(\"/api/user_login\", data, { withCredentials: true })\n        .then((res) => ({\n            res: ApiLoginResponse.OK,\n            data: res.data,\n        }))\n        .catch((err) => {\n            const { status } = err.response;\n            switch (status) {\n                case 406:\n                    return { res: ApiLoginResponse.MISSING_USER, data: null };\n                case 400:\n                    return { res: ApiLoginResponse.REQUIRES_CONFIRM, data: null };\n                default:\n                    return { res: ApiLoginResponse.INVALID_CREDENTIALS, data: null };\n            }\n        });\n};\n\nexport const ApiValidateSessionResponse = new ApiResponse(\"OK\", \"UNAUTH\");\nexport const ApiValidateSession = async () => {\n    return axios\n        .get(\"/api/test_cookies\", { withCredentials: true })\n        .then((res) => ({\n            res: ApiValidateSessionResponse.OK,\n            data: res.data,\n        }))\n        .catch(() => ({\n            res: ApiValidateSessionResponse.UNAUTH,\n            data: null,\n        }));\n};\n\nexport const ApiLogoutResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiLogout = async () => {\n    return axios\n        .post(\"/api/user_logout\", {}, { withCredentials: true })\n        .then(() => ({ res: ApiLogoutResponse.OK }))\n        .catch(() => ({\n            res: ApiLogoutResponse.FAILED,\n        }));\n};\n\nexport const ApiAddProfessorReviewResponse = new ApiResponse(\"OK\", \"FAILED\");\nexport const ApiAddProfessorReview = async (data) => {\n    return axios\n        .post(\"/api/new_review\", data)\n        .then(() => ({\n            res: ApiAddProfessorReviewResponse.OK,\n        }))\n        .catch(() => ({\n            res: ApiAddProfessorReviewResponse.FAILED,\n        }));\n};\n\n/*API to send user's email*/\nexport const ApiMail = async (email) => {\n    try {\n        const res = await axios.post(\"/api/email\", { email });\n    } catch (e) {\n        throw e;\n    }\n};\n\n/*API to send user's email*/\nexport const ApiReviews = async (corso_id, professor_id, num) => {\n    try {\n        const res = await axios.get(\"/api/reviews_course\", { params: { corso_id, professor_id, num } });\n        return res.data.results;\n    } catch (e) {\n        if (e.message === \"Request failed with status code 400\") {\n            return null;\n        }\n        throw e;\n    }\n};\n\n/*API to universities list*/\nexport const ApiUniversitiesList = async () => {\n    try {\n        const res = await axios.get(\"/api/universities_list\");\n        return res.data;\n    } catch (e) {\n        throw e;\n    }\n};\n\nexport default { ApiProfessor, ApiMail, ApiRegister, ApiLogin, ApiUniversitiesList };\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useMediaQuery.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReviews.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/useLoginForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewFormSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/useAddReviewForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserStats.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/ApiResponse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormTextField.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormCheckbox.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormRadio.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Forms/FormRating.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/hoc/withAuth.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorReviews.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useFormField.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Text/ExpandableParagraph.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/progress/ProgressBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/progress/ProgressCircle.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useUniversityList.js",["308"],"import {useEffect, useState} from 'react';\nimport {ApiUniversitiesList} from \"../api\";\n\nconst useUniversityList = () => {\n    const [state, setState] = useState(null);\n\n    useEffect(() => {\n        if(state == null){\n            setUniversitiesList();\n        }\n    }, []);\n\n    const setUniversitiesList = async () => {\n        const professorsList = await ApiUniversitiesList();\n\n        setState(professorsList);\n    };\n    return state;\n};\n\nexport default useUniversityList;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Settings.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAddProfessorReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Cards/Card.js",["309"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/SettingForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Settings/CardContainer.js",["310"],"/home/davide/Documenti/unihub/uniadvisor/uniadvi