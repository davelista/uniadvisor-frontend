Count":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"84","messages":"85","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"88","usedDeprecatedRules":"46"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\index.js",[],["91","92"],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\App.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\pages\\Home.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\pages\\Professor.js",["93"],"import React, {useState, useEffect} from 'react';\r\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\r\nimport {useParams} from \"react-router\";\r\nimport useProfessor from \"../hooks/useProfessor\";\r\nimport Popup from \"../components/Popup/Popup\";\r\n\r\nfunction Professor(props) {\r\n    let { endpoint } = useParams();\r\n    console.log(\"questo è l'end point: \", endpoint);\r\n    let [professor, isLoading] = useProfessor(endpoint);\r\n    const [showPopup, setShowPopup] = useState(false)\r\n    const [isFirst, setIsFirst] = useState(true);\r\n    const {professorList, onChangeProfessor, isHome} = props;\r\n\r\n    const showPopupFunction = () => {\r\n        setShowPopup(!showPopup);\r\n        setIsFirst(false);\r\n    };\r\n\r\n    const TitlePopup = (props) => {\r\n        const {titleText, onClose} = props;\r\n        return (\r\n            <div className={'title-popup'}>\r\n                <div className={'title-text'}>{titleText}</div>\r\n                <div className={'close-button'} onClick={onClose}>X</div>\r\n            </div>\r\n        )\r\n    }\r\n\r\n    useEffect(() => {\r\n        const timer = setTimeout(() => {\r\n            if (isFirst) {\r\n                setShowPopup(true);\r\n            }\r\n        }, 3000);\r\n        return () => clearTimeout(timer);\r\n    }, [showPopup]);\r\n\r\n    const getContent = () => {\r\n        if(!isLoading){\r\n            return (\r\n                <React.Fragment>\r\n                    {showPopup && <Popup>\r\n                        <div className={'form-content'}>\r\n                            <TitlePopup titleText={'Siamo spiacenti!'} onClose={showPopupFunction}/>\r\n                            <p>Potreste riscontrare errori nella visualizzazione della pagina a causa della manutenzione del server.</p>\r\n                            <p>Ci scusiamo per il disagio.</p>\r\n                        </div>\r\n                    </Popup>}\r\n                    <ProfessorDetails professorList={professorList} onChangeProfessor={onChangeProfessor} isHome={isHome} professor={professor}/>\r\n                </React.Fragment>\r\n            );\r\n        }\r\n    }\r\n\r\n    return (\r\n        <div>\r\n            {getContent()}\r\n        </div>\r\n    )\r\n\r\n}\r\nexport default Professor;","C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\Footer.js",["94"],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\Navbar\\Navbar.js",["95"],"import React, {useState} from 'react';\r\nimport {Link} from 'react-router-dom';\r\nimport logo from \"../../img/logo.svg\";\r\nimport './Navbar.css'\r\nimport '../Buttons/Button.css';\r\nimport {Button} from \"../Buttons/Button\";\r\nimport Popup from \"../Popup/Popup\";\r\nimport {ApiMail} from \"../../api\";\r\n\r\nfunction Navbar() {\r\n\r\n    const [email, setEmail] = useState();\r\n    const [loading, setLoading] = useState (false); //loading è fondamentale per l'invio delle informazioni dal popup\r\n\r\n    const TitlePopup = (props) => {\r\n        const {titleText, onClose} = props;\r\n        return (\r\n            <div className={'title-popup'}>\r\n                <div className={'title-text'}>{titleText}</div>\r\n                <div className={'close-button'} onClick={onClose}>X</div>\r\n            </div>\r\n        )\r\n    }\r\n\r\n    const [isOpenLoginForm, setOpenLoginForm] = React.useState(false);\r\n\r\n    const handleOpenLoginForm = () => {\r\n        setOpenLoginForm(!isOpenLoginForm);\r\n    }\r\n    const sendMail = async (email) => {\r\n        setLoading(true);\r\n        try {\r\n            await ApiMail(email);\r\n        } catch (e) {\r\n            throw e;\r\n        }\r\n        setLoading(false);\r\n    };\r\n\r\n    const handleSubmit = (e) => {\r\n        e.preventDefault();\r\n        //console.log(\"la userMail è\" + email);\r\n        sendMail(email);\r\n    }\r\n\r\n    return (\r\n        <>\r\n            <div className=\"navbar\">\r\n                <Link to='/' className=\"navbar-title\">\r\n                    <img src={logo} className={'logo'} alt={logo}/>\r\n                </Link>\r\n                <div className=\"menu-content\">\r\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6>Accedi/Registrati</h6></Button>\r\n                    {isOpenLoginForm && <Popup onSubmit={handleSubmit}>\r\n                        <div className={'form-content'}>\r\n                            <TitlePopup titleText={'Siamo spiacenti!'} onClose={handleOpenLoginForm}/>\r\n                            <p>Il sito è in fase di manutenzione e questa funzione non è al momento disponibile.</p>\r\n                            <p>Ti chiediamo di lasciarci la mail in modo da poterti avvisare quando è pronto</p>\r\n                            <input\r\n                                className={\"form-input\"}\r\n                                placeholder=\"Mail\"\r\n                                onChange={e => setEmail(e.target.value)}\r\n                                required\r\n                                value={email}\r\n                            />\r\n                            <div className={'form-buttons'}>\r\n                                <button className={'send-button'} onClick={handleSubmit}>Invia</button>\r\n                            </div>\r\n                        </div>\r\n                    </Popup>}\r\n                </div>\r\n            </div>\r\n        </>\r\n    );\r\n\r\n}\r\n\r\nexport default Navbar;\r\n\r\n","C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\University\\UniveristyArea.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutArea.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\HeroSection\\HeroSection.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\Popup\\Popup.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\hooks\\useProfessor.js",["96"],"import {useEffect, useState} from 'react';\r\nimport {ApiProfessor} from \"../api\";\r\n\r\nconst useProfessor = (endpoint) => {\r\n    const [state, setState] = useState();\r\n    const [isLoading, setLoading] = useState(true);\r\n    useEffect(() => {\r\n        setProfessor();\r\n    }, [endpoint]);\r\n\r\n    const setProfessor = async () => {\r\n        setLoading(true);\r\n        const professorEndpoint = endpoint ? endpoint : undefined\r\n        if (professorEndpoint != null) {\r\n            console.log(\"endpoint = \" + professorEndpoint);\r\n            const selectedProfessor = await ApiProfessor(professorEndpoint);\r\n            console.log(\"answer new stringify\" + JSON.stringify(selectedProfessor));\r\n            setState(selectedProfessor);\r\n            setLoading(false);\r\n        }\r\n\r\n    };\r\n    if (state != null) {\r\n        console.log(\"ho settato il json con; \", state)\r\n    }\r\n    return [state, isLoading, setProfessor];\r\n};\r\n\r\nexport default useProfessor;","C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorDetails.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutItems.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutData.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\Buttons\\Button.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\SearchBar\\SearchBar.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorEvaluation.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\Review.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorCourse.js",[],"C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\api\\index.js",["97"],"import axios from \"axios\";\r\n\r\nexport const ApiProfessor = async (professorEndpoint) => {\r\n    try{\r\n        const res = await axios.get(\"/api/professors/\"+professorEndpoint);\r\n        return res.data;\r\n    } catch (e){\r\n        throw e;\r\n    }\r\n\r\n};\r\nexport const ApiMail = async (email) => {\r\n    try{\r\n        const res = await axios.post(\"/api/email\", {email})\r\n            .then(response => {\r\n                console.log(response)\r\n            })\r\n            .catch(error => {\r\n                console.log(error)\r\n            });\r\n\r\n        return res.data;\r\n    } catch (e) {\r\n        throw e;\r\n    }\r\n\r\n\r\n};\r\n\r\nexport default {ApiProfessor, ApiMail};","C:\\Users\\david\\WebstormProjects\\uniadvisor-frontend\\src\\components\\SearchBar\\SearchBarResult.js",[],{"ruleId":"98","replacedBy":"99"},{"ruleId":"100","replacedBy":"101"},{"ruleId":"102","severity":1,"message":"103","line":37,"column":8,"nodeType":"104","endLine":37,"endColumn":19,"suggestions":"105"},{"ruleId":"106","severity":1,"message":"107","line":10,"column":21,"nodeType":"108","endLine":10,"endColumn":119},{"ruleId":"109","severity":1,"message":"110","line":13,"column":12,"nodeType":"111","messageId":"112","endLine":13,"endColumn":19},{"ruleId":"102","severity":1,"message":"113","line":9,"column":8,"nodeType":"104","endLine":9,"endColumn":18,"suggestions":"114"},{"ruleId":"115","severity":1,"message":"116","line":30,"column":1,"nodeType":"117","endLine":30,"endColumn":40},"no-native-reassign",["118"],"no-negated-in-lhs",["119"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'isFirst'. Either include it or remove the dependency array.","ArrayExpression",["120"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXOpeningElement","no-unused-vars","'loading' is assigned a value but never used.","Identifier","unusedVar","React Hook useEffect has a missing dependency: 'setProfessor'. Either include it or remove the dependency array.",["121"],"import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration","no-global-assign","no-unsafe-negation",{"desc":"122","fix":"123"},{"desc":"124","fix":"125"},"Update the dependencies array to be: [isFirst, showPopup]",{"range":"126","text":"127"},"Update the dependencies array to be: [endpoint, setProfessor]",{"range":"128","text":"129"},[1281,1292],"[isFirst, showPopup]",[273,283],"[endpoint, setProfessor]"]