,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"106","messages":"107","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"108","messages":"109","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"112","messages":"113","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"114","usedDeprecatedRules":"72"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"117"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"120","messages":"121","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"122","messages":"123","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"124","usedDeprecatedRules":"72"},{"filePath":"125","messages":"126","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"127","messages":"128","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"129","messages":"130","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"131","usedDeprecatedRules":"72"},{"filePath":"132","messages":"133","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"134","usedDeprecatedRules":"72"},{"filePath":"135","messages":"136","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"137","usedDeprecatedRules":"72"},{"filePath":"138","messages":"139","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"140","messages":"141","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"142","messages":"143","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"144","messages":"145","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"146","messages":"147","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"148","usedDeprecatedRules":"72"},{"filePath":"149","messages":"150","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"151","messages":"152","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["153","154"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",["155","156"],"import React, {useEffect, useState} from 'react'\nimport './App.css';\nimport {BrowserRouter as Router, Route, Switch} from \"react-router-dom\";\nimport ReactGA from 'react-ga';\n//import professorsList from './json/professorsList.json'\n//Pages\nimport {Dashboard, Home, Login, Professor, SignUp} from './pages'\nimport {Footer} from './components'\nimport {Redirect} from \"react-router\";\nimport useProfessorsList from \"./hooks/useProfessorsList\";\n\nconst getCookie = (cname) => {\n    let name = cname + \"=\";\n    let decodedCookie = decodeURIComponent(document.cookie);\n    let ca = decodedCookie.split(';');\n    for (let i = 0; i < ca.length; i++) {\n        let c = ca[i];\n        while (c.charAt(0) === ' ') {\n            c = c.substring(1);\n        }\n        if (c.indexOf(name) === 0) {\n            return c.substring(name.length, c.length);\n        }\n    }\n    return \"\";\n}\n\nconst setCookie = (cname, cvalue, exdays) => {\n    let d = new Date();\n    d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));\n    let expires = \"expires=\" + d.toUTCString();\n    document.cookie = cname + \"=\" + cvalue + \";\" + expires + \";path=/\";\n}\n\n\nfunction App() {\n    useEffect(() => {\n        ReactGA.initialize('UA-185661222-1 ');\n        //to report page view\n        ReactGA.pageview(window.location.pathname + window.location.search);\n    }, [])\n\n    const [user, setUser] = useState(null);\n    const [professorsList, isLoadingList] = useProfessorsList();\n\n    return (\n        <Router>\n            <Switch>\n                <Route exact path='/'\n                       component={() => <Home professorsList={professorsList} user={user} isHome={true} isLoadingList={isLoadingList}/>}/>\n                <Route exact path=\"/professors/:professorId\"\n                       component={() => <Professor professorsList={professorsList} user={user} isHome={false} isLoadingList={isLoadingList}/>}/>\n                <Route exact path=\"/dashboard\"\n                       component={() => <Dashboard professorsList={professorsList} user={user} isHome={false} isLoadingList={isLoadingList}/>}/>\n                <Route exact path=\"/login\"\n                       component={() => <Login professorsList={professorsList} onChangeUser={setUser}\n                                               isHome={false}/>}/>\n                <Route exact path=\"/sign-up\"\n                       component={() => <SignUp professorsList={professorsList} onChangeUser={setUser}\n                                                isHome={false}/>}/>\n                <Route render={() => <Redirect to={{pathname: \"/\"}}/>}/>\n            </Switch>\n            <Footer/>\n        </Router>\n\n    );\n\n    /*\n        funzione per eliminare cookies\n        document.cookie = \"session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\n\n        getCookie(\"session\") === \"\" ? setUser(null) : ApiLogin(\"davide.lista.polimi@gmail.com\", \"prova\"); /*Api speficia per i cookies\n\n        if(user !== null) {\n            setCookie(\"session\", user, 7);\n            console.log(getCookie(\"session\"));\n        }\n\n        const readCookie = () => {\n            getCookie(\"session\");\n        }\n    */\n}\n\nexport default App;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["157"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport SearchBar from \"../SearchBar/SearchBar\";\nimport useMediaQuery, { Device } from '../../hooks/useMediaQuery';\nimport SearchIcon from '@material-ui/icons/Search';\n\nconst Navbar = (props) => {\n\n    const {professorsList, user, isHome, isLoadingList} = props;\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\n    \n    const isMobile = useMediaQuery(Device.sm);\n    const [mobileSearchHidden, setMobileSearchHidden] = useState(true);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n\n    let button;\n    user === null ? button = (\n            <Link to='/login' className=\"navbar-title\">\n                {/* <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button> */}\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>{isMobile ? \"Accedi\" : \"Accedi/Registrati\"}</h6></Button>\n            </Link>\n        )\n        : button = (<Link to='/dashboard'><div>{user}</div></Link>)\n\n    let search;\n    isHome === false && isLoadingList === false ? search=(<SearchBar professorsList={professorsList} isHome={isHome}/>) : search=(<div></div>)\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                {isMobile ? <SearchIcon onClick={() => setMobileSearchHidden(value => !value)} /> : search}\n                {/* LOGIN POPUP\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm &&\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\n                        <Login onChangeUser={onChangeUser}/>\n                    </Popup>}\n                </div>*/}\n                {button}\n\n                {!mobileSearchHidden && isMobile && !isHome ? <div className=\"navbar-mobile-search\">{search}</div> : null}\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["158"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["159"],"import {useEffect, useState} from 'react';\nimport {ApiProfessor} from \"../api\";\n\nconst useProfessor = (ProfessorId) => {\n    const [state, setState] = useState();\n    const [isLoading, setLoading] = useState(true);\n    useEffect(() => {\n        if(ProfessorId){\n            setProfessor();\n        } else {\n            setState(null);\n        }\n\n    }, [ProfessorId]);\n\n    const setProfessor = async () => {\n        const professorId = ProfessorId ? ProfessorId : undefined;\n        if (professorId) {\n            setLoading(true);\n            const professor = await ApiProfessor(professorId);\n            setState(professor);\n            setLoading(false);\n        }\n\n    };\n    return [state, isLoading, setProfessor];\n};\n\nexport default useProfessor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["160"],"import React, {useState} from 'react';\nimport Navbar from \"../../Navbar/Navbar\";\nimport './Professor.css';\nimport imgUser from \"../../../img/user.jpg\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport ProfessorCourse from \"./ProfessorCourse\";\nimport ProfessorReview from \"./ProfessorReview\";\nimport {Button} from \"../../Buttons/Button\";\n/*ICONS*/\nimport EmailIcon from '@material-ui/icons/Email';\nimport WorkIcon from '@material-ui/icons/Work';\nimport AccountBalanceIcon from '@material-ui/icons/AccountBalance';\nimport BusinessIcon from '@material-ui/icons/Business';\n/*RATING*/\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\nimport Rating from '@material-ui/lab/Rating';\n\nfunction ProfessorDetails(props) {\n    const {professor, professorImg} = props;\n    const [courseId, setCouseId] = useState(1);\n\n    let image;\n    professorImg === \"Image Not Found\" ? image = (<img src={imgUser} className={\"professor-img\"} alt={imgUser}/>) : image = (<img src={professorImg} className={\"professor-img\"} alt={professorImg}/>)\n\n    return (\n        <>\n            <div className={\"professor-card\"}>\n                {image}\n                <div className=\"professor-detail\">\n                    <div className=\"professor-title\">\n                        <h1>{professor.name}</h1>\n                        {professor.finalEvaluation.filter(x => x.title === \"Overall\")\n                            .map((x) => {\n                                return (\n                                    <div className={\"bubble-rating\"}>\n                                    <Rating name=\"half-rating-read\"\n                                            defaultValue={x.value}\n                                            precision={0.5}\n                                            readOnly\n                                            emptyIcon={<FiberManualRecordOutlinedIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                            icon={<FiberManualRecordIcon fontSize=\"large\" style={{fill: \"#e53a1e\"}}/>}\n                                    />\n                                    </div>\n                                )\n                            })}\n                    </div>\n                    <div className=\"professor-university-section\">\n                        <div className=\"professor-info\">\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><AccountBalanceIcon fontSize=\"small\" style={{fill: \"#e53a1e\", marginRight: \"3%\"}}/><h3 style={{color: \"#e53a1e\"}}>{x.name}</h3></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><EmailIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{professor.email}</p></div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><WorkIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.typeContract}</p> </div>\n                            })}\n                            {professor.university.map((x) => {\n                                return <div className={\"professor-info-row\"}><BusinessIcon fontSize=\"small\" style={{marginRight: \"3%\"}}/><p>{x.department}</p> </div>\n                            })}\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.finalEvaluation}/>\n                    </div>\n                </div>\n            </div>\n\n            <div className={\"professor-title-courses\"}>\n                {professor.university.map((university) => {\n                        return university.courses.map((course) => {\n                            return ( <>\n                                {courseId === course.id ?\n                                <h4 className={\"course-title-button\"} onClick={() => {\n                                    setCouseId(course.id)\n                                }} style={{color: \"#e53a1e\"}}> {course.name}</h4> : <h4 className={\"course-title-button\"} onClick={() => {\n                                        setCouseId(course.id)\n                                    }} style={{color: \"#c9c9c9\"}}> {course.name}</h4>} </>\n                            )\n\n                        } )\n                    }\n                )}\n            </div>\n            <div className={\"professor-courses\"}>\n                <div className=\"course-details-section\">\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <div className={\"course-info-section\"}>\n                                        {courseId === course.id ? <ProfessorCourse course={course}/> : null}\n                                    </div>\n                                )\n                            })\n                        }\n                    )}\n                </div>\n            </div>\n\n            <div className={\"reviews-section\"}>\n                <div className={\"reviews-section-title\"}>\n                    <h2>Leggi le recensioni</h2>\n                    <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Scrivi una recensione</h6></Button>\n                </div>\n                <>\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (\n                                    <>\n                                        {courseId === course.id && course.reviews.length !== 0 ?\n                                            <ProfessorReview review={course.reviews}/> : null}\n                                    </>\n                                )\n                            })\n                        }\n                    )}\n                </>\n                <div className={\"reviews-section-title\"}>\n                    <h3>Vecchie recensioni</h3>\n                </div>\n                <>\n                    {professor.oldReview.map((x) => {\n                        return <ProfessorReview review={x} oldReview={true}/>\n                    })}\n                </>\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorDetails;",["161","162"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],["163","164"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["165","166","167"],"import axios from \"axios\";\n\n/*API to request professor detail*/\nexport const ApiProfessorsList = async () => {\n    try{\n        const res = await axios.get(\"/api/professors_list\");\n        return res.data.results;\n    } catch (e){\n        if(e != null){\n            console.log(JSON.stringify(e));\n            return null;\n        }\n        throw e;\n    }\n};\n\n/*API to request professor detail*/\nexport const ApiProfessor = async (professorId) => {\n    try{\n        const res = await axios.get(\"/api/professors/\"+professorId);\n        return res.data;\n    } catch (e){\n        switch (e.message){\n            case \"Request failed with status code 400\":\n                return \"No professor\";\n            case \"Request failed with status code 500\":\n                return \"Internal error\";\n            default:\n                return \"Error\";\n        }\n        throw e;\n    }\n};\n\n/*API to request professor image*/\n/*export const ApiProfessorImage = async (professorId) => {\n    try{\n        const img = await axios.get(\"/api/professor_image/\" + professorId)\n        return img;\n    } catch (e){\n        switch (e.message){\n            case \"Request failed with status code 404\":\n                return \"Image Not Found\";\n            default:\n                break;\n        }\n        throw e;\n    }\n};*/\n\n/*API to register new users*/\nexport const ApiRegister = async (name, surname, email, password, university, type, externalId) =>{\n    try{\n        const res = await axios.post(\"/api/register\", {name, surname, email, password, university});\n        console.log(JSON.stringify(res));\n        return res;\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 400\"){\n            return \"400\";\n        }\n        if(e.message === \"Request failed with status code 303\"){\n            return \"303\";\n        }\n        throw e;\n    }\n}\n\nexport const ApiLogin = async (email, password) => {\n    try{\n        /*withCredentials: true è per i cookies*/\n        const res = await axios.post(\"/api/user_login\", {email, password}, {withCredentials: true});\n        return res.data;\n    } catch (e) {\n        console.log(JSON.stringify(e));\n        if(e.message === \"Request failed with status code 406\"){\n            return null;\n        }\n        else if(e.message === \"Request failed with status code 400\"){\n            return null;\n        }\n        throw e;\n\n    }\n}\n\n/*API to send user's email*/\nexport const ApiMail = async (email) => {\n    try{\n        const res = await axios.post(\"/api/email\", {email})\n\n    } catch (e) {\n        throw e;\n    }\n\n};\n\nexport default {ApiProfessor, ApiMail, ApiRegister, ApiLogin};","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],["168","169"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["170","171"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport './Login.css'\nimport {Button} from \"../../Buttons/Button\";\nimport {Link} from \"react-router-dom\";\nimport {ApiLogin} from \"../../../api\";\nimport LoginFacebook from \"./LoginFacebook\";\n\nconst LoginForm = (props) => {\n    const {onChangeUser, onChangeError} = props;\n\n\n    const [email, setEmail] = useState('');\n    const [password, setPassword] = useState('');\n    const [loading, setLoading] = useState(false);\n    const [msgError, setMsgError] = useState('');\n\n    const submit = async (e) => {\n        if(e) e.preventDefault();\n\n        if (email !== '' && password !== '') {\n            try {\n                let result = await ApiLogin(email, password);\n                if (result !== null) {\n                    console.log(result);\n                    onChangeError(false);\n                    onChangeUser(email);\n                } else onChangeError(true);\n                setLoading(false);\n            } catch (e) {\n                throw e;\n            }\n        } else {\n                setMsgError(\"ATTENZIONE! I campi sono vuoti\")\n        }\n    }\n\n    return (\n        <>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={\"form-input\"}>\n\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Username\"\n                            placeholder=\"Inserisci la tua mail\"\n                            variant=\"outlined\"\n                            type=\"email\"\n                            onChange={e => setEmail(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                autoFocus: true\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Password\"\n                            placeholder=\"Inserisci la tua password\"\n                            variant=\"outlined\"\n                            type=\"password\"\n                            onChange={e => setPassword(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6>\n                        </Button>\n                    </div>\n                    {msgError !== '' ? <div>{msgError}</div> : null}\n                    {/*<FormControlLabel\n                        value=\"ricordami\"\n                        control={<Checkbox color=\"primary\" />}\n                        label=\"Ricordami\"\n                        labelPlacement=\"end\"\n                    />*/}\n                    {/*<div>\n                        oppure\n                    </div>\n                    <LoginFacebook onChangeUserFb={onChangeUser}/>*/}\n                </form>\n\n\n            </div>\n            <div className={\"register-option-container\"}>\n                <div className={\"register-option-text\"}>\n                    Non hai ancora un account?\n                </div>\n                <div className={\"register-option-button\"}>\n                    <Link to='/sign-up'>\n                        <Button buttonStyle='btn--outline--white'>\n                            <h6>Registrati</h6>\n                        </Button>\n                    </Link>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default LoginForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",["172"],"import React from 'react';\nimport UserDetails from \"../components/PagesSections/Dashboard/UserDetails\";\nimport Navbar from \"../components/Navbar/Navbar\";\nimport {Redirect} from \"react-router\";\nimport {Button} from \"../components/Buttons/Button\";\n\nconst Dashboard = (props) => {\n\n    const {user, professorList, isHome, onChangeAuth} = props;\n\n    let dashboard;\n\n    user !== null ? dashboard=(<UserDetails user={user}/>) : dashboard=(<div> EFFETTUA IL LOGIN PER ACCEDERE </div>)\n    /*dashboard=(<Redirect to={'/login'} />) NON va bene perché effettua prima il redirect*/\n    return (\n        <>\n            <Navbar professorList={professorList} user={user} isHome={isHome}/>\n            {dashboard}\n            <Button onClick={onChangeAuth} />\n        </>\n    );\n}\n\nexport default Dashboard;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["173"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["174","175"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\n\n/* Complete data for facebook register */\n\nconst SignUpFb = (props) => {\n    const {userFb, onChangeUser} = props;\n\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [university, setUniversity] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\n            setTypeError('Empty');\n            setError(true);\n        }\n        else {\n            setTypeError('No Error');\n            setError(false);\n            return true;\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n\n        if(validation()){\n            try {\n                await ApiRegister(firstname, lastname, userFb.email, university);\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\n                * onChangeUser(user) */\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            displayError();\n        }\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                readOnly: true\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            defaultValue={userFb.email}\n                            aria-required=\"true\"\n                            variant=\"outlined\"\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"university\"\n                            id=\"outlined-textarea\"\n                            label=\"Università\"\n                            placeholder=\"Inserisci la tua università\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setUniversity(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\n                        </Button>\n                    </div>\n                    {error === false ? <Redirect\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpFb;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useMediaQuery.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Text/ExpandableParagraph.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorsList.js",["176"],"import {useEffect, useState} from 'react';\nimport {ApiProfessorsList} from \"../api\";\n\nconst useProfessorsList = () => {\n    const [state, setState] = useState(null);\n    const [isLoading, setLoading] = useState(true);\n\n    useEffect(() => {\n        if(state == null){\n            setProfessorsList();\n        }\n    }, []);\n\n    const setProfessorsList = async () => {\n        setLoading(true);\n        const professorsList = await ApiProfessorsList();\n\n        setState(professorsList);\n        setLoading(false);\n    };\n    return [state, isLoading];\n};\n\nexport default useProfessorsList;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/index.js",[],{"ruleId":"177","replacedBy":"178"},{"ruleId":"179","replacedBy":"180"},{"ruleId":"181","severity":1,"message":"182","line":12,"column":7,"nodeType":"183","messageId":"184","endLine":12,"endColumn":16},{"ruleId":"181","severity":1,"message":"185","line":28,"column":7,"nodeType":"183","messageId":"184","endLine":28,"endColumn":16},{"ruleId":"181","severity":1,"message":"186","line":19,"column":11,"nodeType":"183","messageId":"184","endLine":19,"endColumn":30},{"ruleId":"181","severity":1,"message":"187","line":9,"column":8,"nodeType":"183","messageId":"184","endLine":9,"endColumn":17},{"ruleId":"188","severity":1,"message":"189","line":14,"column":8,"nodeType":"190","endLine":14,"endColumn":21,"suggestions":"191"},{"ruleId":"181","severity":1,"message":"192","line":2,"column":8,"nodeType":"183","messageId":"184","endLine":2,"endColumn":14},{"ruleId":"177","replacedBy":"193"},{"ruleId":"179","replacedBy":"194"},{"ruleId":"177","replacedBy":"195"},{"ruleId":"179","replacedBy":"196"},{"ruleId":"197","severity":1,"message":"198","line":31,"column":9,"nodeType":"199","messageId":"200","endLine":31,"endColumn":17},{"ruleId":"181","severity":1,"message":"201","line":90,"column":15,"nodeType":"183","messageId":"184","endLine":90,"endColumn":18},{"ruleId":"202","severity":1,"message":"203","line":98,"column":1,"nodeType":"204","endLine":98,"endColumn":63},{"ruleId":"177","replacedBy":"205"},{"ruleId":"179","replacedBy":"206"},{"ruleId":"181","severity":1,"message":"207","line":7,"column":8,"nodeType":"183","messageId":"184","endLine":7,"endColumn":21},{"ruleId":"181","severity":1,"message":"208","line":15,"column":12,"nodeType":"183","messageId":"184","endLine":15,"endColumn":19},{"ruleId":"181","severity":1,"message":"209","line":4,"column":9,"nodeType":"183","messageId":"184","endLine":4,"endColumn":17},{"ruleId":"210","severity":1,"message":"211","line":10,"column":21,"nodeType":"212","endLine":10,"endColumn":119},{"ruleId":"181","severity":1,"message":"207","line":6,"column":8,"nodeType":"183","messageId":"184","endLine":6,"endColumn":21},{"ruleId":"181","severity":1,"message":"213","line":11,"column":20,"nodeType":"183","messageId":"184","endLine":11,"endColumn":32},{"ruleId":"188","severity":1,"message":"214","line":12,"column":8,"nodeType":"190","endLine":12,"endColumn":10,"suggestions":"215"},"no-native-reassign",["216"],"no-negated-in-lhs",["217"],"no-unused-vars","'getCookie' is assigned a value but never used.","Identifier","unusedVar","'setCookie' is assigned a value but never used.","'handleOpenLoginForm' is assigned a value but never used.","'SearchBar' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'setProfessor'. Either include it or remove the dependency array.","ArrayExpression",["218"],"'Navbar' is defined but never used.",["216"],["217"],["216"],["217"],"no-unreachable","Unreachable code.","ThrowStatement","unreachableCode","'res' is assigned a value but never used.","import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration",["216"],["217"],"'LoginFacebook' is defined but never used.","'loading' is assigned a value but never used.","'Redirect' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXOpeningElement","'onChangeUser' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'state'. Either include it or remove the dependency array.",["219"],"no-global-assign","no-unsafe-negation",{"desc":"220","fix":"221"},{"desc":"222","fix":"223"},"Update the dependencies array to be: [ProfessorId, setProfessor]",{"range":"224","text":"225"},"Update the dependencies array to be: [state]",{"range":"226","text":"227"},[353,366],"[ProfessorId, setProfessor]",[318,320],"[state]"]