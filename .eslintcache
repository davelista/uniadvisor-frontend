[{"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js":"1","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js":"2","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js":"3","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js":"4","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js":"5","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js":"6","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js":"7","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js":"8","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js":"9","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js":"10","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js":"11","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js":"12","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js":"13","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js":"14","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js":"15","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/Review.js":"16","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js":"17","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js":"18","/home/davide/Documenti/uni