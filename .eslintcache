unt":0},{"filePath":"323","messages":"324","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"325","messages":"326","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"327","messages":"328","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"329","messages":"330","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"331","messages":"332","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/context/AppContext.js",["333"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/index.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useAuth.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessorsList.js",["334"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",["335"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",["336"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/AddReview.js",["337","338"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["339","340","341","342","343"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["344","345","346","347"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["348","349","350"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["351"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["352","353"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport {Button} from \"../../Buttons/Button\";\nimport {ApiRegister} from \"../../../api\";\nimport {Redirect} from \"react-router\";\nimport LoginFacebook from \"./LoginFacebook\";\n\n/* Complete data for facebook register */\n\nconst SignUpFb = (props) => {\n    const {userFb, onChangeUser} = props;\n\n    const [firstname, setFirstname] = useState('');\n    const [lastname, setLastname] = useState('');\n    const [university, setUniversity] = useState('');\n\n    const [error, setError] = useState(true);\n    const [msgError, setMsgError] = useState('');\n    const [typeError, setTypeError] = useState('');\n\n    const displayError = () => {\n        switch (typeError) {\n            case 'Empty':\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\n                break;\n            default:\n                setMsgError('');\n                break;\n        }\n    }\n\n    const validation = () => {\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\n            setTypeError('Empty');\n            setError(true);\n        }\n        else {\n            setTypeError('No Error');\n            setError(false);\n            return true;\n        }\n    }\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n\n        if(validation()){\n            try {\n                await ApiRegister(firstname, lastname, userFb.email, university);\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\n                * onChangeUser(user) */\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            displayError();\n        }\n    }\n\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Registrati</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\n                    <div className={\"form-row\"}>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\",\n                                }}\n                                name=\"firstname\"\n                                id=\"outlined-textarea\"\n                                label=\"Nome\"\n                                placeholder=\"Inserisci il tuo nome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setFirstname(e.target.value)}\n                            />\n                        </div>\n                        <div className={\"form-input\"}>\n                            <TextField\n                                className={\"TextField\"}\n                                InputProps={{\n                                    className: \"TextField\"\n                                }}\n                                name=\"lastname\"\n                                id=\"outlined-textarea\"\n                                label=\"Cognome\"\n                                placeholder=\"Inserisci il tuo cognome\"\n                                variant=\"outlined\"\n                                aria-required=\"true\"\n                                onChange={e => setLastname(e.target.value)}\n                            />\n                        </div>\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                readOnly: true\n                            }}\n                            name=\"email\"\n                            id=\"outlined-textarea\"\n                            label=\"Email\"\n                            defaultValue={userFb.email}\n                            aria-required=\"true\"\n                            variant=\"outlined\"\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\"\n                            }}\n                            name=\"university\"\n                            id=\"outlined-textarea\"\n                            label=\"Università\"\n                            placeholder=\"Inserisci la tua università\"\n                            variant=\"outlined\"\n                            aria-required=\"true\"\n                            onChange={e => setUniversity(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\n                        </Button>\n                    </div>\n                    {error === false ? <Redirect\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\n                </form>\n            </div>\n        </>\n    );\n}\n\nexport default SignUpFb;",["354","355"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["356"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",["357","358","359","360","361","362","363","364","365"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/AddReview/AddReviewForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDashboard.js",["366"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["367","368","369"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useMediaQuery.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReviews.js",["370","371","372"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",["373","374"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend