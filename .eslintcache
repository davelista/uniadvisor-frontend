rorCount":0,"fixableWarningCount":0},{"filePath":"218","messages":"219","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"220","messages":"221","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"222","messages":"223","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\index.js",[],["224","225"],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\App.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\context\\AppContext.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\index.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\index.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useProfessorsList.js",["226"],"import {useEffect, useState} from 'react';\r\nimport {ApiProfessorsList} from \"../api\";\r\n\r\nconst useProfessorsList = () => {\r\n    const [state, setState] = useState(null);\r\n\r\n    useEffect(() => {\r\n        if(state == null){\r\n            setProfessorsList();\r\n        }\r\n    }, []);\r\n\r\n    const setProfessorsList = async () => {\r\n        const professorsList = await ApiProfessorsList();\r\n\r\n        setState(professorsList);\r\n    };\r\n    return state;\r\n};\r\n\r\nexport default useProfessorsList;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useProfessor.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Dashboard.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Home.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Professor.js",["227"],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\AddReview.js",["228","229"],"import React, { useContext, useEffect } from \"react\";\r\nimport { useParams } from \"react-router\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport AddReviewForm from \"../components/PagesSections/AddReview/AddReviewForm\";\r\nimport { AppContext } from \"../context/AppContext\";\r\n\r\nexport default function AddReview() {\r\n    const appData = useContext(AppContext);\r\n    const { professorId } = useParams();\r\n\r\n    useEffect(() => {\r\n        if (appData.professor.data?.id == professorId) return;  // non mettere \"===\" (id: number, professorId: string)\r\n        appData.professor.refresh(professorId);\r\n    }, [professorId])\r\n\r\n    const userDetails = appData.user.data !== null ? <div>USER DETAILS</div> : <div>EFFETTUA IL LOGIN PER ACCEDERE</div>;\r\n\r\n    return (\r\n        <>\r\n            <Navbar />\r\n            {userDetails}\r\n\r\n            {appData.professor.data !== null ? (\r\n                <AddReviewForm professor={appData.professor.data} />\r\n            ) : (\r\n                <div style={{ margin: \"200px\", display: \"flex\", justifyContent: \"center\" }}>LOADING PROFESSOR</div>\r\n            )}\r\n        </>\r\n    );\r\n}\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\Login.js",["230"],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\pages\\SignUp.js",["231"],"import React, {useContext, useState} from 'react';\r\nimport SignUpForm from \"../components/PagesSections/Login-SignUp/SignUpForm\";\r\nimport Navbar from \"../components/Navbar/Navbar\";\r\nimport SignUpFb from \"../components/PagesSections/Login-SignUp/SignUpFb\";\r\nimport { AppContext } from '../context/AppContext';\r\n\r\nconst SignUp = () => {\r\n    const appData = useContext(AppContext);\r\n\r\n    const [fbRegister, setFacebookRegister] = useState(false);\r\n    const [userFb, setUserFb] = useState();\r\n\r\n    let signUp;\r\n    !fbRegister ? signUp = (<SignUpForm onChangeUserFb={setUserFb} onChangeFb={setFacebookRegister}/>) :\r\n        signUp = <SignUpFb userFb={userFb} />\r\n\r\n    return (\r\n        <>\r\n            <Navbar user={''} />\r\n            {signUp}\r\n            </>\r\n    );\r\n}\r\n\r\nexport default SignUp;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Footer\\Footer.js",["232"],"import React from 'react'\r\nimport './Footer.css'\r\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\r\n\r\nfunction Footer() {\r\n    return (\r\n        <>\r\n            <div className=\"footer\">\r\n                <div className=\"info-footer\">\r\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\r\n                        Privacy Policy\r\n                    </a>\r\n                    <div className=\"text-footer\">\r\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\r\n                    </div>\r\n                </div>\r\n\r\n                <div className=\"socials-footer\">\r\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\r\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\r\n                    <FiMail class={'social-icon-bg social-icon'}/>\r\n                </div>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Footer;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Navbar\\Navbar.js",["233"],"import React, {useContext, useState} from 'react';\r\nimport {Link} from 'react-router-dom';\r\nimport logo from \"../../img/logo.svg\";\r\nimport './Navbar.css'\r\nimport '../Buttons/Button.css';\r\nimport {Button} from \"../Buttons/Button\";\r\nimport SearchBar from \"../SearchBar/SearchBar\";\r\nimport useMediaQuery, { Device } from '../../hooks/useMediaQuery';\r\nimport SearchIcon from '@material-ui/icons/Search';\r\nimport { AppContext } from '../../context/AppContext';\r\n\r\nconst Navbar = (props) => {\r\n\r\n    const { isHome = false} = props;\r\n\r\n    const appData = useContext(AppContext);\r\n\r\n    const [isOpenLoginForm, setOpenLoginForm] = useState(false);\r\n    const isMobile = useMediaQuery(Device.sm);\r\n    const [mobileSearchHidden, setMobileSearchHidden] = useState(true);\r\n\r\n    const handleOpenLoginForm = () => {\r\n        setOpenLoginForm(!isOpenLoginForm);\r\n    }\r\n\r\n    let button;\r\n    appData.user.data === null ? button = (\r\n            <Link to='/login' className=\"navbar-title\">\r\n                {/* <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button> */}\r\n                <Button buttonStyle='btn--outline'><h6 style={{color: \"white\"}}>{isMobile ? \"Accedi\" : \"Accedi/Registrati\"}</h6></Button>\r\n            </Link>\r\n        )\r\n        : button = (<Link to='/dashboard'><div>{appData.user.data.email}</div></Link>)\r\n\r\n    let search;\r\n    isHome === false && appData.professorsList !== null ? search=(<SearchBar professorsList={appData.professorsList} isHome={isHome}/>) : search=(<div></div>)\r\n\r\n    return (\r\n        <>\r\n            <div className=\"navbar\">\r\n                <Link to='/' className=\"navbar-title\">\r\n                    <img src={logo} className={'logo'} alt={logo}/>\r\n                </Link>\r\n                {isMobile ? <SearchIcon onClick={() => setMobileSearchHidden(value => !value)} /> : search}\r\n                {/* LOGIN POPUP\r\n                <div className=\"menu-content\">\r\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6 style={{color: \"white\"}}>Accedi/Registrati</h6></Button>\r\n                    {isOpenLoginForm &&\r\n                    <Popup titleText={'Login'} onClose={handleOpenLoginForm}>\r\n                        <Login onChangeUser={onChangeUser}/>\r\n                    </Popup>}\r\n                </div>*/}\r\n                {button}\r\n\r\n                {!mobileSearchHidden && isMobile && !isHome ? <div className=\"navbar-mobile-search\">{search}</div> : null}\r\n            </div>\r\n        </>\r\n    );\r\n\r\n}\r\n\r\nexport default Navbar;\r\n\r\n","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Buttons\\Button.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorDetails.js",["234"],"import React, {useState} from 'react';\r\nimport './Professor.css';\r\nimport imgUser from \"../../../img/user.jpg\";\r\n/*ICONS*/\r\n/*RATING*/\r\nimport FiberManualRecordIcon from '@material-ui/icons/FiberManualRecord';\r\nimport FiberManualRecordOutlinedIcon from '@material-ui/icons/FiberManualRecordOutlined';\r\nimport Rating from '@material-ui/lab/Rating';\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport EmailIcon from \"@material-ui/icons/Email\";\r\nimport WorkIcon from \"@material-ui/icons/Work\";\r\nimport BusinessIcon from \"@material-ui/icons/Business\";\r\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\r\nimport ProfessorCourse from \"./ProfessorCourse\";\r\nimport { Button } from '../../Buttons/Button';\r\nimport { Link } from 'react-router-dom';\r\nimport ProfessorReviews from \"./ProfessorReviews\";\r\n\r\nfunction ProfessorDetails(props) {\r\n    const {professor} = props;\r\n    const [courseId, setCouseId] = useState(0);\r\n\r\n    // let image;\r\n    // professorImg === \"Image Not Found\" ? image = (\r\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={imgUser}/>) : image = (\r\n    //     <img src={professorImg.data} className={\"professor-img\"} alt={professorImg}/>)\r\n\r\n    return (\r\n        <>\r\n            <div className={\"professor-card\"}>\r\n                <img\r\n                    src={\"/api/professor_image/\" + professor.id}\r\n                    className={\"professor-img\"}\r\n                    alt={`${professor.nome} ${professor.cognome}`}\r\n                />\r\n                <div className=\"professor-detail\">\r\n                    <div className=\"professor-title\">\r\n                        <h1>\r\n                            {professor.nome} {professor.cognome}\r\n                        </h1>\r\n                        {console.log(professor.metrics.overall)}\r\n                        <div className={\"bubble-rating\"}>\r\n                            <Rating\r\n                                name=\"half-rating-read\"\r\n                                defaultValue={professor.metrics.overall}\r\n                                precision={0.5}\r\n                                readOnly\r\n                                emptyIcon={\r\n                                    <FiberManualRecordOutlinedIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />\r\n                                }\r\n                                icon={<FiberManualRecordIcon fontSize=\"large\" style={{ fill: \"#e53a1e\" }} />}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"professor-university-section\">\r\n                        <div className=\"professor-info\">\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <AccountBalanceIcon\r\n                                            fontSize=\"small\"\r\n                                            style={{\r\n                                                fill: \"#e53a1e\",\r\n                                                marginRight: \"3%\",\r\n                                            }}\r\n                                        />\r\n                                        <h3 style={{ color: \"#e53a1e\" }}>{x.name}</h3>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <EmailIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{professor.email}</p>\r\n                                    </div>\r\n                                ); /*cambiare professor.email con x.email quando cambieranno json*/\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <WorkIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{x.contratto}</p>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                            {professor.university.map((x) => {\r\n                                return (\r\n                                    <div className={\"professor-info-row\"}>\r\n                                        <BusinessIcon fontSize=\"small\" style={{ marginRight: \"3%\" }} />\r\n                                        <p>{x.dipartimento}</p>\r\n                                    </div>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {console.log(professor.metrics)}\r\n                        <ProfessorEvaluation finalEvaluation={professor.metrics} />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className={\"professor-title-courses\"}>\r\n                {professor.corsi.map((course, i) => (\r\n                    <h4\r\n                        className={\"course-title-button\"}\r\n                        onClick={() => {\r\n                            setCouseId(i);\r\n                        }}\r\n                        style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\r\n                    >\r\n                        {course.name}\r\n                    </h4>\r\n                ))}\r\n                {/* {professor.corsi.map((x, i) => {\r\n                    return Object.entries(x)\r\n                        .filter(([key, value]) => key === \"name\")\r\n                        .map(([key, value]) => {\r\n                            return (\r\n                                <h4\r\n                                    className={\"course-title-button\"}\r\n                                    onClick={() => {\r\n                                        setCouseId(i);\r\n                                    }}\r\n                                    style={{ color: courseId === i ? \"#e53a1e\" : \"#c9c9c9\" }}\r\n                                >\r\n                                    {value}\r\n                                </h4>\r\n                            );\r\n                        });\r\n                })} */}\r\n            </div>\r\n\r\n            <div className={\"professor-courses\"}>\r\n                <div className=\"course-details-section\">\r\n                    {professor.corsi.map((x, i) => {\r\n                        return (\r\n                            <div className={\"course-info-section\"}>\r\n                                {courseId === i ? <ProfessorCourse course={x} /> : null}\r\n                            </div>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </div>\r\n\r\n            <div className={\"reviews-section\"}>\r\n                <div className={\"reviews-section-title\"}>\r\n                    <h2>Leggi le recensioni</h2>\r\n                    <Link to={\"/add-review/professors/\" + professor.id}>\r\n                        <Button buttonStyle=\"btn--outline\">\r\n                            <h6 style={{ color: \"white\" }}>Scrivi una recensione</h6>\r\n                        </Button>\r\n                    </Link>\r\n                </div>\r\n                <ProfessorReviews professor={professor} icourse={courseId} />\r\n            </div>\r\n\r\n            {console.log(professor)}\r\n        </>\r\n    );\r\n}\r\n\r\nexport default ProfessorDetails;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\AddReview\\AddReviewForm.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Dashboard\\UserDetails.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\LoginForm.js",["235","236","237","238"],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\SignUpForm.js",["239","240","241"],"import React, {useState} from 'react';\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport {Button} from \"../../Buttons/Button\";\r\nimport {ApiRegister} from \"../../../api\";\r\nimport {Redirect} from \"react-router\";\r\nimport LoginFacebook from \"./LoginFacebook\";\r\n\r\nconst SignUpForm = (props) => {\r\n    const {onChangeUserFb, onChangeFb} = props;\r\n\r\n    const [firstname, setFirstname] = useState('');\r\n    const [lastname, setLastname] = useState('');\r\n    const [email, setEmail] = useState('');\r\n    const [university, setUniversity] = useState('');\r\n    const [password, setPassword] = useState('');\r\n    const [passwordControl, setPasswordControl] = useState('');\r\n\r\n    const [error, setError] = useState(true);\r\n    const [msgError, setMsgError] = useState('');\r\n    const [typeError, setTypeError] = useState('');\r\n    const [done, setDone] = useState(false);\r\n\r\n\r\n    const displayError = () => {\r\n        switch (typeError) {\r\n            case 'Empty':\r\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\r\n                break;\r\n            case 'Different passwords':\r\n                setMsgError(\"ATTENZIONE, le password non coincidono\");\r\n                break;\r\n            case 'Invalid email':\r\n                setMsgError(\"ATTENZIONE, la mail non è valida\");\r\n                break;\r\n            case 'Short Password':\r\n                setMsgError(\"ATTENZIONE, la password è troppo corta\");\r\n                break;\r\n            case 'Already registered':\r\n                setMsgError(\"ATTENZIONE, utente già registrato\");\r\n                break;\r\n            default:\r\n                setMsgError('');\r\n                break;\r\n        }\r\n    }\r\n\r\n    const validation = () => {\r\n\r\n        if (firstname.length < 1 || lastname.length < 1 || email.length < 1 || university.length < 1 || password.length < 1 || passwordControl.length < 1) {\r\n            setTypeError('Empty');\r\n            setError(true);\r\n        } else if (!email.includes('@')) {\r\n            setTypeError('Invalid email');\r\n            setError(true);\r\n        } else if (password.length < 8) {\r\n            setTypeError('Short Password');\r\n            setError(true);\r\n        } else if (password !== passwordControl) {\r\n            setTypeError('Different passwords');\r\n            setError(true);\r\n        } else {\r\n            setTypeError('No Error');\r\n            setError(false);\r\n        }\r\n    }\r\n\r\n    const handleSubmit = async (e) => {\r\n        if (e) e.preventDefault();\r\n        if (!error) {\r\n            try {\r\n                let res = await ApiRegister(firstname, lastname, email, password, university, \"Unihub\", null);\r\n\r\n                switch (res.data) {\r\n                    case \"OK\":\r\n                        setDone(true);\r\n                        break;\r\n                    case \"Already registered\":\r\n                        break;\r\n                    default:\r\n                        break;\r\n                }\r\n            } catch (e) {\r\n                throw e;\r\n            }\r\n\r\n        }\r\n        displayError();\r\n    }\r\n\r\n\r\n    return (\r\n        <>\r\n            <div className={\"login-title-container\"}>\r\n                <div className={\"title-red\"}>Registrati</div>\r\n            </div>\r\n            <div className={\"form-container\"}>\r\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"firstname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Nome\"\r\n                                placeholder=\"Inserisci il tuo nome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setFirstname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\"\r\n                                }}\r\n                                name=\"lastname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Cognome\"\r\n                                placeholder=\"Inserisci il tuo cognome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setLastname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"email\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Email\"\r\n                            placeholder=\"Inserisci la tua email\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setEmail(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"university\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Università\"\r\n                            placeholder=\"Inserisci la tua università\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setUniversity(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"password\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Password\"\r\n                                placeholder=\"Inserisci la tua password\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                type=\"password\"\r\n                                onChange={e => setPassword(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"passwordControl\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Conferma Password\"\r\n                                placeholder=\"Inserisci di nuovo la tua password\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                type=\"password\"\r\n                                onChange={e => setPasswordControl(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\r\n                            style={{color: \"white\"}}>Registrati</h6>\r\n                        </Button>\r\n                    </div>\r\n                    {done ? <Redirect\r\n                            to=\"/login\"/> :\r\n                        <div>{msgError}</div>} {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\r\n                    {/*<div>\r\n                        oppure registrati con\r\n                    </div>\r\n                    <LoginFacebook onChangeUserFb={onChangeUserFb} onChangeFb={onChangeFb}/>*/}\r\n                </form>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default SignUpForm;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutArea.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\SignUpFb.js",["242","243"],"import React, {useState} from 'react';\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport {Button} from \"../../Buttons/Button\";\r\nimport {ApiRegister} from \"../../../api\";\r\nimport {Redirect} from \"react-router\";\r\nimport LoginFacebook from \"./LoginFacebook\";\r\n\r\n/* Complete data for facebook register */\r\n\r\nconst SignUpFb = (props) => {\r\n    const {userFb, onChangeUser} = props;\r\n\r\n    const [firstname, setFirstname] = useState('');\r\n    const [lastname, setLastname] = useState('');\r\n    const [university, setUniversity] = useState('');\r\n\r\n    const [error, setError] = useState(true);\r\n    const [msgError, setMsgError] = useState('');\r\n    const [typeError, setTypeError] = useState('');\r\n\r\n    const displayError = () => {\r\n        switch (typeError) {\r\n            case 'Empty':\r\n                setMsgError(\"ATTENZIONE, compilare tutti i campi\");\r\n                break;\r\n            default:\r\n                setMsgError('');\r\n                break;\r\n        }\r\n    }\r\n\r\n    const validation = () => {\r\n        if(firstname.length < 1 || lastname.length < 1 || university.length < 1){\r\n            setTypeError('Empty');\r\n            setError(true);\r\n        }\r\n        else {\r\n            setTypeError('No Error');\r\n            setError(false);\r\n            return true;\r\n        }\r\n    }\r\n\r\n    const handleSubmit = async (e) => {\r\n        e.preventDefault();\r\n\r\n        if(validation()){\r\n            try {\r\n                await ApiRegister(firstname, lastname, userFb.email, university);\r\n                /* Se mi ritorna codice 200/user allora setto l'user altrimenti messaggio d'errore\r\n                * onChangeUser(user) */\r\n            } catch (e) {\r\n                throw e;\r\n            }\r\n        } else {\r\n            displayError();\r\n        }\r\n    }\r\n\r\n\r\n    return (\r\n        <>\r\n            <div className={\"login-title-container\"}>\r\n                <div className={\"title-red\"}>Registrati</div>\r\n            </div>\r\n            <div className={\"form-container\"}>\r\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={handleSubmit}>\r\n                    <div className={\"form-row\"}>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\",\r\n                                }}\r\n                                name=\"firstname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Nome\"\r\n                                placeholder=\"Inserisci il tuo nome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setFirstname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                        <div className={\"form-input\"}>\r\n                            <TextField\r\n                                className={\"TextField\"}\r\n                                InputProps={{\r\n                                    className: \"TextField\"\r\n                                }}\r\n                                name=\"lastname\"\r\n                                id=\"outlined-textarea\"\r\n                                label=\"Cognome\"\r\n                                placeholder=\"Inserisci il tuo cognome\"\r\n                                variant=\"outlined\"\r\n                                aria-required=\"true\"\r\n                                onChange={e => setLastname(e.target.value)}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\",\r\n                                readOnly: true\r\n                            }}\r\n                            name=\"email\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Email\"\r\n                            defaultValue={userFb.email}\r\n                            aria-required=\"true\"\r\n                            variant=\"outlined\"\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <TextField\r\n                            className={\"TextField\"}\r\n                            InputProps={{\r\n                                className: \"TextField\"\r\n                            }}\r\n                            name=\"university\"\r\n                            id=\"outlined-textarea\"\r\n                            label=\"Università\"\r\n                            placeholder=\"Inserisci la tua università\"\r\n                            variant=\"outlined\"\r\n                            aria-required=\"true\"\r\n                            onChange={e => setUniversity(e.target.value)}\r\n                        />\r\n                    </div>\r\n                    <div className={\"form-input\"}>\r\n                        <Button buttonStyle='btn--outline' type=\"submit\" onClick={validation}><h6\r\n                            style={{color: \"white\"}}>Completa la registrazione</h6>\r\n                        </Button>\r\n                    </div>\r\n                    {error === false ? <Redirect\r\n                            to=\"/dashboard\"/> : <div>{msgError}</div> } {/*Una volta che ha mandato i dati, viene reindirizzato a login*/}\r\n                </form>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default SignUpFb;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\HeroSection\\HeroSection.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\api\\index.js",["244","245","246"],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\University\\UniveristyArea.js",["247"],"import React from 'react'\r\nimport './UniversityArea.css'\r\nimport imgPolimi from \"../../../../img/polimi.jpg\";\r\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\r\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\r\nimport imgPolito from \"../../../../img/polito.jpg\";\r\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\r\nimport imgStatale from \"../../../../img/statale.jpg\";\r\nimport SearchBar from \"../../../SearchBar/SearchBar\";\r\n\r\n\r\nfunction UniversitySection() {\r\n\r\n    return (\r\n        <>\r\n            <div className=\"uni-container\">\r\n                <div className=\"uni-title\">\r\n                    <h1>Le Università</h1>\r\n                    {/*da inserire university searchbar*/}\r\n                </div>\r\n\r\n                Verifica che la tua universitá sia tra quelle disponibili.\r\n                <div className=\"wrap\">\r\n                    <div className=\"item-wrap\">\r\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"wrap\">\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"item-wrap item-muted\">\r\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\r\n                        <div className=\"middle\">\r\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n            </div>\r\n        </>\r\n)\r\n}\r\n\r\nexport default UniversitySection;","C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useMediaQuery.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\AddReview\\AddReviewFormSection.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorEvaluation.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\AddReview\\useAddReviewForm.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\SearchBar\\SearchBar.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutItems.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Login-SignUp\\LoginFacebook.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorCourse.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Homepage\\About\\AboutData.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\SearchBar\\SearchBarResult.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\PagesSections\\Professor\\ProfessorReviews.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useProfessorReviews.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Text\\ExpandableParagraph.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\hooks\\useAuth.js",[],"C:\\Users\\david\\dev\\repos\\uniadvisor-frontend\\src\\components\\Forms\\FormText