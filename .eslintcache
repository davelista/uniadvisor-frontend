olimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["130"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",["131"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],["132","133"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["134","135"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],["136","137"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Login.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/SignUp.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginForm.js",["138","139"],"import React, {useState} from 'react';\nimport TextField from \"@material-ui/core/TextField\";\nimport './Login.css'\nimport {Button} from \"../../Buttons/Button\";\nimport {Link} from \"react-router-dom\";\nimport {ApiLogin} from \"../../../api\";\nimport LoginFacebook from \"./LoginFacebook\";\n\nconst LoginForm = (props) => {\n    const {onChangeUser, onChangeError} = props;\n\n\n    const [email, setEmail] = useState('');\n    const [password, setPassword] = useState('');\n    const [loading, setLoading] = useState(false);\n    const [done, setDone] = useState(false);\n    const [error, setError] = useState('');\n\n    let result;\n    const submit = async (e) => {\n        e.preventDefault();\n\n        if (email !== '' && password !== '') {\n            try {\n                result = await ApiLogin(email, password);\n                //console.log(result);\n                setLoading(!loading);\n                if (result !== null) {\n                    console.log(result);\n                    setDone(true);\n                    onChangeError(false);\n                } else onChangeError(true)\n                setDone(!done);\n                onChangeUser(email);\n                setLoading(!loading);\n            } catch (e) {\n                throw e;\n            }\n        } else {\n            onChangeError(\"ERRORE! I campi sono vuoti\")\n        }\n    }\n\n    return (\n        <>\n            <div className={\"login-title-container\"}>\n                <div className={\"title-red\"}>Login</div>\n            </div>\n            <div className={\"form-container\"}>\n                <form className={\"login-form\"} noValidate autoComplete=\"off\" onSubmit={submit}>\n                    <div className={\"form-input\"}>\n\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Username\"\n                            placeholder=\"Inserisci la tua mail\"\n                            variant=\"outlined\"\n                            type=\"email\"\n                            onChange={e => setEmail(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <TextField\n                            className={\"TextField\"}\n                            InputProps={{\n                                className: \"TextField\",\n                                autoFocus: true\n                            }}\n                            id=\"outlined-textarea\"\n                            label=\"Password\"\n                            placeholder=\"Inserisci la tua password\"\n                            variant=\"outlined\"\n                            type=\"password\"\n                            onChange={e => setPassword(e.target.value)}\n                        />\n                    </div>\n                    <div className={\"form-input\"}>\n                        <Button buttonStyle='btn--outline' type=\"submit\"><h6 style={{color: \"white\"}}>Accedi</h6>\n                        </Button>\n                    </div>\n                    {/*<FormControlLabel\n                        value=\"ricordami\"\n                        control={<Checkbox color=\"primary\" />}\n                        label=\"Ricordami\"\n                        labelPlacement=\"end\"\n                    />*/}\n                    <div>\n                        oppure\n                    </div>\n                    <LoginFacebook onChangeUser={onChangeUser}/>\n                </form>\n\n\n            </div>\n            <div className={\"register-option-container\"}>\n                <div className={\"register-option-text\"}>\n                    Non hai ancora un account?\n                </div>\n                <div className={\"register-option-button\"}>\n                    <Link to='/sign-up'>\n                        <Button buttonStyle='btn--outline--white'>\n                            <h6>Registrati</h6>\n                        </Button>\n                    </Link>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default LoginForm;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpForm.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/LoginFacebook.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Dashboard.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Footer/Footer.js",["140"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Login-SignUp/SignUpFb.js",["141","142"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorReview.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Dashboard/UserDetails.js",[],{"ruleId":"143","replacedBy":"144"},{"ruleId":"145","replacedBy":"146"},{"ruleId":"147","severity":1,"message":"148","line":14,"column":9,"nodeType":"149","messageId":"150","endLine":14,"endColumn":17},{"ruleId":"147","severity":1,"message":"151","line":16,"column":7,"nodeType":"149","messageId":"150","endLine":16,"endColumn":16},{"ruleId":"147","severity":1,"message":"152","line":14,"column":11,"nodeType":"149","messageId":"150","endLine":14,"endColumn":30},{"ruleId":"147","severity":1,"message":"153","line":9,"column":8,"nodeType":"149","messageId":"150","endLine":9,"endColumn":17},{"ruleId":"154","severity":1,"message":"155","line":10,"column":8,"nodeType":"156","endLine":10,"endColumn":18,"suggestions":"157"},{"ruleId":"147","severity":1,"message":"158","line":2,"column":8,"nodeType":"149","messageId":"150","endLine":2,"endColumn":14},{"ruleId":"143","replacedBy":"159"},{"ruleId":"145","replacedBy":"160"},{"ruleId":"147","severity":1,"message":"161","line":75,"column":15,"nodeType":"149","messageId":"150","endLine":75,"endColumn":18},{"ruleId":"162","