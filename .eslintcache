leErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"84","messages":"85","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"90","usedDeprecatedRules":"46"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"93"},"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/index.js",[],["94","95"],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/App.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Home.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/pages/Professor.js",["96","97","98","99"],"import React, {useState, useEffect} from 'react';\nimport ProfessorDetails from \"../components/PagesSections/Professor/ProfessorDetails\";\nimport {useParams} from \"react-router\";\nimport useProfessor from \"../hooks/useProfessor\";\nimport Popup from \"../components/Popup/Popup\";\n\nfunction Professor(props) {\n    let { endpoint } = useParams();\n    let [professor, isLoading] = useProfessor(endpoint);\n    const [showPopup, setShowPopup] = useState(false)\n    const [isFirst, setIsFirst] = useState(true);\n    const {professorList, onChangeProfessor, isHome} = props;\n\n    const showPopupFunction = () => {\n        setShowPopup(!showPopup);\n        setIsFirst(false);\n    };\n\n    const TitlePopup = (props) => {\n        const {titleText, onClose} = props;\n        return (\n            <div className={'title-popup'}>\n                <div className={'title-text'}>{titleText}</div>\n                <div className={'close-button'} onClick={onClose}>X</div>\n            </div>\n        )\n    }\n\n    useEffect(() => {\n        const timer = setTimeout(() => {\n            if (isFirst) {\n                setShowPopup(true);\n            }\n        }, 3000);\n        return () => clearTimeout(timer);\n    }, [showPopup]);\n\n    const getContent = () => {\n        if(!isLoading){\n            return (\n                <React.Fragment>\n                    <ProfessorDetails professorList={professorList} onChangeProfessor={onChangeProfessor} isHome={isHome} professor={professor}/>\n                </React.Fragment>\n            );\n        }\n    }\n\n    return (\n        <div>\n            {getContent()}\n        </div>\n    )\n\n}\nexport default Professor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Navbar/Navbar.js",["100"],"import React, {useState} from 'react';\nimport {Link} from 'react-router-dom';\nimport logo from \"../../img/logo.svg\";\nimport './Navbar.css'\nimport '../Buttons/Button.css';\nimport {Button} from \"../Buttons/Button\";\nimport Popup from \"../Popup/Popup\";\nimport {ApiMail} from \"../../api\";\n\nfunction Navbar() {\n\n    const [email, setEmail] = useState();\n    const [loading, setLoading] = useState (false); //loading è fondamentale per l'invio delle informazioni dal popup\n\n    const TitlePopup = (props) => {\n        const {titleText, onClose} = props;\n        return (\n            <div className={'title-popup'}>\n                <div className={'title-text'}>{titleText}</div>\n                <div className={'close-button'} onClick={onClose}>X</div>\n            </div>\n        )\n    }\n\n    const [isOpenLoginForm, setOpenLoginForm] = React.useState(false);\n\n    const handleOpenLoginForm = () => {\n        setOpenLoginForm(!isOpenLoginForm);\n    }\n    const sendMail = async (email) => {\n        setLoading(true);\n        try {\n            await ApiMail(email);\n        } catch (e) {\n            throw e;\n        }\n        setLoading(false);\n    };\n\n    const handleSubmit = (e) => {\n        e.preventDefault();\n        //console.log(\"la userMail è\" + email);\n        sendMail(email);\n    }\n\n    return (\n        <>\n            <div className=\"navbar\">\n                <Link to='/' className=\"navbar-title\">\n                    <img src={logo} className={'logo'} alt={logo}/>\n                </Link>\n                <div className=\"menu-content\">\n                    <Button buttonStyle='btn--outline' onClick={handleOpenLoginForm}><h6>Accedi/Registrati</h6></Button>\n                    {isOpenLoginForm && <Popup onSubmit={handleSubmit}>\n                        <div className={'form-content'}>\n                            <TitlePopup titleText={'Siamo spiacenti!'} onClose={handleOpenLoginForm}/>\n                            <p>Il sito è in fase di manutenzione e questa funzione non è al momento disponibile.</p>\n                            <p>Ti chiediamo di lasciarci la mail in modo da poterti avvisare quando è pronto</p>\n                            <input\n                                className={\"form-input\"}\n                                placeholder=\"Mail\"\n                                onChange={e => setEmail(e.target.value)}\n                                required\n                                value={email}\n                            />\n                            <div className={'form-buttons'}>\n                                <button className={'send-button'} onClick={handleSubmit}>Invia</button>\n                            </div>\n                        </div>\n                    </Popup>}\n                </div>\n            </div>\n        </>\n    );\n\n}\n\nexport default Navbar;\n\n","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/Footer.js",["101"],"import React from 'react'\nimport './Footer.css'\nimport {FiMail, RiFacebookFill, RiInstagramLine} from \"react-icons/all\";\n\nfunction Footer() {\n    return (\n        <>\n            <div className=\"footer\">\n                <div className=\"info-footer\">\n                    <a href='https://www.iubenda.com/privacy-policy/250198' target=\"_blank\" className={\"link-footer\"}>\n                        Privacy Policy\n                    </a>\n                    <div className=\"text-footer\">\n                        &#169; Copyright uniadvisor.it. All Rights Reserved.\n                    </div>\n                </div>\n\n                <div className=\"socials-footer\">\n                    <RiInstagramLine class={'social-icon social-icon-bg'}/>\n                    <RiFacebookFill class={'social-icon social-icon-bg'}/>\n                    <FiMail class={'social-icon-bg social-icon'}/>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default Footer;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutArea.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/HeroSection/HeroSection.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/University/UniveristyArea.js",["102"],"import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../../img/polito.jpg\";\nimport imgSapienza from \"../../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../../img/statale.jpg\";\nimport SearchBar from \"../../../SearchBar/SearchBar\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"uni-title\">\n                    <h1>Le Università</h1>\n                    {/*da inserire university searchbar*/}\n                </div>\n\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">Politecnico di  <br/> Milano</div>\n                        </div>\n                    </div>\n\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgBocconi} className={'image'} alt={imgBocconi}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università Bocconi</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgCattolica} className={'image'} alt={imgCattolica}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/>  Università Cattolica del Sacro Cuore</div>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"wrap\">\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgStatale} className={'image'} alt={imgStatale}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Università degli studi di Milano Statale</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgPolito} className={'image'} alt={imgPolito}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> Politecnico di  <br/>Torino</div>\n                        </div>\n                    </div>\n                    <div className=\"item-wrap item-muted\">\n                        <img src={imgSapienza} className={'image'} alt={imgSapienza}/>\n                        <div className=\"middle\">\n                            <div className=\"cards-overlay\">COMING SOON <hr/> La Sapienza</div>\n                        </div>\n                    </div>\n                </div>\n\n\n            </div>\n        </>\n)\n}\n\nexport default UniversitySection;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/hooks/useProfessor.js",["103"],"import {useEffect, useState} from 'react';\nimport {ApiProfessor} from \"../api\";\n\nconst useProfessor = (endpoint) => {\n    const [state, setState] = useState();\n    const [isLoading, setLoading] = useState(true);\n    useEffect(() => {\n        setProfessor();\n    }, [endpoint]);\n\n    const setProfessor = async () => {\n        setLoading(true);\n        const professorEndpoint = endpoint ? endpoint : undefined\n        if (professorEndpoint != null) {\n            console.log(\"endpoint = \" + professorEndpoint);\n            const selectedProfessor = await ApiProfessor(professorEndpoint);\n            console.log(\"answer new stringify\" + JSON.stringify(selectedProfessor));\n            setState(selectedProfessor);\n            setLoading(false);\n        }\n\n    };\n    if (state != null) {\n        console.log(\"ho settato il json con; \", state)\n    }\n    return [state, isLoading, setProfessor];\n};\n\nexport default useProfessor;","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorDetails.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Popup/Popup.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutData.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Homepage/About/AboutItems.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/Buttons/Button.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBar.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/Review.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorEvaluation.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/PagesSections/Professor/ProfessorCourse.js",[],"/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/api/index.js",["104"],"import axios from \"axios\";\n\nexport const ApiProfessor = async (professorEndpoint) => {\n    try{\n        const res = await axios.get(\"/api/professors/\"+professorEndpoint);\n        return res.data;\n    } catch (e){\n        throw e;\n    }\n\n};\nexport const ApiMail = async (email) => {\n    try{\n        const res = await axios.post(\"/api/email\", {email})\n            .then(response => {\n                console.log(response)\n            })\n            .catch(error => {\n                console.log(error)\n            });\n\n        return res.data;\n    } catch (e) {\n        throw e;\n    }\n\n\n};\n\nexport default {ApiProfessor, ApiMail};","/home/davide/Documenti/unihub/uniadvisor/uniadvisor-frontend/src/components/SearchBar/SearchBarResult.js",[],["105","106"],{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","replacedBy":"110"},{"ruleId":"111","severity":1,"message":"112","line":5,"column":8,"nodeType":"113","messageId":"114","endLine":5,"endColumn":13},{"ruleId":"111","severity":1,"message":"115","line":14,"column":11,"nodeType":"113","messageId":"114","endLine":14,"endColumn":28},{"ruleId":"111","severity":1,"message":"116","line":19,"column":11,"nod