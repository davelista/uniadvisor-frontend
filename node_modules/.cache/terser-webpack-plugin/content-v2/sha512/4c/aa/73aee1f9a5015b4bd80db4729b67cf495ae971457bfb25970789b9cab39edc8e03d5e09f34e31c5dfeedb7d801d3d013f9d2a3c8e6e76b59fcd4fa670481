essorList={professorList} onChangeProfessor={onChangeProfessor} professor={professor}/>\n                <AboutArea/>\n                <UniversitySection/>\n                <Footer/>\n            </div>\n\n        </>\n    );\n}\n\nexport default Home;","import React from 'react';\n\n\nfunction NotFoundPage() {\n    return (\n        <>\n            <div>\n                ERROR 404\n            </div>\n\n        </>\n    );\n}\n\nexport default NotFoundPage;","export default \"data:image/jpeg;base64,\"","import React from 'react';\nimport './ProfessorDetails.css';\n\nfunction ProfessorEvaluation(props) {\n    const {finalEvaluation} = props;\n\n\n    return (\n        <>\n            <div className={\"professor-evaluation-container\"}>\n                    {finalEvaluation.map((x) => {\n                        return (<div className={\"professor-evaluation\"}>\n                         <p>{x.title}: {'\\t'&& Math.round(x.value)}</p>\n                        </div>)\n                    })}\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorEvaluation;","import React from 'react';\nimport './ProfessorDetails.css';\n\n\nfunction Review(props) {\n    const {review} = props\n    return (\n        <>\n            <div className={\"review-container\"}>\n                <div className={\"review-title\"}>\n                    <div>A.A. {review.year} </div>\n                    <div className={\"review-evaluation\"}>\n                        <h3>Valutazione professore:</h3> <br/>\n                        {review.metrics.professor.map((x) => {\n                            return <p>{x.title} {x.value}</p>\n                        })}\n\n                        <h3>Valutazione corso:</h3> <br/>\n                        {review.metrics.course.map((x) => {\n                            return <p>{x.title} {x.value}</p>\n                        })}\n                    </div>\n                    <div className={\"review-body\"}>\n                        {review.body}\n                    </div>\n                </div>\n\n            </div>\n\n        </>\n    );\n}\n\nexport default Review;","import React from 'react';\nimport './ProfessorDetails.css';\n\n\nfunction ProfessorCourse(props) {\n    const {course} = props\n\n\n    return (\n        <>\n            <div className={\"course-details\"}>\n                <div>A.A.: {course.years}</div>\n                <div>CFU: {course.cfu}</div>\n                <div>{course.schoolYear} Anno</div>\n                <div>Lingua: {course.language}</div>\n                <div>Semestre: {course.semester}</div>\n                <div>Luogo: {course.location}</div>\n                <div>SSD: {course.ssd}</div>\n\n            </div>\n        </>\n    );\n}\n\nexport default ProfessorCourse;","import React, {useState} from 'react';\nimport Navbar from \"../Homepage/Header/Navbar\";\nimport './ProfessorDetails.css';\nimport imgUser from \"../../img/user.jpg\";\nimport ProfessorEvaluation from \"./ProfessorEvaluation\";\nimport Review from \"./Review\";\nimport ProfessorCourse from \"./ProfessorCourse\";\n\nfunction ProfessorDetails(props) {\n    const {professor, professorList, onChangeProfessor, isHome} = props;\n    const [courseId, setCouseId] = useState(1);\n\n    return (\n        <>\n            <Navbar professorList={professorList} onChangeProfessor={onChangeProfessor} isHome={isHome}/>\n            <div className=\"professor-container\">\n                {/*informazioni del professore - nome, email, università, contratto, dipartimento, valutazioni*/}\n                <div className={\"professor-first-content\"}>\n                    <div className={\"professor-card\"}>\n                        <img src={imgUser} className={'image-user'} alt={imgUser}/>\n                        <div className={\"professor-detail\"}>\n                            <h2>{professor.name}</h2>\n                            <p>{professor.email}</p>\n                            {professor.university.map((x) => {\n                                return <p>{x.name}</p>\n                            })}\n                            {professor.university.map((x) => {\n                                return <p>{x.typeContract}</p>\n                            })}\n                            {professor.university.map((x) => {\n                                return <p>{x.department}</p>\n                            })}\n\n                        </div>\n                        <ProfessorEvaluation finalEvaluation={professor.finalEvaluation}/>\n                    </div>\n                </div>\n\n                <div className=\"professor-second-content\">\n                    {professor.university.map((university) => {\n                            return university.courses.map((course) => {\n                                return (<div className={\"course-container\"}>\n                                        <h3  className={\"course-title\"} onClick={() => setCouseId(course.id)}>{course.name}</h3>\n                                    {courseId===course.id ? <ProfessorCourse course={course}/> : null }\n                                </div>)\n                            })\n                        }\n                    )}\n                </div>\n\n                <div className={\"professor-third-content\"}>\n                    {professor.oldReview.map((x) => {\n                        return <Review review={x}/>\n                    })}\n                </div>\n            </div>\n\n        </>\n    );\n}\n\nexport default ProfessorDetails;","import React from 'react';\nimport ProfessorDetails from \"../components/Professor/ProfessorDetails\";\n\nfunction Professor(props) {\n    const {professor, professorList, onChangeProfessor, isHome} = props;\n\n    return (\n\n            <div>\n                <ProfessorDetails professorList={professorList} onChangeProfessor={onChangeProfessor} isHome={isHome} professor={professor}/>\n            </div>\n    );\n}\n\nexport default Professor;","import axios from \"axios\";\n\nexport const ApiProfessor = async (professorEndpoint) => {\n    try{\n        const res = await axios.get(\"/api/professors/\" + professorEndpoint);\n        return res.data;\n    } catch (e){\n        throw e;\n    }\n\n};\n\nexport default {ApiProfessor};","import {useState, useEffect} from 'react';\nimport {ApiProfessor} from \"../api\";\n\nconst useProfessor = () => {\n    const [state, setState] = useState(null);\n    useEffect(() => {\n        setProfessor();\n    },[]);\n\n    const setProfessor = async (professorEndpoint) => {\n\n        const professor = await ApiProfessor(professorEndpoint);\n        setState(professor);\n    };\n    return [state, setProfessor];\n};\n\nexport default useProfessor;","import React, {useEffect, useState} from 'react'\nimport './App.css';\nimport {BrowserRouter as Router, Switch, Route, Redirect} from \"react-router-dom\";\nimport professorList from './json/professorsList.json'\n//Pages\nimport Home from './pages/Home.js'\nimport NotFoundPage from './pages/404'\nimport Professor from \"./pages/Professor\";\n//hooks\nimport useProfessor from \"./hooks/useProfessor\";\nimport {ApiProfessor} from \"./api\";\nimport axios from \"axios\";\n\nfunction App() {\n\n  let [professor, setProfessor] = useState();\n  useEffect(() => {\n      axios.get(\"/api/professors/\" + professor)\n          .then(res => setProfessor(res))\n  });\n  console.log(professr)\n\n  return (\n      <Router>\n        <Switch>\n          <Route path='/' exact component={() => <Home professorList={professorList} onChangeProfessor={setProfessor} isHome={true}/>}/>\n          <Route path='/404' exact component={NotFoundPage}/>\n          <Route path=\"/professors/:endpoint\" exact component={() => <Professor isHome={false} endpoint={professor.endpoint} professorList={professorList} onChangeProfessor={setProfessor} professor={professor} />} />\n          <Redirect to=\"/404\"/>\n        </Switch>\n      </Router>\n  );\n}\n\nexport default App;","import React from 'react';\nimport ReactDOM from 'react-dom';\nimport App from './App';\n\nReactDOM.render(\n    <App />,\n    document.getElementById('root')\n)"]}}