\n            </>\n        )\n    }\n};\n\nexport default Result;","import React, {useState} from 'react';\nimport './SearchBar.css'\nimport Result from \"./Homepage/Header/Result\";\n\nfunction SearchBar(props) {\n    const {professorList, onChangeProfessor, isHome} = props;\n    const [search, setSearch] = useState('');\n    const handleChange = event => {\n        setSearch(event.target.value);\n    };\n\n    const filteredListLower = professorList\n        .filter(listItem => listItem.name.toLowerCase().includes(search.toLowerCase()));\n\n    let professorDetails;\n\n    if (filteredListLower.length > 0) {\n        professorDetails = (\n            <React.Fragment>\n                <div>\n                    {\n                        filteredListLower\n                            .map((x) => {\n                                return <Result key={x.id} professor={x} onChangeProfessor={onChangeProfessor}/>\n                            })\n                    }\n                </div>\n            </React.Fragment>\n        )\n    } else {\n        professorDetails = (\n            <div className={\"result\"}>Non ci sono professori con questo nome</div>)\n    }\n    return (\n            <>\n                <div>\n                    <div className={'search-bar-container'}>\n\n                        <input className={!isHome ? \"search-input\" : \"search-navbar-input\"}\n                               type=\"text\"\n                               value={search}\n                               autoCapitalize = \"none\"\n                               placeholder={\"Cerca un professore...\"}\n                               onChange={handleChange}\n                        />\n                        <div className={'search-bar'}>\n                            {\n                                search ? professorDetails : null\n                            }\n                        </div>\n\n                    </div>\n                </div>\n\n            </>\n        );\n\n\n}\n\nexport default SearchBar;\n\n","import React, {useState, useEffect} from 'react';\nimport './BannerArea.css'\nimport SearchBar from \"../../SearchBar\";\n\n\nconst BannerArea = (props) => {\n    const {professorList, onChangeProfessor, isHome} = props;\n\n\n    return (\n        <>\n            <div className={\"hero-image\"}>\n                <SearchBar professorList={professorList} isHome={isHome} onChangeProfessor={onChangeProfessor}/>\n            </div>\n\n        </>\n    )\n}\n\n\nexport default BannerArea;","export default __webpack_public_path__ + \"static/media/polimi.a670da85.jpg\";","export default __webpack_public_path__ + \"static/media/bocconi.cac2f116.jpg\";","export default __webpack_public_path__ + \"static/media/cattolica.0f74b814.jpg\";","export default __webpack_public_path__ + \"static/media/polito.65f5ad05.jpg\";","export default __webpack_public_path__ + \"static/media/sapienza.d8c7eb28.jpg\";","export default __webpack_public_path__ + \"static/media/statale.f9610de6.jpg\";","import React from 'react'\nimport './UniversityArea.css'\nimport imgPolimi from \"../../../img/polimi.jpg\";\nimport imgBocconi from \"../../../img/bocconi.jpg\";\nimport imgCattolica from \"../../../img/cattolica.jpg\";\nimport imgPolito from \"../../../img/polito.jpg\";\nimport imgSapienza from \"../../../img/sapienza.jpg\";\nimport imgStatale from \"../../../img/statale.jpg\";\n\n\nfunction UniversitySection() {\n\n    return (\n        <>\n            <div className=\"uni-container\">\n                <div className=\"title\">\n                    Le Università\n                </div>\n                Verifica che la tua universitá sia tra quelle disponibili.\n                <div className=\"wrap\">\n                    <div className=\"item-wrap\">\n                        <img src={imgPolimi} className={'image'} alt={imgPolimi}/>\n                        <div className=\"middle\">\n                            <div className=\"text\">Politecnico di  