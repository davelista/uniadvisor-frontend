                "showReuseMessage": true,
                "clear": false,
                "group": "groupA"
            }
        },
        {
            "label": "run dev",
            "type": "shell",
            "command": "npm start",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "group": "groupA"
            }
        }
    ]
