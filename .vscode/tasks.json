    "version": "2.0.0",
    "tasks": [
        {
            "label": "run dev all",
            "dependsOn": ["run flask", "run dev"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run flask",
            "type": "shell",
            "command": "cd ../uniadvisor-api; venv/Scripts/activate; flask run",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
